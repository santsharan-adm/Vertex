<Window x:Class="IPCSoftware.App.Bending.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:IPCSoftware.App.Bending.Views"
        Title="Bending Machine System" WindowState="Maximized">

    <Grid Background="#0F0F0F">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MenuColumn" Width="0"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="SidePanel" Grid.Column="0" Background="#1A1A1A" BorderBrush="#333" BorderThickness="0,0,1,0">
            <StackPanel Margin="10">
                <TextBlock Text="MENU" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,10,0,20" HorizontalAlignment="Center"/>

                <Button Content="Bending Monitor 1" Click="Menu_Click" Tag="B1" Height="45" Margin="0,5" Background="#252525" Foreground="White" BorderThickness="0"/>
                <Button Content="Bending Monitor 2" Click="Menu_Click" Tag="B2" Height="45" Margin="0,5" Background="#252525" Foreground="White" BorderThickness="0"/>
                <Button Content="Bending Monitor 3" Click="Menu_Click" Tag="B3" Height="45" Margin="0,5" Background="#252525" Foreground="White" BorderThickness="0"/>
                <Button Content="User Control 1" Click="Menu_Click" Tag="UC1" Height="45" Margin="0,5" Background="#252525" Foreground="White" BorderThickness="0"/>
                <Button Content="User Control 2" Click="Menu_Click" Tag="UC2" Height="45" Margin="0,5" Background="#252525" Foreground="White" BorderThickness="0"/>


                <Button Content="CLOSE MENU" Click="CloseMenu_Click" Margin="0,50,0,0" Background="#CC0000" Foreground="White" Height="40" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <ContentControl x:Name="MainContentArea" />

            <Button Content="GO TO MENU" HorizontalAlignment="Left" VerticalAlignment="Bottom" 
                    Width="110" Height="35" Margin="15" Click="OpenMenu_Click" 
                    Background="#2196F3" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
        </Grid>
    </Grid>
</Window>