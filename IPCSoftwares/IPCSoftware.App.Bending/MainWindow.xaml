<Window x:Class="IPCSoftware.App.Bending.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:IPCSoftware.App.Bending.Views"
        Title="Bending Machine System"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#0B1A2E">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0D2137" BorderBrush="#2196F3" BorderThickness="1">
            <StackPanel Margin="3">
                <TextBlock Text="NAVIGATION" Foreground="#8CA3C6" FontWeight="Bold" FontSize="12" Margin="3"/>

                <Button x:Name="BtnDashboard1" Content="DASHBOARD 1" Click="BtnDashboard1_Click" 
                        Height="40" Margin="3" Background="#1565C0" Foreground="White" FontWeight="SemiBold" BorderBrush="#2196F3"/>

                <Button x:Name="BtnDashboard2" Content="BDASHBOARD 2" Click="BtnDashboard2_Click" 
                        Height="40" Margin="3" Background="#1565C0" Foreground="White" FontWeight="SemiBold" BorderBrush="#2196F3"/>
            </StackPanel>
        </Border>

        <ContentControl x:Name="MainContentArea" Grid.Column="1" Margin="1"/>

    </Grid>
</Window>