<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Pseudocode / Plan (embedded as comment):
    - Provide a ResourceDictionary containing the brushes and common styles referenced
      by Views/Dashboard2.xaml so the view can resolve StaticResource keys.
    - Define primary SolidColorBrush resources:
        PanelBorder, AccentBlue, TableBg, OkGreen, NgRed
      plus a few supportive brushes used across the dashboard.
    - Provide small reusable styles:
        - IndicatorEllipse (for small status dots)
        - SmallHeaderText (common header text appearance)
    - Keep names and color values consistent with Dashboard2.xaml.
  -->

  <!-- Primary brushes -->
  <SolidColorBrush x:Key="PanelBorder" Color="#1E293B"/>
  <SolidColorBrush x:Key="AccentBlue" Color="#1565C0"/>
  <SolidColorBrush x:Key="TableBg" Color="#F1F5F9"/>
  <SolidColorBrush x:Key="OkGreen" Color="#00B050"/>
  <SolidColorBrush x:Key="NgRed" Color="#EF4444"/>

  <!-- Supporting brushes -->
  <SolidColorBrush x:Key="AccentBlueLight" Color="#3B82F6"/>
  <SolidColorBrush x:Key="SuccessFill" Color="#10B981"/>
  <SolidColorBrush x:Key="PanelDark" Color="#0B1A2E"/>
  <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
  <SolidColorBrush x:Key="HeaderBg" Color="#B4C6E7"/>

  <!-- Common measurements -->
  <Thickness x:Key="DefaultPadding">3</Thickness>

  <!-- Reusable styles -->
  <Style x:Key="IndicatorEllipse" TargetType="Ellipse">
    <Setter Property="Width" Value="9"/>
    <Setter Property="Height" Value="9"/>
    <Setter Property="Margin" Value="3"/>
  </Style>

  <Style x:Key="SmallHeaderText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Optional: default button border radius used in local Button resources -->
  <Style x:Key="RoundedBorder" TargetType="Border">
    <Setter Property="CornerRadius" Value="4"/>
  </Style>

</ResourceDictionary>