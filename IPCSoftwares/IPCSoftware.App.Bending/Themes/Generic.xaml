                            </Border>
                            <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource DataBorderStyle}">
                                <TextBlock Text="2" Style="{StaticResource DataTextStyle}"/>
                            </Border>
                            <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource DataBorderStyle}">
                                <TextBlock Text="3" Style="{StaticResource DataTextStyle}"/>
                            </Border>
                            <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource DataBorderStyle}">
                                <TextBlock Text="4" Style="{StaticResource DataTextStyle}"/>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource DataBorderStyle}">
