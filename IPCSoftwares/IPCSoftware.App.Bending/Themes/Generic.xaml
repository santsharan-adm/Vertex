                                        <Ellipse Grid.Row="1" Grid.Column="1" Width="9" Height="9" Fill="{Binding Bending3.Flex2.Punch, Converter={StaticResource BoolToColor}}" Margin="3"/>
                                        <Ellipse Grid.Row="1" Grid.Column="2" Width="9" Height="9" Fill="{Binding Bending3.Flex3.Punch, Converter={StaticResource BoolToColor}}" Margin="3"/>
                                        <Ellipse Grid.Row="1" Grid.Column="3" Width="9" Height="9" Fill="{Binding Bending3.Flex4.Punch, Converter={StaticResource BoolToColor}}" Margin="3"/>
