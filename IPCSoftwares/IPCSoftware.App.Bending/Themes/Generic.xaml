<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:IPCSoftware.App.Bending.Converters"
    xmlns:local="clr-namespace:IPCSoftware.App.Bending.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/IPCSoftware.App.Bending;component/Resources/BendingRD2.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <conv:BoolToResultTextConverter x:Key="BoolToResultText"/>
    <conv:BoolToResultColorConverter x:Key="BoolToResultColor"/>
    <conv:BoolToColorConverter x:Key="BoolToColor"/>

    <!-- Turn Table 1 -->
    <Style TargetType="{x:Type local:TurnTable1CC}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TurnTable1CC}">
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <!--
                                    One full cycle = 4 steps, each step:
                                      TT1 rotates +90? over 0.8s, holds 0.4s
                                      TT2 rotates +120? over 0.8s, holds 0.4s
                                    Step duration = 2.4s  ?  4 steps = 9.6s total
                                -->

                                    <!-- TT1: 0?90 at t=0..0.8, hold; 90?180 at t=2.4..3.2; 180?270 at t=4.8..5.6; 270?360 at t=7.2..8.0 -->
                                    <DoubleAnimationUsingKeyFrames
                                    Storyboard.TargetName="Part_TT1RotateTransform"
                                    Storyboard.TargetProperty="Angle">
                                        <!-- Step 1: TT1 moves -->
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0"    Value="0"/>
                                        <LinearDoubleKeyFrame   KeyTime="0:0:0.8" Value="90"/>
                                        <!-- hold while TT2 moves (0.4s hold + 0.8s TT2 move + 0.4s TT2 hold = 1.6s) -->
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:2.4"  Value="90"/>
                                        <!-- Step 2: TT1 moves -->
                                        <LinearDoubleKeyFrame   KeyTime="0:0:3.2" Value="180"/>
                                        <!-- hold -->
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:4.8"  Value="180"/>
                                        <!-- Step 3: TT1 moves -->
                                        <LinearDoubleKeyFrame   KeyTime="0:0:5.6" Value="270"/>
                                        <!-- hold -->
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:7.2"  Value="270"/>
                                        <!-- Step 4: TT1 moves -->
                                        <LinearDoubleKeyFrame   KeyTime="0:0:8.0" Value="360"/>
                                        <!-- hold until cycle end -->
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:9.6"  Value="360"/>
                                    </DoubleAnimationUsingKeyFrames>

                                    <!-- TT2: moves after each TT1 step (offset by 1.2s), +120? each time -->
                                    <!--<DoubleAnimationUsingKeyFrames
                                    Storyboard.TargetName="TT2RotateTransform"
                                    Storyboard.TargetProperty="Angle">
                                    -->
                                    <!-- hold while TT1 does step 1 (0?0.8s move + 0.4s hold = 1.2s) -->
                                    <!--
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0"    Value="0"/>
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:1.2"  Value="0"/>
                                    -->
                                    <!-- Step 1: TT2 moves -->
                                    <!--
                                    <LinearDoubleKeyFrame   KeyTime="0:0:2.0" Value="120"/>
                                -->
                                    <!-- hold while TT1 does step 2 -->
                                    <!--
                                <DiscreteDoubleKeyFrame KeyTime="0:0:3.6"  Value="120"/>
                                -->
                                    <!-- Step 2: TT2 moves -->
                                    <!--
                                <LinearDoubleKeyFrame   KeyTime="0:0:4.4" Value="240"/>
                                -->
                                    <!-- hold while TT1 does step 3 -->
                                    <!--
                                <DiscreteDoubleKeyFrame KeyTime="0:0:6.0"  Value="240"/>
                                -->
                                    <!-- Step 3: TT2 moves -->
                                    <!--
                                <LinearDoubleKeyFrame   KeyTime="0:0:6.8" Value="360"/>
                                -->
                                    <!-- hold while TT1 does step 4 -->
                                    <!--
                                <DiscreteDoubleKeyFrame KeyTime="0:0:8.4"  Value="360"/>
                                -->
                                    <!-- Step 4: TT2 moves (wraps back for next cycle) -->
                                    <!--
                                <LinearDoubleKeyFrame   KeyTime="0:0:9.2" Value="480"/>
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:9.6"  Value="480"/>
                                </DoubleAnimationUsingKeyFrames>-->
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                    <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="1" Text="TURN TABLE 1" FontWeight="Bold" FontSize="15" 
                               Foreground="{StaticResource PanelBorder}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                            <Border Width="160" Height="160" CornerRadius="80" Background="White"
                                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="3.5"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid RenderTransformOrigin="0.5,0.5" Margin="2">
                                    <Grid.RenderTransform>
                                        <RotateTransform x:Name="Part_TT1RotateTransform" Angle="0"/>
                                    </Grid.RenderTransform>

                                    <!-- Top row -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0">
                                        <Ellipse x:Name="Part_TT1_TopRow1" Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                        <Ellipse x:Name="Part_TT1_TopRow2" Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                        <Ellipse x:Name="Part_TT1_TopRow3" Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                        <Ellipse x:Name="Part_TT1_TopRow4" Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                    </StackPanel>

                                    <!-- Bottom row -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,129,0,0">
                                        <Ellipse x:Name="Part_TT1_BottomRow1" Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                        <Ellipse x:Name="Part_TT1_BottomRow2" Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                        <Ellipse x:Name="Part_TT1_BottomRow3" Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                        <Ellipse x:Name="Part_TT1_BottomRow4" Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                    </StackPanel>

                                    <!-- Left column -->
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <Ellipse x:Name="Part_TT1_LeftCol1" Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                        <Ellipse x:Name="Part_TT1_LeftCol2" Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                        <Ellipse x:Name="Part_TT1_LeftCol3" Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                        <Ellipse x:Name="Part_TT1_LeftCol4" Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                    </StackPanel>

                                    <!-- Right column -->
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="129,0,0,0">
                                        <Ellipse x:Name="Part_TT1_RightCol1" Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                        <Ellipse x:Name="Part_TT1_RightCol2" Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                        <Ellipse x:Name="Part_TT1_RightCol3" Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                        <Ellipse x:Name="Part_TT1_RightCol4" Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Turn Table 2 -->
    <Style TargetType="{x:Type local:TurnTable2CC}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TurnTable2CC}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="1" Text="TURN TABLE 2" FontWeight="Bold" FontSize="15" Foreground="{StaticResource PanelBorder}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Canvas Grid.Row="0" Width="200" Height="200" Background="Transparent" HorizontalAlignment="Left" Margin="9" VerticalAlignment="Top">
                                <Canvas.RenderTransform>
                                    <!-- Named rotate transform so code-behind can animate it -->
                                    <RotateTransform x:Name="Part_TriangleRotate" Angle="0" CenterX="100" CenterY="77.3" />
                                </Canvas.RenderTransform>

                                <!-- Equilateral Triangle -->
                                <!-- Side length = 100 -->
                                <!-- Height = 100 * √3 / 2 ≈ 86.6 -->
                                <!--<Polygon Points="100,20 50,106.6 150,106.6" Fill="White" Stroke="Black" StrokeThickness="2" />-->
                                <!--<Polygon Points="100,-37.73 0,135.47 200,135.47"
                                     Fill="White"
                                     Stroke="Black"
                                     StrokeThickness="2" />-->
                                <Polygon Points="100,-8.87 25,121.03 175,121.03"
                                     Fill="White"
                                     Stroke="Black"
                                     StrokeThickness="2" />

                                <!-- 4 markers along left side (A=(100,20) -> B=(50,106.6))
                    centered along the side and moved slightly inward toward centroid -->
                                <Ellipse x:Name="Part_ElipsePos1Flex1" Width="8" Height="8" Fill="#3B82F6" Canvas.Left="79.9" Canvas.Top="48.504"/>
                                <Ellipse x:Name="Part_ElipsePos1Flex2" Width="8" Height="8" Fill="#3B82F6" Canvas.Left="75.3" Canvas.Top="56.471"/>
                                <Ellipse x:Name="Part_ElipsePos1Flex3" Width="8" Height="8" Fill="#3B82F6" Canvas.Left="70.7" Canvas.Top="64.438"/>
                                <Ellipse x:Name="Part_ElipsePos1Flex4" Width="8" Height="8" Fill="#3B82F6" Canvas.Left="66.1" Canvas.Top="72.405"/>

                                <!-- 4 markers along right side (A=(100,20) -> C=(150,106.6))
                    centered along the side and moved slightly inward toward centroid -->
                                <Ellipse x:Name="Part_ElipsePos2Flex1" Width="8" Height="8" Fill="#3B82F6" Canvas.Left="112.1" Canvas.Top="48.504"/>
                                <Ellipse x:Name="Part_ElipsePos2Flex2" Width="8" Height="8" Fill="#3B82F6" Canvas.Left="116.7" Canvas.Top="56.471"/>
                                <Ellipse x:Name="Part_ElipsePos2Flex3" Width="8" Height="8" Fill="#3B82F6" Canvas.Left="121.3" Canvas.Top="64.438"/>
                                <Ellipse x:Name="Part_ElipsePos2Flex4" Width="8" Height="8" Fill="#3B82F6" Canvas.Left="125.9" Canvas.Top="72.405"/>

                                <!-- 4 markers along bottom side (B=(50,106.6) -> C=(150,106.6))
                centered along the side and moved slightly inward toward centroid -->
                                <Ellipse x:Name="Part_ElipsePos3Flex1" Width="8" Height="8" Fill="#3B82F6" Canvas.Left="82.2" Canvas.Top="100.2907"/>
                                <Ellipse x:Name="Part_ElipsePos3Flex2"  Width="8" Height="8" Fill="#3B82F6" Canvas.Left="91.4" Canvas.Top="100.2907"/>
                                <Ellipse x:Name="Part_ElipsePos3Flex3" Width="8" Height="8" Fill="#3B82F6" Canvas.Left="100.6" Canvas.Top="100.2907"/>
                                <Ellipse x:Name="Part_ElipsePos3Flex4" Width="8" Height="8" Fill="#3B82F6" Canvas.Left="109.8" Canvas.Top="100.2907"/>
                            </Canvas>

                        </Grid>

                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:InspectionUnitOutputCC}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:InspectionUnitOutputCC}">
                    <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border BorderBrush="Brown" BorderThickness="1">
                                <TextBlock Text="{Binding BatchNo, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}Station 9 - {0}'}" Foreground="#0F172A" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="INSPECTION UNIT OUTPUT" 
                                FontSize="15" 
                                FontWeight="ExtraBold" 
                                Foreground="#0F172A" 
                                HorizontalAlignment="Center"/>  

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="3">
                                <Viewbox Width="25" Height="30" Margin="2,0">
                                    <Path Fill="#475569" Data="M12,20H4A2,2 0 0,1 2,18V8A2,2 0 0,1 4,6H5L7,4H11L13,6H14A2,2 0 0,1 16,8V10.5L20,8V18L16,15.5V18A2,2 0 0,1 14,20H12M4,8V18H14V8H10.83L9,6H9L8.83,6H7.17L5.34,8H4M9,17A4,4 0 0,1 5,13A4,4 0 0,1 9,9A4,4 0 0,1 13,13A4,4 0 0,1 9,17M9,11A2,2 0 0,0 7,13A2,2 0 0,0 9,15A2,2 0 0,0 11,13A2,2 0 0,0 9,11Z"/>
                                </Viewbox>
                                <Viewbox Width="25" Height="30" Margin="2,0">
                                    <Path Fill="#475569" Data="M12,20H4A2,2 0 0,1 2,18V8A2,2 0 0,1 4,6H5L7,4H11L13,6H14A2,2 0 0,1 16,8V10.5L20,8V18L16,15.5V18A2,2 0 0,1 14,20H12M4,8V18H14V8H10.83L9,6H9L8.83,6H7.17L5.34,8H4M9,17A4,4 0 0,1 5,13A4,4 0 0,1 9,9A4,4 0 0,1 13,13A4,4 0 0,1 9,17M9,11A2,2 0 0,0 7,13A2,2 0 0,0 9,15A2,2 0 0,0 11,13A2,2 0 0,0 9,11Z"/>
                                </Viewbox>
                            </StackPanel>
                           
                        </Grid>

                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Controls Panel -->
    <Style TargetType="{x:Type local:ControlsPanelCC}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ControlsPanelCC}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#1565C0" CornerRadius="6,6,0,0" Padding="5">
                                <TextBlock Text="CONTROLS" FontWeight="Bold" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                            </Border>
                            <Button Grid.Row="1" Margin="3" Padding="3,10" Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" FontSize="20">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                                <TextBlock Text="AUTO RUN" TextAlignment="Center"/>
                            </Button>
                            <Button Grid.Row="2" Margin="3" Padding="5,10" Background="#64748B" Foreground="White" FontWeight="Bold" BorderThickness="0" FontSize="20">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                                <TextBlock Text="DRY RUN" TextAlignment="Center"/>
                            </Button>
                            <Button Grid.Row="3" Margin="3" Padding="5,10" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" FontSize="20">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                                <TextBlock Text="CYCLE STOP" TextAlignment="Center"/>
                            </Button>
                            <Button Grid.Row="4" Margin="3" Padding="5,10" Background="#6366F1" Foreground="White" FontWeight="Bold" BorderThickness="0" FontSize="20">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                                <TextBlock Text="WORK PAYOUT STOP" TextAlignment="Center"/>
                            </Button>
                            <Button Grid.Row="5" Margin="3" Padding="3,10" Background="#64748B" Foreground="White" FontWeight="Bold" BorderThickness="0" FontSize="20">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                                <TextBlock Text="Go To Menu" TextAlignment="Center" FontSize="20"/>
                            </Button>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Batch QR Code Panel -->
    <Style TargetType="{x:Type local:BatchQRCodePanelCC}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:BatchQRCodePanelCC}">
                    <ControlTemplate.Resources>
                        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontSize" Value="12"/>
                        </Style>

                        <Style x:Key="QRCodeTextStyle" TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                    </ControlTemplate.Resources>
                    <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <Grid >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border BorderBrush="#1565C0" BorderThickness="1" Background="Black" CornerRadius="8" Margin="3">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    
                                    <Border Grid.Row="0" Grid.Column="0" Background="#1565C0" BorderBrush="Black" Padding="3,2" CornerRadius="5,0,0,0">
                                        <TextBlock Text="Batch No." Style="{DynamicResource HeaderTextStyle}"/>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1" Background="#1565C0" BorderBrush="Black" Padding="3,2">
                                        <TextBlock Text="QR Code" Style="{DynamicResource HeaderTextStyle}"/>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="0" Grid.RowSpan="4" Background="#0B1A2E" BorderBrush="#1565C0" Padding="3">
                                        <TextBlock Text="{Binding BatchNo}" Style="{DynamicResource HeaderTextStyle}"/>
                                    </Border>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LineItem1.QRCode}" Style="{DynamicResource QRCodeTextStyle}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LineItem2.QRCode}" Style="{DynamicResource QRCodeTextStyle}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LineItem3.QRCode}" Style="{DynamicResource QRCodeTextStyle}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LineItem4.QRCode}" Style="{DynamicResource QRCodeTextStyle}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Efficiency Breakdown -->
    <Style TargetType="{x:Type local:EfficiencyBreakdownCC}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:EfficiencyBreakdownCC}">
                    <ControlTemplate.Resources>
                        <Style x:Key="OEEHeaderStyle" TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Padding" Value="3"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                        <Style x:Key="OEETextBlockStyle" TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="3"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                        <Style x:Key="OEETextBlock2Style" TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="3"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </ControlTemplate.Resources>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="3,10">
                        <!--<Border Background="#1E293B" CornerRadius="8" Padding="4,3" VerticalAlignment="Top" Margin="3">-->
                        <Grid Margin="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="EFFICIENCY BREAKDOWN" Style="{StaticResource OEEHeaderStyle}"/>

                            <Grid Grid.Row="1" Height="15" Margin="3,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Availability" Style="{StaticResource OEETextBlockStyle}"/>
                                <Grid Grid.Column="1" Height="7" VerticalAlignment="Center" Margin="3,0">
                                    <Border CornerRadius="3" Background="#334155"/>
                                    <Border CornerRadius="3" Background="#10B981" HorizontalAlignment="Left" Width="96"/>
                                </Grid>
                                <TextBlock Grid.Column="2" Text="96%" Style="{StaticResource OEETextBlock2Style}"/>
                            </Grid>

                            <Grid Grid.Row="2" Height="15" Margin="3,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Performance" Style="{StaticResource OEETextBlockStyle}"/>
                                <Grid Grid.Column="1" Height="7" VerticalAlignment="Center" Margin="3,0">
                                    <Border CornerRadius="3" Background="#334155"/>
                                    <Border CornerRadius="3" Background="#3B82F6" HorizontalAlignment="Left" Width="91"/>
                                </Grid>
                                <TextBlock Grid.Column="2" Text="91%" Style="{StaticResource OEETextBlock2Style}"/>
                            </Grid>

                            <Grid Grid.Row="3" Height="15" Margin="3,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Quality" Style="{StaticResource OEETextBlockStyle}"/>
                                <Grid Grid.Column="1" Height="7" VerticalAlignment="Center" Margin="3,0">
                                    <Border CornerRadius="3" Background="#334155"/>
                                    <Border CornerRadius="3" Background="#F59E0B" HorizontalAlignment="Left" Width="97"/>
                                </Grid>
                                <TextBlock Grid.Column="2" Text="97%" Style="{StaticResource OEETextBlock2Style}"/>
