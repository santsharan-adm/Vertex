    <!-- Inspection Unit Input -->
    <Style TargetType="{x:Type local:InspectionUnitInputCC}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:InspectionUnitInputCC}">
                    <Border Background="#F8FAFC" BorderBrush="#475569" BorderThickness="3" CornerRadius="4">
                        <Grid Margin="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <TextBlock Text="INSPECTION UNIT INPUT" FontSize="15" FontWeight="ExtraBold" 
                                           Foreground="#0F172A" HorizontalAlignment="Center"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="3">
                                    <Border Background="#E2E8F0" CornerRadius="2" Padding="4,1">
                                        <TextBlock Text="QR" FontSize="10" FontWeight="Bold" Foreground="#475569" Height="14"/>
                                    </Border>
                                    <TextBlock Text="+" Foreground="#94A3B8" Margin="4,0" VerticalAlignment="Center" FontSize="8"/>
                                    <Viewbox Width="25" Height="30" Margin="2,0">
                                        <Path Fill="#475569" Data="M12,20H4A2,2 0 0,1 2,18V8A2,2 0 0,1 4,6H5L7,4H11L13,6H14A2,2 0 0,1 16,8V10.5L20,8V18L16,15.5V18A2,2 0 0,1 14,20H12M4,8V18H14V8H10.83L9,6H9L8.83,6H7.17L5.34,8H4M9,17A4,4 0 0,1 5,13A4,4 0 0,1 9,9A4,4 0 0,1 13,13A4,4 0 0,1 9,17M9,11A2,2 0 0,0 7,13A2,2 0 0,0 9,15A2,2 0 0,0 11,13A2,2 0 0,0 9,11Z"/>
                                    </Viewbox>
                                    <Viewbox Width="25" Height="30" Margin="2,0">
                                        <Path Fill="#475569" Data="M12,20H4A2,2 0 0,1 2,18V8A2,2 0 0,1 4,6H5L7,4H11L13,6H14A2,2 0 0,1 16,8V10.5L20,8V18L16,15.5V18A2,2 0 0,1 14,20H12M4,8V18H14V8H10.83L9,6H9L8.83,6H7.17L5.34,8H4M9,17A4,4 0 0,1 5,13A4,4 0 0,1 9,9A4,4 0 0,1 13,13A4,4 0 0,1 9,17M9,11A2,2 0 0,0 7,13A2,2 0 0,0 9,15A2,2 0 0,0 11,13A2,2 0 0,0 9,11Z"/>
                                    </Viewbox>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Input Tray -->
    <Style TargetType="{x:Type local:InputTrayCC}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:InputTrayCC}">
                    <Border Background="#F1F5F9" BorderBrush="#475569" BorderThickness="3" CornerRadius="2">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="INPUT TRAY" FontSize="15" FontWeight="Bold" Foreground="#1E293B"/>
                            </StackPanel>
                            <TextBlock Text="LOAD" FontSize="10" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center"/>
