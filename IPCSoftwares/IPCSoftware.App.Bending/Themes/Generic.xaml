                                        <Ellipse Grid.Row="1" Grid.Column="2" Width="9" Height="9" Fill="{Binding Flipping.Flex3.Flipping, Converter={StaticResource BoolToColor}}" VerticalAlignment="Center" Margin="3"/>
                                        <Ellipse Grid.Row="1" Grid.Column="3" Width="9" Height="9" Fill="{Binding Flipping.Flex4.Flipping, Converter={StaticResource BoolToColor}}" VerticalAlignment="Center" Margin="3"/>
