                                        <TextBlock Grid.Row="0" Text="CLAMP" Foreground="White" FontSize="9" VerticalAlignment="Center" Margin="3" FontWeight="Bold"/>
                                        <TextBlock Grid.Row="1" Text="PUNCH" Foreground="White" FontSize="9" VerticalAlignment="Center" Margin="3" FontWeight="Bold"/>
