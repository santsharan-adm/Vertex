    <!-- Bend Status Indicators -->
    <Style TargetType="{x:Type local:BendStatusIndicatorsCC}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:BendStatusIndicatorsCC}">
                    <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <!--<Border CornerRadius="5" BorderBrush="Black" BorderThickness="1.5">-->
                        <StackPanel Orientation="Horizontal" Margin="0">
                            <!-- Labels column -->
                            <Border CornerRadius="5" Background="{StaticResource TableBg}" BorderBrush="{StaticResource AccentBlue}" BorderThickness="1.5" Margin="3">
                                <StackPanel>
                                    <Border Background="{StaticResource AccentBlue}" Padding="3">
                                        <TextBlock Text="BEND" Foreground="White" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Grid Margin="3">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="15"/>
                                            <RowDefinition Height="15"/>
                                            <RowDefinition Height="15"/>
                                        </Grid.RowDefinitions>
