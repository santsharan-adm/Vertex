    <!-- Slot Display -->
    <Style TargetType="{x:Type local:SlotDisplayCC}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SlotDisplayCC}">
                    <Grid>
                        <!-- Horizontal slots by default -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsVertical, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse, RelativeSource={RelativeSource TemplatedParent}}">
                            <Rectangle Width="12" Height="12" Fill="#F59E0B" RadiusX="1" RadiusY="1"/>
                            <Rectangle Width="12" Height="12" Fill="#F59E0B" RadiusX="1" RadiusY="1" Margin="4,0,0,0"/>
                        </StackPanel>

                        <!-- Vertical slots -->
                        <Border BorderBrush="black" BorderThickness="2" Padding="1" CornerRadius="2" 
                                Visibility="{Binding IsVertical, Converter={StaticResource BoolToVisibilityConverter}, RelativeSource={RelativeSource TemplatedParent}}">
                            <StackPanel Orientation="Vertical">
                                <Rectangle Width="12" Height="12" Fill="#F59E0B" RadiusX="1" RadiusY="1"/>
                                <Rectangle Height="1"/>
                                <Rectangle Width="12" Height="12" Fill="#F59E0B" RadiusX="1" RadiusY="1"/>
                                <Rectangle Height="1"/>
                                <Rectangle Width="12" Height="12" Fill="#F59E0B" RadiusX="1" RadiusY="1"/>
                                <Rectangle Height="1"/>
                                <Rectangle Width="12" Height="12" Fill="#F59E0B" RadiusX="1" RadiusY="1"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

