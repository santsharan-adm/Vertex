    <!-- Turn Table 1 -->
    <Style TargetType="{x:Type local:TurnTable1CC}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TurnTable1CC}">
                    <Grid>
                        <TextBlock Canvas.Left="0" Canvas.Top="0" Text="TURN TABLE 1" FontWeight="Bold" FontSize="15" 
                                   Foreground="{StaticResource PanelBorder}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                        <Border Width="160" Height="160" CornerRadius="80" Background="White"
                                BorderBrush="{StaticResource PanelBorder}" BorderThickness="3.5"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid RenderTransformOrigin="0.5,0.5" Margin="2">
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="Part_TT1RotateTransform" Angle="0"/>
                                </Grid.RenderTransform>

                                <!-- Top row -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0">
                                    <Ellipse x:Name="Part_TT1_TopRow1" Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                    <Ellipse x:Name="Part_TT1_TopRow2" Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                    <Ellipse x:Name="Part_TT1_TopRow3" Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                    <Ellipse x:Name="Part_TT1_TopRow4" Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                </StackPanel>

                                <!-- Bottom row -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,129,0,0">
                                    <Ellipse x:Name="Part_TT1_BottomRow1" Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                    <Ellipse x:Name="Part_TT1_BottomRow2" Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                    <Ellipse x:Name="Part_TT1_BottomRow3" Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                    <Ellipse x:Name="Part_TT1_BottomRow4" Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                </StackPanel>

                                <!-- Left column -->
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0">
                                    <Ellipse x:Name="Part_TT1_LeftCol1" Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                    <Ellipse x:Name="Part_TT1_LeftCol2" Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                    <Ellipse x:Name="Part_TT1_LeftCol3" Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                    <Ellipse x:Name="Part_TT1_LeftCol4" Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                </StackPanel>

                                <!-- Right column -->
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="129,0,0,0">
                                    <Ellipse x:Name="Part_TT1_RightCol1" Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                    <Ellipse x:Name="Part_TT1_RightCol2" Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                    <Ellipse x:Name="Part_TT1_RightCol3" Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                    <Ellipse x:Name="Part_TT1_RightCol4" Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Transfer Module -->
    <Style TargetType="{x:Type local:TransferModuleCC}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TransferModuleCC}">
