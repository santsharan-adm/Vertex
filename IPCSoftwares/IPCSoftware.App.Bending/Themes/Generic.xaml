    <!-- Bending Data Table - Note: This is a complex table that will be data-bound in actual implementation -->
    <Style TargetType="{x:Type local:BendingDataTableCC}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:BendingDataTableCC}">
                    <Border Background="#0B1A2E" CornerRadius="4" Padding="2" BorderBrush="#1565C0" BorderThickness="1">
                        <Border BorderThickness="1" BorderBrush="#1565C0" HorizontalAlignment="Stretch">
                            <Grid Background="White">
                                <Grid.Resources>
                                    <Style TargetType="Border" x:Key="HeaderBorder">
                                        <Setter Property="Background" Value="#B4C6E7"/>
                                        <Setter Property="BorderBrush" Value="White"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    </Style>
                                    <Style TargetType="TextBlock" x:Key="HeaderText">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="11"/>
                                    </Style>
                                    <Style TargetType="TextBlock" x:Key="DataText">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="11"/>
                                    </Style>
                                </Grid.Resources>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="20"/>
                                </Grid.RowDefinitions>

                                <!-- Header rows -->
                                <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Background="#1565C0">
                                    <TextBlock Text="Batch No." Style="{StaticResource HeaderText}" Foreground="White"/>
                                </Border>
                                <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Background="#1565C0">
                                    <TextBlock Text="QR code" Style="{StaticResource HeaderText}" Foreground="White"/>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3" Background="#1565C0">
                                    <TextBlock Text="Heater Temp (50 - 60)" Style="{StaticResource HeaderText}" Foreground="White"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="5" Grid.ColumnSpan="3" Background="#1565C0">
                                    <TextBlock Text="Load (5 - 10)" Style="{StaticResource HeaderText}" Foreground="White"/>
                                </Border>

                                <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="8" Background="#1565C0">
                                    <TextBlock Text="X (&gt;1 - &lt;2)" Style="{StaticResource HeaderText}" Foreground="White"/>
                                </Border>
                                <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="9" Background="#1565C0">
                                    <TextBlock Text="Y &gt;3 - &lt;4" Style="{StaticResource HeaderText}" Foreground="White"/>
                                </Border>
                                <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="10" Background="#1565C0">
                                    <TextBlock Text="Z (&gt;5 - &lt;6)" Style="{StaticResource HeaderText}" Foreground="White"/>
                                </Border>
                                <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="11" Background="#1565C0">
                                    <TextBlock Text="ø (&gt;7 - &lt;8)" Style="{StaticResource HeaderText}" Foreground="White"/>
                                </Border>
                                <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="12" Background="#1565C0">
                                    <TextBlock Text="Result" Style="{StaticResource HeaderText}" Foreground="White"/>
                                </Border>

                                <!-- Bend sub-headers -->
                                <Border Grid.Row="1" Grid.Column="2" Background="#1565C0">
                                    <TextBlock Text="Bend 1" Style="{StaticResource HeaderText}" FontWeight="Normal" FontSize="10" Foreground="White"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="3" Background="#1565C0">
                                    <TextBlock Text="Bend 2" Style="{StaticResource HeaderText}" FontWeight="Normal" FontSize="10" Foreground="White"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="4" Background="#1565C0">
                                    <TextBlock Text="Bend 3" Style="{StaticResource HeaderText}" FontWeight="Normal" FontSize="10" Foreground="White"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="5" Background="#1565C0">
                                    <TextBlock Text="Bend 1" Style="{StaticResource HeaderText}" FontWeight="Normal" FontSize="10" Foreground="White"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="6" Background="#1565C0">
                                    <TextBlock Text="Bend 2" Style="{StaticResource HeaderText}" FontWeight="Normal" FontSize="10" Foreground="White"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="7" Background="#1565C0">
                                    <TextBlock Text="Bend 3" Style="{StaticResource HeaderText}" FontWeight="Normal" FontSize="10" Foreground="White"/>
                                </Border>

                                <!-- Sample data rows - in real implementation, this will be data-bound -->
                                <!-- Batch BFBL02 -->
                                <Border Grid.Row="3" Grid.RowSpan="4" Grid.Column="0" Background="#0B1A2E" BorderThickness="0">
                                    <TextBlock Text="BFBL02" Style="{StaticResource DataText}" Foreground="White"/>
                                </Border>

                                <!-- Note: Additional data rows would be added here in actual implementation -->
                                <!-- This template shows the structure. Data binding will be used for dynamic content -->
                            </Grid>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
