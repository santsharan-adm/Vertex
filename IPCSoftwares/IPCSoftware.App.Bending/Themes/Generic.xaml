    <!-- PID Table Temperature-->
    <Style TargetType="{x:Type local:PidTableTemperatureCC}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PidTableTemperatureCC}">
                    <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <!--<Border CornerRadius="8" Padding="2" BorderBrush="{StaticResource AccentBlue}" 
                            BorderThickness="1" Background="#1565C0">-->
                        <Grid Background="White">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="38"/>
                                <ColumnDefinition Width="Auto" MinWidth="58"/>
                                <ColumnDefinition Width="Auto" MinWidth="58"/>
                                <ColumnDefinition Width="Auto" MinWidth="58"/>
                            </Grid.ColumnDefinitions>
                            
                            <Grid.Resources>

                                <!-- Header Border -->
                                <Style x:Key="HeaderBorderStyle" TargetType="Border">
                                    <Setter Property="Background" Value="#1565C0"/>
                                    <Setter Property="BorderBrush" Value="Black"/>
                                    <Setter Property="Padding" Value="3,2"/>
                                </Style>

                                <!-- Data Border -->
                                <Style x:Key="DataBorderStyle" TargetType="Border">
                                    <Setter Property="Background" Value="#0B1A2E"/>
                                    <Setter Property="BorderBrush" Value="Black"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Padding" Value="3,2"/>
                                </Style>

                                <!-- Header Text -->
                                <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>

                                <!-- Data Text -->
                                <Style x:Key="DataTextStyle" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="16"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>

                            </Grid.Resources>

                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource HeaderBorderStyle}">
                                <TextBlock Text="PID" Style="{StaticResource HeaderTextStyle}"/>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource HeaderBorderStyle}">
                                <TextBlock FontWeight="Bold" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Heater"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TableType, RelativeSource={RelativeSource TemplatedParent}}" Value="Force">
                                                    <Setter Property="Text" Value="Force"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource HeaderBorderStyle}">
                                <TextBlock Text="S.No." Style="{StaticResource HeaderTextStyle}"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource HeaderBorderStyle}">
                                <TextBlock Text="Bend 1" Style="{StaticResource HeaderTextStyle}"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource HeaderBorderStyle}">
                                <TextBlock Text="Bend 2" Style="{StaticResource HeaderTextStyle}"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource HeaderBorderStyle}">
                                <TextBlock Text="Bend 3" Style="{StaticResource HeaderTextStyle}"/>
                            </Border>

                            <!-- Data rows -->
                            <Border Grid.Row="2" Style="{StaticResource DataBorderStyle}">
                                <TextBlock Text="1" Style="{StaticResource DataTextStyle}"/>
                            </Border>
                            <Border Grid.Row="3" Style="{StaticResource DataBorderStyle}">
                                <TextBlock Text="2" Style="{StaticResource DataTextStyle}"/>
                            </Border>
                            <Border Grid.Row="4" Style="{StaticResource DataBorderStyle}">
                                <TextBlock Text="3" Style="{StaticResource DataTextStyle}"/>
                            </Border>
                            <Border Grid.Row="5" Style="{StaticResource DataBorderStyle}">
                                <TextBlock Text="4" Style="{StaticResource DataTextStyle}"/>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource DataBorderStyle}">
                                <TextBlock Text="{Binding Bending1.Flex1.Temperature}" Style="{StaticResource DataTextStyle}"/>
                            </Border>
                            <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource DataBorderStyle}">
                                <TextBlock Text="{Binding Bending1.Flex2.Temperature}" Style="{StaticResource DataTextStyle}"/>
                            </Border>
                            <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource DataBorderStyle}">
                                <TextBlock Text="{Binding Bending1. Flex3.Temperature}" Style="{StaticResource DataTextStyle}"/>
                            </Border>
                            <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource DataBorderStyle}">
