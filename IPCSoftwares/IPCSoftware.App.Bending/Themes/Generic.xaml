                                    </Button>
                                    <Button Margin="3" Padding="5,10" Background="#64748B" Foreground="White" FontWeight="Bold" BorderThickness="0" FontSize="20">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                        <TextBlock Text="DRY RUN" TextAlignment="Center"/>
