                                        <Ellipse Grid.Row="1" Grid.Column="3" Width="9" Height="9" Fill="{Binding Bending2.Flex4.Punch, Converter={StaticResource BoolToColor}}" Margin="3"/>
                                        <Ellipse Grid.Row="2" Grid.Column="0" Width="9" Height="9" Fill="{Binding Bending2.Flex1.Heat, Converter={StaticResource BoolToColor}}" Margin="3"/>
                                        <Ellipse Grid.Row="2" Grid.Column="1" Width="9" Height="9" Fill="{Binding Bending2.Flex2.Heat, Converter={StaticResource BoolToColor}}" Margin="3"/>
                                        <Ellipse Grid.Row="2" Grid.Column="2" Width="9" Height="9" Fill="{Binding Bending2.Flex3.Heat, Converter={StaticResource BoolToColor}}" Margin="3"/>
