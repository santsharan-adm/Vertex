<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:IPCSoftware.App.Bending.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/IPCSoftware.App.Bending;component/Resources/BendingRD1.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <Style TargetType="{x:Type local:TurnTable2CC}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TurnTable2CC}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="TURN TABLE 2" FontWeight="Bold" FontSize="15" Foreground="{StaticResource PanelBorder}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Canvas Grid.Row="1" Width="200" Height="200" Background="White" HorizontalAlignment="Left" Margin="9" VerticalAlignment="Top">
                                <Canvas.RenderTransform>
                                    <!-- Named rotate transform so code-behind can animate it -->
                                    <RotateTransform x:Name="Part_TriangleRotate" Angle="0" CenterX="100" CenterY="77.3" />
                                </Canvas.RenderTransform>

                                <!-- Equilateral Triangle -->
                                <!-- Side length = 100 -->
                                <!-- Height = 100 * √3 / 2 ≈ 86.6 -->
                                <Polygon Points="100,20 50,106.6 150,106.6" Fill="White" Stroke="Black" StrokeThickness="2" />

                                <!-- 4 markers along left side (A=(100,20) -> B=(50,106.6))
                    centered along the side and moved slightly inward toward centroid -->
                                <Ellipse x:Name="Part_ElipsePos1Flex1" Width="8" Height="8" Fill="#3B82F6" Canvas.Left="79.9" Canvas.Top="48.504"/>
                                <Ellipse x:Name="Part_ElipsePos1Flex2" Width="8" Height="8" Fill="#3B82F6" Canvas.Left="75.3" Canvas.Top="56.471"/>
                                <Ellipse x:Name="Part_ElipsePos1Flex3" Width="8" Height="8" Fill="#3B82F6" Canvas.Left="70.7" Canvas.Top="64.438"/>
                                <Ellipse x:Name="Part_ElipsePos1Flex4" Width="8" Height="8" Fill="#3B82F6" Canvas.Left="66.1" Canvas.Top="72.405"/>

                                <!-- 4 markers along right side (A=(100,20) -> C=(150,106.6))
                    centered along the side and moved slightly inward toward centroid -->
                                <Ellipse x:Name="Part_ElipsePos2Flex1" Width="8" Height="8" Fill="#3B82F6" Canvas.Left="112.1" Canvas.Top="48.504"/>
                                <Ellipse x:Name="Part_ElipsePos2Flex2" Width="8" Height="8" Fill="#3B82F6" Canvas.Left="116.7" Canvas.Top="56.471"/>
                                <Ellipse x:Name="Part_ElipsePos2Flex3" Width="8" Height="8" Fill="#3B82F6" Canvas.Left="121.3" Canvas.Top="64.438"/>
                                <Ellipse x:Name="Part_ElipsePos2Flex4" Width="8" Height="8" Fill="#3B82F6" Canvas.Left="125.9" Canvas.Top="72.405"/>

                                <!-- 4 markers along bottom side (B=(50,106.6) -> C=(150,106.6))
                centered along the side and moved slightly inward toward centroid -->
                                <Ellipse x:Name="Part_ElipsePos3Flex1" Width="8" Height="8" Fill="#3B82F6" Canvas.Left="82.2" Canvas.Top="100.2907"/>
                                <Ellipse x:Name="Part_ElipsePos3Flex2"  Width="8" Height="8" Fill="#3B82F6" Canvas.Left="91.4" Canvas.Top="100.2907"/>
                                <Ellipse x:Name="Part_ElipsePos3Flex3" Width="8" Height="8" Fill="#3B82F6" Canvas.Left="100.6" Canvas.Top="100.2907"/>
                                <Ellipse x:Name="Part_ElipsePos3Flex4" Width="8" Height="8" Fill="#3B82F6" Canvas.Left="109.8" Canvas.Top="100.2907"/>
                            </Canvas>

                        </Grid>
                        
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:InspectionUnitOutputCC}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:InspectionUnitOutputCC}">
                    <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>


                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="2">
                                <TextBlock Text="INSPECTION UNIT OUTPUT" 
                                        FontSize="15" 
                                        FontWeight="ExtraBold" 
                                        Foreground="#0F172A" 
                                        HorizontalAlignment="Center"/>  

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="3">
                                    <Viewbox Width="25" Height="30" Margin="2,0">
                                        <Path Fill="#475569" Data="M12,20H4A2,2 0 0,1 2,18V8A2,2 0 0,1 4,6H5L7,4H11L13,6H14A2,2 0 0,1 16,8V10.5L20,8V18L16,15.5V18A2,2 0 0,1 14,20H12M4,8V18H14V8H10.83L9,6H9L8.83,6H7.17L5.34,8H4M9,17A4,4 0 0,1 5,13A4,4 0 0,1 9,9A4,4 0 0,1 13,13A4,4 0 0,1 9,17M9,11A2,2 0 0,0 7,13A2,2 0 0,0 9,15A2,2 0 0,0 11,13A2,2 0 0,0 9,11Z"/>
                                    </Viewbox>
                                    <Viewbox Width="25" Height="30" Margin="2,0">
                                        <Path Fill="#475569" Data="M12,20H4A2,2 0 0,1 2,18V8A2,2 0 0,1 4,6H5L7,4H11L13,6H14A2,2 0 0,1 16,8V10.5L20,8V18L16,15.5V18A2,2 0 0,1 14,20H12M4,8V18H14V8H10.83L9,6H9L8.83,6H7.17L5.34,8H4M9,17A4,4 0 0,1 5,13A4,4 0 0,1 9,9A4,4 0 0,1 13,13A4,4 0 0,1 9,17M9,11A2,2 0 0,0 7,13A2,2 0 0,0 9,15A2,2 0 0,0 11,13A2,2 0 0,0 9,11Z"/>
                                    </Viewbox>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Controls Panel -->
    <Style TargetType="{x:Type local:ControlsPanelCC}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ControlsPanelCC}">
                    <Border CornerRadius="8" HorizontalAlignment="Stretch"
                            BorderBrush="#1565C0" BorderThickness="2" Background="#0B1A2E">
                        <StackPanel>
                            <Border Background="#1565C0" CornerRadius="6,6,0,0" Padding="3">
                                <TextBlock Text="CONTROLS" FontWeight="Bold" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="3">
                                <Button Margin="3" Padding="3,6" Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" FontSize="10">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                    <TextBlock Text="AUTO RUN" TextAlignment="Center"/>
                                </Button>
                                <Button Margin="3" Padding="3,6" Background="#64748B" Foreground="White" FontWeight="Bold" BorderThickness="0" FontSize="10">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                    <TextBlock Text="DRY RUN" TextAlignment="Center"/>
                                </Button>
                                <Button Margin="3" Padding="3,6" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" FontSize="10">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                    <TextBlock Text="CYCLE START/STOP" TextAlignment="Center"/>
                                </Button>
                                <Button Margin="3" Padding="3,6" Background="#6366F1" Foreground="White" FontWeight="Bold" BorderThickness="0" FontSize="10">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                    <TextBlock Text="WORK PAYOUT START" TextAlignment="Center"/>
                                </Button>
                                <Button Margin="3" Padding="3,6" Background="#64748B" Foreground="White" FontWeight="Bold" BorderThickness="0" FontSize="10">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                    <TextBlock Text="Go To Menu" TextAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Batch QR Code Panel -->
