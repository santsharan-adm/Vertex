                                <TextBlock Text="1" Foreground="White" HorizontalAlignment="Center" FontSize="10"/>
                            </Border>
                            <Border Grid.Row="3" Grid.Column="0" BorderBrush="Black" BorderThickness="1" Background="#0B1A2E" Padding="3,2">
                                <TextBlock Text="2" Foreground="White" HorizontalAlignment="Center" FontSize="10"/>
                            </Border>
                            <Border Grid.Row="4" Grid.Column="0" BorderBrush="Black" BorderThickness="1" Background="#0B1A2E" Padding="3,2">
                                <TextBlock Text="3" Foreground="White" HorizontalAlignment="Center" FontSize="10"/>
