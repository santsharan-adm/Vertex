                            </Border>
                            <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource DataBorderStyle}">
                                <TextBlock Text="{Binding Bending2.Flex1.Force}" Style="{StaticResource DataTextStyle}"/>
                            </Border>
                            <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource DataBorderStyle}">
                                <TextBlock Text="{Binding Bending3.Flex1.Force}" Style="{StaticResource DataTextStyle}"/>
                            </Border>
                            <Border Grid.Row="5" Grid.Column="2" Style="{StaticResource DataBorderStyle}">
