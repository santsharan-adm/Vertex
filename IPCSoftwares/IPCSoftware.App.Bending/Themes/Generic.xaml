                              Stroke="#7F1D1D" StrokeThickness="0.8" Canvas.Left="0" Canvas.Top="0"/>
                        <!-- Right claw finger -->
                        <Path Data="M 13,13 L 16,22 L 9,17 Z" Fill="#EF4444"
                              Stroke="#7F1D1D" StrokeThickness="0.8" Canvas.Left="0" Canvas.Top="0"/>
