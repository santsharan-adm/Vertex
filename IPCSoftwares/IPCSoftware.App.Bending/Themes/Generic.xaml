            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RobotBaseCC}">
                    <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="3" CornerRadius="8" Background="White">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="15" FontWeight="Bold" Foreground="#1E293B" 
                                       HorizontalAlignment="Center" Margin="2" Height="28">
                                <Run Text="ROBOT "/>
                                <Run Text="{TemplateBinding Property=RobotNumber}"/>
