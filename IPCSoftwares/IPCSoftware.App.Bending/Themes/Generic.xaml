    <Style TargetType="{x:Type local:BendingDataTableCC}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:BendingDataTableCC}">
                    <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">

                        <Grid Margin="0" Grid.IsSharedSizeScope="True">
                            <Grid.Resources>

                                <Style x:Key="DataBorder" TargetType="Border" >
                                    <Setter Property="Background" Value="#0B1A2E"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>

                                <Style x:Key="HeaderBorder" TargetType="Border" >
                                    <Setter Property="Background" Value="#1565C0"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush" Value="PaleTurquoise"/>
                                </Style>

                                <Style x:Key="HeaderText" TargetType="TextBlock" >
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="16"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Style>
                                <Style x:Key="HeaderText2" TargetType="TextBlock" >
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Style>

                                <Style x:Key="DataText" TargetType="TextBlock" >
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontSize" Value="18"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Style>

                                <!--Remove default selection visuals to keep rows looking like original DataBorder-->
                                <Style x:Key="ListViewItemNoChrome" TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border Background="Transparent"
                                                    SnapsToDevicePixels="True" >
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>

                               

                            </Grid.Resources>

                            <!--Use a shared-size scope so header columns and item columns align-->
                            <!--<Grid >-->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!--<Grid>-->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition SharedSizeGroup="c0" Width="*"/>
                                <ColumnDefinition SharedSizeGroup="c1" Width="*"/>
                                <ColumnDefinition SharedSizeGroup="c2" Width="*"/>
                                <ColumnDefinition SharedSizeGroup="c3" Width="*"/>
                                <ColumnDefinition SharedSizeGroup="c4" Width="*"/>
                                <ColumnDefinition SharedSizeGroup="c5" Width="*"/>
                                <ColumnDefinition SharedSizeGroup="c6" Width="*"/>
                                <ColumnDefinition SharedSizeGroup="c7" Width="*"/>
                                <ColumnDefinition SharedSizeGroup="c8" Width="*"/>
                                <ColumnDefinition SharedSizeGroup="c9" Width="*"/>
                                <ColumnDefinition SharedSizeGroup="c10" Width="*"/>
                                <ColumnDefinition SharedSizeGroup="c11" Width="*"/>
                                <ColumnDefinition SharedSizeGroup="c12" Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!--<Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>-->

                            <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"   Style="{StaticResource HeaderBorder}">
                                <TextBlock Text="Batch No." Style="{StaticResource HeaderText}"  />
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"     Style="{StaticResource HeaderBorder}">
                                <TextBlock Text="QR code" Style="{StaticResource HeaderText}" />
                            </Border>

                            <Border Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" Style="{StaticResource HeaderBorder}" >
                                <TextBlock Text="Heater Temp (50 - 60)" Style="{StaticResource HeaderText}"  />
                            </Border>

                            <Border Grid.Row="0" Grid.Column="5" Grid.ColumnSpan="3" Style="{StaticResource HeaderBorder}">
                                <TextBlock Text="Load (5 - 10)" Style="{StaticResource HeaderText}" />
                            </Border>

                            <Border Grid.Row="0" Grid.Column="8" Grid.RowSpan="2"  Style="{StaticResource HeaderBorder}">
                                <TextBlock Text="X (&gt;1 - &lt;2)" Style="{StaticResource HeaderText}" />
                            </Border>
                            <Border Grid.Row="0" Grid.Column="9" Grid.RowSpan="2"  Style="{StaticResource HeaderBorder}">
                                <TextBlock Text="Y &gt;3 - &lt;4" Style="{StaticResource HeaderText}" />
                            </Border>
                            <Border Grid.Row="0" Grid.Column="10" Grid.RowSpan="2"  Style="{StaticResource HeaderBorder}">
                                <TextBlock Text="Z (&gt;5 - &lt;6)" Style="{StaticResource HeaderText}" />
                            </Border>
                            <Border Grid.Row="0" Grid.Column="11" Grid.RowSpan="2"  Style="{StaticResource HeaderBorder}">
                                <TextBlock Text="? (&gt;7 - &lt;8)" Style="{StaticResource HeaderText}" />
                            </Border>

                            <Border Grid.Row="0"  Grid.Column="12" Grid.RowSpan="2"  Style="{StaticResource HeaderBorder}">
                                <TextBlock Text="Result" Style="{StaticResource HeaderText}" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource HeaderBorder}">
                                <TextBlock Text="Bend 1" Style="{StaticResource HeaderText2}" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource HeaderBorder}">
                                <TextBlock Text="Bend 2" Style="{StaticResource HeaderText2}" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource HeaderBorder}">
                                <TextBlock Text="Bend 3" Style="{StaticResource HeaderText2}" />
                            </Border>

                            <Border Grid.Row="1" Grid.Column="5" Style="{StaticResource HeaderBorder}">
                                <TextBlock Text="Bend 1" Style="{StaticResource HeaderText2}" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="6" Style="{StaticResource HeaderBorder}">
                                <TextBlock Text="Bend 2" Style="{StaticResource HeaderText2}" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="7" Style="{StaticResource HeaderBorder}">
                                <TextBlock Text="Bend 3" Style="{StaticResource HeaderText2}" />
                            </Border>
                            <!--</Grid>-->

                            <!--<ScrollViewer Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="13" Width="{TemplateBinding ActualWidth}">-->
                            <ListView x:Name="Part_BendingListView" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="13" Width="{TemplateBinding ActualWidth}"
                                      Height="250"
                                  ItemsSource="{Binding }"
                                  ItemContainerStyle="{StaticResource ListViewItemNoChrome}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     
                                  Margin="0">

                                <!--HeaderTemplate: reproduces the header grid with shared-size groups-->


                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource DataBorder}" Padding="2,4" HorizontalAlignment="Stretch" BorderThickness="1" >
                                            <Grid >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition SharedSizeGroup="c0" Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!--Bind each column to expected properties on the item-->
                                                <TextBlock Grid.Column="0" Text="{Binding BatchNo}" Style="{StaticResource DataText}" />

                                                <!--Nested rows-->
                                                <ItemsControl ItemsSource="{Binding LineItems}" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" >
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>

                                                            <Grid Margin="2" >
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" SharedSizeGroup="c1"/>
                                                                    <ColumnDefinition Width="*" SharedSizeGroup="c2"/>
                                                                    <ColumnDefinition Width="*" SharedSizeGroup="c3"/>
                                                                    <ColumnDefinition Width="*" SharedSizeGroup="c4"/>
                                                                    <ColumnDefinition Width="*" SharedSizeGroup="c5"/>
                                                                    <ColumnDefinition Width="*" SharedSizeGroup="c6"/>
                                                                    <ColumnDefinition Width="*" SharedSizeGroup="c7"/>
                                                                    <ColumnDefinition Width="*" SharedSizeGroup="c8"/>
                                                                    <ColumnDefinition Width="*" SharedSizeGroup="c9"/>
                                                                    <ColumnDefinition Width="*" SharedSizeGroup="c10"/>
                                                                    <ColumnDefinition Width="*" SharedSizeGroup="c11"/>
                                                                    <ColumnDefinition Width="*" SharedSizeGroup="c12"/>
                                                                </Grid.ColumnDefinitions>


                                                                <TextBlock Grid.Column="0" Text="{Binding QRCode}" Style="{StaticResource DataText}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding HeaterTemp_Bend1}" Style="{StaticResource DataText}" />
                                                                <TextBlock Grid.Column="2" Text="{Binding HeaterTemp_Bend2}" Style="{StaticResource DataText}" />
                                                                <TextBlock Grid.Column="3" Text="{Binding HeaterTemp_Bend3}" Style="{StaticResource DataText}" />
                                                                <TextBlock Grid.Column="4" Text="{Binding Load_Bend1}" Style="{StaticResource DataText}" />
                                                                <TextBlock Grid.Column="5" Text="{Binding Load_Bend2}" Style="{StaticResource DataText}" />
                                                                <TextBlock Grid.Column="6" Text="{Binding Load_Bend3}" Style="{StaticResource DataText}" />
                                                                <TextBlock Grid.Column="7" Text="{Binding XValue}" Style="{StaticResource DataText}" />
                                                                <TextBlock Grid.Column="8" Text="{Binding YValue}" Style="{StaticResource DataText}" />
                                                                <TextBlock Grid.Column="9" Text="{Binding ZValue}" Style="{StaticResource DataText}" />
                                                                <TextBlock Grid.Column="10" Text="{Binding WValue}" Style="{StaticResource DataText}" />
                                                                <TextBlock Grid.Column="11" 
                                                                       Text="{Binding Result1, Converter={StaticResource BoolToResultText}}"
                                                                       Foreground="{Binding Result1, Converter={StaticResource BoolToResultColor}}"
                                                                       Style="{StaticResource DataText}" FontWeight="Bold"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <!--</ScrollViewer>-->
                            <!--</Grid>-->
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

   

</ResourceDictionary>