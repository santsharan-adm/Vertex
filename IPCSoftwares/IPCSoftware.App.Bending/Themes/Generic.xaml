<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:IPCSoftware.App.Bending.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/IPCSoftware.App.Bending;component/Resources/BendingRD1.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <Style TargetType="{x:Type local:TurnTable2CC}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TurnTable2CC}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="TURN TABLE 2" FontWeight="Bold" FontSize="15" Foreground="{StaticResource PanelBorder}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Canvas Grid.Row="1" Width="200" Height="200" Background="White" HorizontalAlignment="Left" Margin="9" VerticalAlignment="Top">
                                <Canvas.RenderTransform>
                                    <!-- Named rotate transform so code-behind can animate it -->
                                    <RotateTransform x:Name="Part_TriangleRotate" Angle="0" CenterX="100" CenterY="77.3" />
                                </Canvas.RenderTransform>

                                <!-- Equilateral Triangle -->
                                <!-- Side length = 100 -->
                                <!-- Height = 100 * √3 / 2 ≈ 86.6 -->
                                <Polygon Points="100,20 50,106.6 150,106.6" Fill="White" Stroke="Black" StrokeThickness="2" />

                                <!-- 4 markers along left side (A=(100,20) -> B=(50,106.6))
                    centered along the side and moved slightly inward toward centroid -->
                                <Ellipse x:Name="Part_ElipsePos1Flex1" Width="8" Height="8" Fill="#3B82F6" Canvas.Left="79.9" Canvas.Top="48.504"/>
                                <Ellipse x:Name="Part_ElipsePos1Flex2" Width="8" Height="8" Fill="#3B82F6" Canvas.Left="75.3" Canvas.Top="56.471"/>
                                <Ellipse x:Name="Part_ElipsePos1Flex3" Width="8" Height="8" Fill="#3B82F6" Canvas.Left="70.7" Canvas.Top="64.438"/>
                                <Ellipse x:Name="Part_ElipsePos1Flex4" Width="8" Height="8" Fill="#3B82F6" Canvas.Left="66.1" Canvas.Top="72.405"/>

                                <!-- 4 markers along right side (A=(100,20) -> C=(150,106.6))
                    centered along the side and moved slightly inward toward centroid -->
                                <Ellipse x:Name="Part_ElipsePos2Flex1" Width="8" Height="8" Fill="#3B82F6" Canvas.Left="112.1" Canvas.Top="48.504"/>
                                <Ellipse x:Name="Part_ElipsePos2Flex2" Width="8" Height="8" Fill="#3B82F6" Canvas.Left="116.7" Canvas.Top="56.471"/>
                                <Ellipse x:Name="Part_ElipsePos2Flex3" Width="8" Height="8" Fill="#3B82F6" Canvas.Left="121.3" Canvas.Top="64.438"/>
                                <Ellipse x:Name="Part_ElipsePos2Flex4" Width="8" Height="8" Fill="#3B82F6" Canvas.Left="125.9" Canvas.Top="72.405"/>

                                <!-- 4 markers along bottom side (B=(50,106.6) -> C=(150,106.6))
                centered along the side and moved slightly inward toward centroid -->
                                <Ellipse x:Name="Part_ElipsePos3Flex1" Width="8" Height="8" Fill="#3B82F6" Canvas.Left="82.2" Canvas.Top="100.2907"/>
                                <Ellipse x:Name="Part_ElipsePos3Flex2"  Width="8" Height="8" Fill="#3B82F6" Canvas.Left="91.4" Canvas.Top="100.2907"/>
                                <Ellipse x:Name="Part_ElipsePos3Flex3" Width="8" Height="8" Fill="#3B82F6" Canvas.Left="100.6" Canvas.Top="100.2907"/>
                                <Ellipse x:Name="Part_ElipsePos3Flex4" Width="8" Height="8" Fill="#3B82F6" Canvas.Left="109.8" Canvas.Top="100.2907"/>
                            </Canvas>

                        </Grid>
                        
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
