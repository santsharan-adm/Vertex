                                        <Ellipse Grid.Row="2" Grid.Column="1" Width="9" Height="9" Fill="{StaticResource OkGreen}" Margin="3"/>
                                        <Ellipse Grid.Row="2" Grid.Column="2" Width="9" Height="9" Fill="{StaticResource OkGreen}" Margin="3"/>
                                        <Ellipse Grid.Row="2" Grid.Column="3" Width="9" Height="9" Fill="{StaticResource OkGreen}" Margin="3"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Bend 2 -->
                            <Border CornerRadius="5" Background="{StaticResource TableBg}" BorderBrush="{StaticResource AccentBlue}" BorderThickness="1.5" Margin="3">
                                <StackPanel>
                                    <Border Background="{StaticResource AccentBlue}" Padding="6,3">
                                        <TextBlock Text="BEND 2" Foreground="White" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Grid Margin="1">
