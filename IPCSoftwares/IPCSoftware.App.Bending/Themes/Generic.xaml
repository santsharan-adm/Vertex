                            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource HeaderBorderStyle}">
                                <TextBlock Text="Bend 2" Style="{StaticResource HeaderTextStyle}"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource HeaderBorderStyle}">
                                <TextBlock Text="Bend 3" Style="{StaticResource HeaderTextStyle}"/>
