<Window x:Class="IPCSoftware.App.Bending.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Bending Machine HMI" Height="994" Width="1600"
        WindowState="Maximized" Background="#0F172A" Foreground="White"
        FontFamily="Segoe UI">

    <DockPanel LastChildFill="True">
        <!-- HEADER -->
        <Border DockPanel.Dock="Top" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="0,0,0,2" Padding="16,10">
<DockPanel>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
       <TextBlock Text="⚙️ FLEX BENDING MACHINE" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <Border Background="#10B981" Padding="6,4,12,4" CornerRadius="3">
            <TextBlock Text="● RUNNING" FontSize="12" FontWeight="Bold"/>
         </Border>
      </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
          <TextBlock FontSize="14" Margin="0,0,20,0">
        <Run Text="Cycle: "/>
       <Run Text="{Binding CycleNumber}" FontWeight="Bold" Foreground="#10B981"/>
   </TextBlock>
        <TextBlock FontSize="14">
         <Run Text="Time: "/>
         <Run Text="{Binding CycleTime}" FontWeight="Bold" Foreground="#10B981"/>
    <Run Text="s"/>
 </TextBlock>
    </StackPanel>
     </DockPanel>
        </Border>

   <!-- TOP SECTION: COMPACT PARAMETER TILES -->
        <Border DockPanel.Dock="Top" Background="#0F172A" Padding="8" Height="120">
  <Grid>
          <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="8"/>
         <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="8"/>
  <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

<!-- BENDING 1 -->
         <Border Grid.Column="0" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="2" CornerRadius="6" Padding="10">
       <StackPanel>
     <Border BorderBrush="#10B981" BorderThickness="0,0,0,1" Padding="0,0,0,6" Margin="0,0,0,6">
   <TextBlock Text="🔴 BENDING 1" FontSize="12" FontWeight="Bold" Foreground="#10B981"/>
  </Border>
      <TextBlock Text="{Binding Bending1Parameters.LotId}" FontSize="13" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,4"/>
      <TextBlock Text="{Binding Bending1Parameters.Temp1, StringFormat='T1: {0}°C'}" FontSize="10" Foreground="White"/>
      <TextBlock Text="{Binding Bending1Parameters.Pressure1, StringFormat='P1: {0}N'}" FontSize="10" Foreground="White"/>
          </StackPanel>
          </Border>

  <!-- BENDING 2 -->
   <Border Grid.Column="2" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="2" CornerRadius="6" Padding="10">
       <StackPanel>
   <Border BorderBrush="#10B981" BorderThickness="0,0,0,1" Padding="0,0,0,6" Margin="0,0,0,6">
  <TextBlock Text="🟡 BENDING 2" FontSize="12" FontWeight="Bold" Foreground="#10B981"/>
  </Border>
      <TextBlock Text="{Binding Bending2Parameters.LotId}" FontSize="13" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,4"/>
      <TextBlock Text="{Binding Bending2Parameters.Temp1, StringFormat='T1: {0}°C'}" FontSize="10" Foreground="White"/>
<TextBlock Text="{Binding Bending2Parameters.Pressure1, StringFormat='P1: {0}N'}" FontSize="10" Foreground="White"/>
    </StackPanel>
    </Border>

           <!-- BENDING 3 -->
     <Border Grid.Column="4" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="2" CornerRadius="6" Padding="10">
       <StackPanel>
         <Border BorderBrush="#10B981" BorderThickness="0,0,0,1" Padding="0,0,0,6" Margin="0,0,0,6">
<TextBlock Text="⚪ BENDING 3" FontSize="12" FontWeight="Bold" Foreground="#10B981"/>
       </Border>
      <TextBlock Text="{Binding Bending3Parameters.LotId}" FontSize="13" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,4"/>
      <TextBlock Text="{Binding Bending3Parameters.Temp1, StringFormat='T1: {0}°C'}" FontSize="10" Foreground="White"/>
      <TextBlock Text="{Binding Bending3Parameters.Pressure1, StringFormat='P1: {0}N'}" FontSize="10" Foreground="White"/>
       </StackPanel>
    </Border>
 </Grid>
      </Border>

        <!-- MIDDLE SECTION: MAIN TURNTABLE LAYOUT (CENTERED & LARGE) -->
      <Border DockPanel.Dock="Top" Background="#0F172A" BorderBrush="#CBD5E1" BorderThickness="2" CornerRadius="6" Padding="30" Margin="8">
     <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
      <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="80"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="80"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="80"/>
      <ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>

      <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
      <RowDefinition Height="20"/>
      <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

   <!-- Input Robot -->
   <StackPanel Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Width="100">
   <Border Background="#0F172A" BorderBrush="#3B82F6" BorderThickness="2" CornerRadius="6" Width="80" Height="80" HorizontalAlignment="Center" Margin="0,0,0,12">
   <TextBlock Text="🤖" FontSize="48" VerticalAlignment="Center" HorizontalAlignment="Center"/>
       </Border>
   <TextBlock Text="Input Robot" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" TextAlignment="Center" Margin="0,0,0,6"/>
   <TextBlock Text="{Binding InputRobotLot}" FontSize="10" Foreground="#10B981" TextAlignment="Center" FontWeight="Bold"/>
</StackPanel>

  <!-- NG OUT LEFT -->
      <StackPanel Grid.Column="0" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
         <TextBlock Text="◀ NG OUT" FontSize="13" FontWeight="Bold" Foreground="#EF4444" TextAlignment="Center"/>
    </StackPanel>

      <!-- TT-1 (Turntable 1) -->
         <StackPanel Grid.Column="2" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
    <TextBlock Text="🔴 Bending 1 " FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
          <TextBlock Text="| 🟡 Bending 2" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
  </StackPanel>
       <TextBlock Text="TT-1" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" TextAlignment="Center" Margin="0,0,0,12"/>
     <Canvas Width="180" Height="180" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center">
<Ellipse Canvas.Left="0" Canvas.Top="0" Width="180" Height="180" Stroke="#3B82F6" StrokeThickness="4" Fill="Transparent"/>
         <Ellipse Canvas.Left="78" Canvas.Top="0" Width="20" Height="20" Stroke="#0F172A" StrokeThickness="2" Fill="{Binding TT1_Pos0_Active, Converter={StaticResource BoolToColorConverter}}"/>
           <Ellipse Canvas.Left="156" Canvas.Top="78" Width="20" Height="20" Stroke="#0F172A" StrokeThickness="2" Fill="{Binding TT1_Pos1_Active, Converter={StaticResource BoolToColorConverter}}"/>
  <Ellipse Canvas.Left="78" Canvas.Top="160" Width="20" Height="20" Stroke="#0F172A" StrokeThickness="2" Fill="{Binding TT1_Pos2_Active, Converter={StaticResource BoolToColorConverter}}"/>
           <Ellipse Canvas.Left="2" Canvas.Top="78" Width="20" Height="20" Stroke="#0F172A" StrokeThickness="2" Fill="{Binding TT1_Pos3_Active, Converter={StaticResource BoolToColorConverter}}"/>
  </Canvas>
    <TextBlock TextAlignment="Center" FontSize="11" Margin="0,12,0,0" FontWeight="Bold"><Run Text="Pos: "/><Run Text="{Binding TT1_CurrentPosition}" Foreground="#10B981"/></TextBlock>
    <TextBlock Text="{Binding TT1_CurrentLot}" FontSize="12" FontWeight="Bold" Foreground="#10B981" TextAlignment="Center" Margin="0,4,0,0"/>
      </StackPanel>

       <!-- Transfer Arrow -->
      <StackPanel Grid.Column="4" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
    <TextBlock Text="⇨" FontSize="64" Foreground="#3B82F6" TextAlignment="Center" FontWeight="Bold" Margin="0,0,0,12">
          <TextBlock.Triggers>
  <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
           <Storyboard RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:1"/>
           <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:1" BeginTime="0:0:1"/>
   </Storyboard>
       </BeginStoryboard>
              </EventTrigger>
          </TextBlock.Triggers>
         </TextBlock>
     <TextBlock Text="Transfer" FontSize="11" Foreground="#94A3B8" TextAlignment="Center" FontWeight="Bold"/>
 </StackPanel>

  <!-- TT-2 (Turntable 2) -->
    <StackPanel Grid.Column="6" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="⚪ Bending 3" FontSize="11" FontWeight="Bold" Foreground="#10B981" TextAlignment="Center" Margin="0,0,0,12"/>
       <TextBlock Text="TT-2" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" TextAlignment="Center" Margin="0,0,0,12"/>
 <Canvas Width="180" Height="180" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center">
       <Ellipse Canvas.Left="0" Canvas.Top="0" Width="180" Height="180" Stroke="#3B82F6" StrokeThickness="4" Fill="Transparent"/>
      <Ellipse Canvas.Left="78" Canvas.Top="0" Width="20" Height="20" Stroke="#0F172A" StrokeThickness="2" Fill="{Binding TT2_Pos0_Active, Converter={StaticResource BoolToColorConverter}}"/>
    <Ellipse Canvas.Left="78" Canvas.Top="160" Width="20" Height="20" Stroke="#0F172A" StrokeThickness="2" Fill="{Binding TT2_Pos1_Active, Converter={StaticResource BoolToColorConverter}}"/>
<Ellipse Canvas.Left="156" Canvas.Top="78" Width="20" Height="20" Stroke="#0F172A" StrokeThickness="2" Fill="{Binding TT2_Pos2_Active, Converter={StaticResource BoolToColorConverter}}"/>
          </Canvas>
        <TextBlock TextAlignment="Center" FontSize="11" Margin="0,12,0,0" FontWeight="Bold"><Run Text="Pos: "/><Run Text="{Binding TT2_CurrentPosition}" Foreground="#10B981"/></TextBlock>
         <TextBlock Text="{Binding TT2_CurrentLot}" FontSize="12" FontWeight="Bold" Foreground="#10B981" TextAlignment="Center" Margin="0,4,0,0"/>
     </StackPanel>

         <!-- Output Robot -->
  <StackPanel Grid.Column="6" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Right" Width="100" Margin="80,0,0,0">
 <Border Background="#0F172A" BorderBrush="#3B82F6" BorderThickness="2" CornerRadius="6" Width="80" Height="80" HorizontalAlignment="Center" Margin="0,0,0,12">
        <TextBlock Text="🤖" FontSize="48" VerticalAlignment="Center" HorizontalAlignment="Center"/>
      </Border>
  <TextBlock Text="Output Robot" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" TextAlignment="Center" Margin="0,0,0,6"/>
    <TextBlock Text="{Binding OutputRobotLot}" FontSize="10" Foreground="#10B981" TextAlignment="Center" FontWeight="Bold"/>
   </StackPanel>

          <!-- NG OUT RIGHT -->
        <StackPanel Grid.Column="6" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="80,0,0,0">
              <TextBlock Text="NG OUT ▶" FontSize="13" FontWeight="Bold" Foreground="#EF4444" TextAlignment="Center"/>
  </StackPanel>
      </Grid>
        </Border>

        <!-- BOTTOM SECTION: MINIMIZED TABLES -->
    <Grid DockPanel.Dock="Bottom">
        <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
   <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>

  <!-- Scanned Parts Table -->
 <Border Grid.Column="0" Background="#1E293B" BorderBrush="#CBD5E1" BorderThickness="2" CornerRadius="6" Padding="12" Margin="8,8,8,8">
       <StackPanel>
 <Border BorderBrush="#3B82F6" BorderThickness="0,0,0,2" Padding="0,0,0,8" Margin="0,0,0,10">
   <TextBlock Text="📱 SCANNED PARTS" FontSize="12" FontWeight="Bold" Foreground="#94A3B8"/>
   </Border>
     <ListBox Background="Transparent" ItemsSource="{Binding ScannedPartsList}" BorderThickness="0" MaxHeight="80">
         <ListBox.ItemContainerStyle>
     <Style TargetType="ListBoxItem">
    <Setter Property="Background" Value="#0F172A"/>
           <Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderBrush" Value="#3B82F6"/>
 <Setter Property="BorderThickness" Value="2,0,0,0"/>
      <Setter Property="Padding" Value="8"/>
   <Setter Property="Margin" Value="0,0,0,4"/>
   <Setter Property="Height" Value="Auto"/>
     </Style>
     </ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate>
     <DataTemplate>
        <TextBlock Text="{Binding}" FontSize="11" FontWeight="Bold"/>
        </DataTemplate>
     </ListBox.ItemTemplate>
   </ListBox>
          </StackPanel>
</Border>

            <!-- Process Events Table -->
    <Border Grid.Column="2" Background="#1E293B" BorderBrush="#CBD5E1" BorderThickness="2" CornerRadius="6" Padding="12" Margin="8,8,8,8">
  <StackPanel>
       <Border BorderBrush="#3B82F6" BorderThickness="0,0,0,2" Padding="0,0,0,8" Margin="0,0,0,10">
  <TextBlock Text="📋 PROCESS EVENTS" FontSize="12" FontWeight="Bold" Foreground="#94A3B8"/>
    </Border>
  <ListBox Background="Transparent" ItemsSource="{Binding ProcessEventsList}" BorderThickness="0" MaxHeight="80">
   <ListBox.ItemContainerStyle>
    <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="#0F172A"/>
       <Setter Property="Foreground" Value="White"/>
  <Setter Property="BorderBrush" Value="#3B82F6"/>
 <Setter Property="BorderThickness" Value="2,0,0,0"/>
    <Setter Property="Padding" Value="8"/>
       <Setter Property="Margin" Value="0,0,0,4"/>
         <Setter Property="Height" Value="Auto"/>
  </Style>
   </ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate>
    <DataTemplate>
    <TextBlock Text="{Binding}" FontSize="10" TextWrapping="Wrap" Foreground="#94A3B8"/>
     </DataTemplate>
      </ListBox.ItemTemplate>
      </ListBox>
     </StackPanel>
      </Border>
    </Grid>
    </DockPanel>
</Window>
