<UserControl x:Class="IPCSoftware.App.Bending.Views.Dashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1672" Background="#F1F5F9">

    <UserControl.Resources>
        <!-- Colors and Brushes -->
        <SolidColorBrush x:Key="PanelBorder" Color="#1E293B"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6"/>
        <SolidColorBrush x:Key="OkGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="NgRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="TableBg" Color="#0F172A"/>
        <SolidColorBrush x:Key="RowEvenBg" Color="#1E293B"/>
        <SolidColorBrush x:Key="GridBrush" Color="#2b3258"/>
        <SolidColorBrush x:Key="InkBrush" Color="#e8eaf6"/>
        <SolidColorBrush x:Key="DarkBg" Color="#111827"/>
        <SolidColorBrush x:Key="MediumBg" Color="#1a1a1a"/>
        <SolidColorBrush x:Key="LightGray" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderGray" Color="#CBD5E1"/>

        <!-- Inspection Unit Item Template -->
        <DataTemplate x:Key="InspectionRowTemplate">
      <Grid Background="#1a1a1a" Height="28">
  <Grid.ColumnDefinitions>
 <ColumnDefinition Width="80"/>
    <ColumnDefinition Width="*"/>
   <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
  <ColumnDefinition Width="*"/>
             <ColumnDefinition Width="65"/>
          </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding PartNumber}" Foreground="White" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0"/>
    <TextBlock Grid.Column="1" Text="{Binding Measurement1, StringFormat=N1}" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
 <TextBlock Grid.Column="2" Text="{Binding Measurement2, StringFormat=N1}" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="3" Text="{Binding Measurement3, StringFormat=N1}" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="4" Text="{Binding Measurement4, StringFormat=N1}" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="5" Text="{Binding Result}" Foreground="{Binding IsOk, Converter={StaticResource BoolToColorConverter}}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <!-- Bending Parameters Template -->
        <DataTemplate x:Key="BendingParameterRowTemplate">
      <Grid Background="#1a1a1a" Height="28">
       <Grid.ColumnDefinitions>
      <ColumnDefinition Width="80"/>
    <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
   <ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>
     <TextBlock Text="{Binding PartNumber}" Foreground="White" Padding="5" FontWeight="Bold" FontSize="10"/>
        <TextBlock Grid.Column="1" Text="{Binding Temperature1, StringFormat=N2}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"/>
  <TextBlock Grid.Column="2" Text="{Binding Temperature2, StringFormat=N2}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"/>
         <TextBlock Grid.Column="3" Text="{Binding Pressure1, StringFormat=N0}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"/>
      <TextBlock Grid.Column="4" Text="{Binding Pressure2, StringFormat=N0}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"/>
     </Grid>
        </DataTemplate>
    </UserControl.Resources>

  <Grid Margin="15" RenderTransformOrigin="0.466,0.489">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
         </Grid.RowDefinitions>
         <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- Status Bar -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="{StaticResource PanelBorder}" CornerRadius="8" Padding="15" Margin="0">
        <DockPanel>
         <StackPanel Orientation="Horizontal">
            <TextBlock Text="FLEX BENDING MACHINE" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
         <Border Background="{StaticResource OkGreen}" Margin="20,0,0,0" Padding="8,2" CornerRadius="4" VerticalAlignment="Center">
            <TextBlock Text="RUNNING" FontSize="10" FontWeight="Bold" Foreground="White"/>
         </Border>
         </StackPanel>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
  <TextBlock Text="{Binding CycleTime, StringFormat='CYCLE TIME: {0:F1}s'}" Foreground="White" FontWeight="Bold" Margin="0,0,20,0"/>
     <TextBlock Text="EFFICIENCY: 94%" Foreground="{StaticResource OkGreen}" FontWeight="Bold"/>
        </StackPanel>
   </DockPanel>
        </Border>

    <!-- Data Tables Header Row -->
        <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Background="{StaticResource PanelBorder}" CornerRadius="8" Padding="5" Margin="0" BorderBrush="{StaticResource AccentBlue}" BorderThickness="1.5">
          <UniformGrid Columns="4">
       <!-- INPUT INSPECTION PANEL -->
       <Border BorderBrush="{StaticResource AccentBlue}" BorderThickness="1" CornerRadius="8" Background="{StaticResource TableBg}" ClipToBounds="True">
         <StackPanel>
        <Grid Background="{StaticResource AccentBlue}">
           <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
         </Grid.ColumnDefinitions>
      <TextBlock Text="INPUT INSPECTION" Foreground="White" FontWeight="Bold" FontSize="11" Padding="8,4" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding InputBatchId}" Foreground="White" FontSize="10" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center"/>
 </Grid>

<Grid>
           <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
       <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
             <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="65"/>
     </Grid.ColumnDefinitions>

         <Border Grid.RowSpan="2" BorderBrush="#333" BorderThickness="0,0,1,1">
               <TextBlock Text="Part No." Foreground="White" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
 </Border>
 <Border Grid.Column="1" BorderBrush="#333" BorderThickness="0,0,1,1">
     <TextBlock Text="Measurement" Foreground="White" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center"/>
            </Border>
                  <Border Grid.RowSpan="2" Grid.Column="2" BorderBrush="#333" BorderThickness="0,0,0,1">
           <TextBlock Text="Result" Foreground="White" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>

            <Grid Grid.Row="1" Grid.Column="1">
           <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="*"/>
               </Grid.ColumnDefinitions>
     <Border BorderBrush="#333" BorderThickness="0,0,1,0">
             <TextBlock Text="X" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
       </Border>
          <Border Grid.Column="1" BorderBrush="#333" BorderThickness="0,0,1,0">
     <TextBlock Text="Y" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
               </Border>
         <Border Grid.Column="2" BorderBrush="#333" BorderThickness="0,0,1,0">
                <TextBlock Text="Z" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
          </Border>
           <Border Grid.Column="3">
          <TextBlock Text="θ" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
               </Border>
     </Grid>

        <!-- Dynamic Input Inspection Data -->
          <ScrollViewer Grid.Row="2" Grid.ColumnSpan="3" VerticalScrollBarVisibility="Auto" MaxHeight="150">
  <ItemsControl ItemsSource="{Binding InputInspectionData}" ItemTemplate="{StaticResource InspectionRowTemplate}"/>
       </ScrollViewer>
 </Grid>
    </StackPanel>
             </Border>

              <!-- BENDING UAT 1-2 PANEL -->
        <Border BorderBrush="White" BorderThickness="1" Margin="2" Background="#111">
     <StackPanel>
          <Grid Background="{StaticResource AccentBlue}">
         <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="*"/>
         </Grid.ColumnDefinitions>
           <TextBlock Text="   BENDING UAT 1 - 2" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Padding="0,4" Margin="-2,0,2,0"/>
           <TextBlock Grid.Column="1" Text="{Binding BendingBatchId1}" Foreground="White" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
  </Grid>

            <Grid>
      <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
       </Grid.RowDefinitions>
           <Grid.ColumnDefinitions>
     <ColumnDefinition Width="80"/>
<ColumnDefinition Width="*"/>
    <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>

          <Border Grid.RowSpan="2" BorderBrush="White" BorderThickness="0,0,1,1">
           <TextBlock Text="Part No." Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
         <Border Grid.Column="1" Grid.ColumnSpan="2" BorderBrush="White" BorderThickness="0,0,1,1">
    <TextBlock Text="Temp('C)" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Padding="2"/>
             </Border>
       <Border Grid.Column="3" Grid.ColumnSpan="2" BorderBrush="White" BorderThickness="0,0,0,1">
 <TextBlock Text="Force(N)" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Padding="2"/>
         </Border>

          <Border Grid.Row="1" Grid.Column="1" BorderBrush="White" BorderThickness="0,0,1,1">
                 <TextBlock Text="B-1" Foreground="White" FontSize="9" HorizontalAlignment="Center"/>
   </Border>
           <Border Grid.Row="1" Grid.Column="2" BorderBrush="White" BorderThickness="0,0,1,1">
      <TextBlock Text="B-2" Foreground="White" FontSize="9" HorizontalAlignment="Center"/>
             </Border>
           <Border Grid.Row="1" Grid.Column="3" BorderBrush="White" BorderThickness="0,0,1,1">
           <TextBlock Text="B-1" Foreground="White" FontSize="9" HorizontalAlignment="Center"/>
                 </Border>
     <Border Grid.Row="1" Grid.Column="4" BorderBrush="White" BorderThickness="0,0,0,1">
    <TextBlock Text="B-2" Foreground="White" FontSize="9" HorizontalAlignment="Center"/>
     </Border>

             <!-- Dynamic Bending UAT 1-2 Data -->
   <ScrollViewer Grid.Row="2" Grid.ColumnSpan="5" VerticalScrollBarVisibility="Auto" MaxHeight="150">
     <ItemsControl ItemsSource="{Binding BendingUAT1Data}" ItemTemplate="{StaticResource BendingParameterRowTemplate}"/>
     </ScrollViewer>
      </Grid>
      </StackPanel>
      </Border>

     <!-- BENDING UAT 3-4 PANEL -->
 <Border BorderBrush="White" BorderThickness="1" Margin="2" Background="#111">
        <StackPanel>
      <Grid Background="{StaticResource AccentBlue}">
   <Grid.ColumnDefinitions>
   <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
               <TextBlock Text="   BENDING UAT 3 - 4" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Padding="0,4"/>
  <TextBlock Grid.Column="1" Text="{Binding BendingBatchId2}" Foreground="White" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
           </Grid>

               <Grid>
 <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
           <Grid.ColumnDefinitions>
    <ColumnDefinition Width="80"/>
  <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

        <Border Grid.RowSpan="2" BorderBrush="White" BorderThickness="0,0,1,1">
   <TextBlock Text="Part No." Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
         <Border Grid.Column="1" Grid.ColumnSpan="2" BorderBrush="White" BorderThickness="0,0,1,1">
         <TextBlock Text="Temp('C)" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Padding="2"/>
  </Border>
            <Border Grid.Column="3" Grid.ColumnSpan="2" BorderBrush="White" BorderThickness="0,0,0,1">
       <TextBlock Text="Force(N)" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Padding="2"/>
          </Border>

     <Border Grid.Row="1" Grid.Column="1" BorderBrush="White" BorderThickness="0,0,1,1">
      <TextBlock Text="B-3" Foreground="White" FontSize="9" HorizontalAlignment="Center"/>
     </Border>
        <Border Grid.Row="1" Grid.Column="2" BorderBrush="White" BorderThickness="0,0,1,1">
          <TextBlock Text="B-4" Foreground="White" FontSize="9" HorizontalAlignment="Center"/>
           </Border>
      <Border Grid.Row="1" Grid.Column="3" BorderBrush="White" BorderThickness="0,0,1,1">
      <TextBlock Text="B-3" Foreground="White" FontSize="9" HorizontalAlignment="Center"/>
             </Border>
              <Border Grid.Row="1" Grid.Column="4" BorderBrush="White" BorderThickness="0,0,0,1">
       <TextBlock Text="B-4" Foreground="White" FontSize="9" HorizontalAlignment="Center"/>
</Border>

       <!-- Dynamic Bending UAT 3-4 Data -->
     <ScrollViewer Grid.Row="2" Grid.ColumnSpan="5" VerticalScrollBarVisibility="Auto" MaxHeight="150">
         <ItemsControl ItemsSource="{Binding BendingUAT3Data}" ItemTemplate="{StaticResource BendingParameterRowTemplate}"/>
  </ScrollViewer>
     </Grid>
            </StackPanel>
     </Border>

     <!-- OUTPUT INSPECTION PANEL -->
<Border BorderBrush="{StaticResource AccentBlue}" BorderThickness="1" CornerRadius="8" Background="{StaticResource TableBg}" ClipToBounds="True">
            <StackPanel>
        <Grid Background="{StaticResource AccentBlue}">
 <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*"/>
 <ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>
  <TextBlock Text="OUTPUT INSPECTION" Foreground="White" FontWeight="Bold" FontSize="11" Padding="8,4" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="{Binding OutputBatchId}" Foreground="White" FontSize="10" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid>

          <Grid>
       <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
     </Grid.RowDefinitions>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="80"/>
       <ColumnDefinition Width="*"/>
   <ColumnDefinition Width="65"/>
      </Grid.ColumnDefinitions>

      <Border Grid.RowSpan="2" BorderBrush="#333" BorderThickness="0,0,1,1">
           <TextBlock Text="Part No." Foreground="White" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
      <Border Grid.Column="1" BorderBrush="#333" BorderThickness="0,0,1,1">
   <TextBlock Text="Measurement" Foreground="White" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center"/>
</Border>
   <Border Grid.RowSpan="2" Grid.Column="2" BorderBrush="#333" BorderThickness="0,0,0,1">
           <TextBlock Text="Result" Foreground="White" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
  </Border>

           <Grid Grid.Row="1" Grid.Column="1">
         <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="*"/>
                 <ColumnDefinition Width="*"/>
 <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>
    <Border BorderBrush="#333" BorderThickness="0,0,1,0">
     <TextBlock Text="X" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
         </Border>
          <Border Grid.Column="1" BorderBrush="#333" BorderThickness="0,0,1,0">
             <TextBlock Text="Y" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
            </Border>
        <Border Grid.Column="2" BorderBrush="#333" BorderThickness="0,0,1,0">
           <TextBlock Text="Z" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
      </Border>
        <Border Grid.Column="3">
 <TextBlock Text="θ" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
       </Border>
       </Grid>

           <!-- Dynamic Output Inspection Data -->
          <ScrollViewer Grid.Row="2" Grid.ColumnSpan="3" VerticalScrollBarVisibility="Auto" MaxHeight="150">
             <ItemsControl ItemsSource="{Binding OutputInspectionData}" ItemTemplate="{StaticResource InspectionRowTemplate}"/>
        </ScrollViewer>
   </Grid>
                    </StackPanel>
          </Border>
            </UniformGrid>
        </Border>

        <!-- Controls Section -->
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0" VerticalAlignment="Top">
    <TextBlock Text="CONTROLS" FontWeight="Bold" FontSize="12" Margin="0,0,0,10" Foreground="{StaticResource LightGray}"/>
      <Border Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,10" BorderBrush="{StaticResource BorderGray}" BorderThickness="1">
     <StackPanel>
          <UniformGrid Columns="2">
               <Button Margin="2" Padding="5" Background="{StaticResource AccentBlue}" Foreground="White" FontWeight="Bold" BorderThickness="0">
        <TextBlock Text="AUTO RUN" TextWrapping="Wrap" TextAlignment="Center"/>
      </Button>
           <Button Margin="2" Padding="5" Background="{StaticResource LightGray}" Foreground="White" FontWeight="Bold" BorderThickness="0">
       <TextBlock Text="DRY RUN" TextWrapping="Wrap" TextAlignment="Center"/>
           </Button>
        </UniformGrid>

  <UniformGrid Columns="2" Margin="0,5,0,0">
       <Button Margin="2" Padding="5" Background="{StaticResource OkGreen}" Foreground="White" FontWeight="Bold" BorderThickness="0">
            <TextBlock Text="CYCLE START/STOP" TextWrapping="Wrap" TextAlignment="Center"/>
     </Button>
  <Button Margin="2" Padding="5" Background="#6366F1" Foreground="White" FontWeight="Bold" BorderThickness="0">
         <TextBlock Text="WORK PAYOUT START" TextWrapping="Wrap" TextAlignment="Center"/>
         </Button>
          </UniformGrid>

    <Button Margin="2,5,2,2" Padding="10" Background="#F59E0B" Foreground="White" FontWeight="Bold" BorderThickness="0">
        <TextBlock Text="MASS RETURN TO ORIGIN" TextWrapping="Wrap" TextAlignment="Center"/>
       </Button>
          </StackPanel>
            </Border>
   </StackPanel>

        <!-- Process Flow Section -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0" VerticalAlignment="Top">
    <TextBlock Text="PROCESS FLOW" FontWeight="Bold" FontSize="12" Margin="0,0,0,10" Foreground="{StaticResource LightGray}"/>

  <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8" Background="{StaticResource DarkBg}" ClipToBounds="True" >
           <Grid>
        <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
             <RowDefinition Height="*"/>
                 </Grid.RowDefinitions>

     <Border Background="{StaticResource PanelBorder}" Padding="8,5">
      <Grid>
    <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
     <TextBlock Text="STATUS" Foreground="White" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="BATCH ID" Foreground="White" FontWeight="Bold" FontSize="10" Margin="0,0,15,0"/>
      </Grid>
          </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
     <ItemsControl ItemsSource="{Binding ProcessEventsList}">
   <ItemsControl.ItemTemplate>
  <DataTemplate>
<Grid Margin="8,4">
     <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
  </Grid.ColumnDefinitions>
<TextBlock Text="{Binding}" Foreground="White" FontSize="10.5" TextWrapping="Wrap"/>
      </Grid>
    </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
          </ScrollViewer>
                </Grid>
            </Border>
        </StackPanel>

     <!-- Visualization Canvas (Optimized for Responsiveness) -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
    <Viewbox Stretch="Uniform" Margin="10">
     <Canvas Width="1290" Height="550">
       <!-- Bending Operations - B1, B2, B3, B4 Indicators -->
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" 
    Canvas.Top="20" Canvas.Left="380" Width="678">
            <ItemsControl ItemsSource="{Binding BendingIndicators}">
    <ItemsControl.ItemsPanel>
 <ItemsPanelTemplate>
                 <StackPanel Orientation="Horizontal"/>
     </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
         <ItemsControl.ItemTemplate>
     <DataTemplate>
   <Border CornerRadius="5" Background="{StaticResource TableBg}" BorderBrush="{StaticResource AccentBlue}" BorderThickness="1.5" Margin="3">
      <StackPanel>
       <Border Background="{StaticResource AccentBlue}" Padding="6,3">
          <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="10" HorizontalAlignment="Left"/>
    </Border>
    <Grid Margin="10,8">
               <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
           </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
         </Grid.ColumnDefinitions>
          <ItemsControl ItemsSource="{Binding Indicators}">
             <ItemsControl.ItemsPanel>
             <ItemsPanelTemplate>
     <Grid/>
   </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
  <ItemsControl.ItemTemplate>
    <DataTemplate>
  <Ellipse Width="9" Height="9" Fill="{Binding IsActive, Converter={StaticResource BoolToColorConverter}}" Margin="3" ToolTip="{Binding ToolTip}"/>
         </DataTemplate>
 </ItemsControl.ItemTemplate>
        </ItemsControl>
   </Grid>
    </StackPanel>
         </Border>
  </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
           </StackPanel>

       <!-- Input/Output Trays and Turn Tables (Simplified References) -->
             <TextBlock Text="(Turn Tables and Trays visualization - Canvas positioning simplified for responsiveness)" 
         Canvas.Left="20" Canvas.Top="450" Foreground="{StaticResource LightGray}" FontSize="10"/>
           </Canvas>
            </Viewbox>
        </ScrollViewer>
    </Grid>
</UserControl>