                        <Button Style="{StaticResource AlphaOperationButtonStyle}" Content="{Binding CurrentPage.SelectedButtons[17].Content}" Command="{Binding ButtonCommand}" CommandParameter="{Binding CurrentPage.SelectedButtons[17].CommandParameter}" Visibility="{Binding CurrentPage.SelectedButtons[17].IsVisible}" IsEnabled="{Binding CurrentPage.SelectedButtons[17].IsEnabled}" FontSize="20" Tag="18"/>
                        <Button Style="{StaticResource AlphaOperationButtonStyle}" Content="{Binding CurrentPage.SelectedButtons[18].Content}" Command="{Binding ButtonCommand}" CommandParameter="{Binding CurrentPage.SelectedButtons[18].CommandParameter}" Visibility="{Binding CurrentPage.SelectedButtons[18].IsVisible}" IsEnabled="{Binding CurrentPage.SelectedButtons[18].IsEnabled}" FontSize="20" Tag="19"/>
                        <Button Style="{StaticResource AlphaOperationButtonStyle}" Content="{Binding CurrentPage.SelectedButtons[19].Content}" Command="{Binding ButtonCommand}" CommandParameter="{Binding CurrentPage.SelectedButtons[19].CommandParameter}" Visibility="{Binding CurrentPage.SelectedButtons[19].IsVisible}" IsEnabled="{Binding CurrentPage.SelectedButtons[19].IsEnabled}" FontSize="20" Tag="20"/>--><!--
                    </UniformGrid>-->

                </ScrollViewer>
            </Grid>
        </Border>

        
        <!--Page M02-->

        <Border Grid.Row="1" 
        Background="White" 
        BorderBrush="#E2E8F0" 
        BorderThickness="1" 
        CornerRadius="12" 
        Padding="3" 
        Margin="3"
        Visibility="{Binding SelectedPageIndex, Converter={StaticResource BindingManualPageVisibilityConverter}, ConverterParameter=1}">
            <Grid Margin="3">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                Background="#1A1A1A"
                BorderBrush="#333333"
                BorderThickness="1"
                CornerRadius="4"
                Padding="3">

                    <TextBlock Text="MANUAL MONITOR(INPUT UNIT)"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="Consolas"/>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <GroupBox Grid.Row="0" Grid.Column="0" Margin="5">
                            <GroupBox.Header>
                                <TextBlock Text="M02: INPUT Module (SUPPLY)" Foreground="Black" FontSize="18" FontWeight="Black"/>
                            </GroupBox.Header>
                            <Grid Margin="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <GroupBox Grid.Row="0" Grid.Column="0" Style="{StaticResource ControlGroupBoxStyle}">
                                    <GroupBox.Header>
                                        <TextBlock Text="SUPPLY CONVEYOR" Style="{StaticResource ControlGroupBoxHeaderStyle}"/>
                                    </GroupBox.Header>
                                    <UniformGrid Style="{StaticResource ControlUniformGridStyle}">
                                        <Button Content="STOP" Height="60" Style="{StaticResource PushButtonGreenStyle}" 
                                        Command="{Binding ButtonCommand}" CommandParameter="M02SupplyConveyorStop"/>
                                        <Button Content="FORWARD" Height="60" Style="{StaticResource PushButtonGreenStyle}" 
                                        Command="{Binding ButtonCommand}" CommandParameter="M02SupplyConveyorForward"/>
                                        <Button Content="BACKWARD" Height="60" Style="{StaticResource PushButtonBlueStyle}" 
                                        Command="{Binding ButtonCommand}" CommandParameter="M02SupplyConveyorBackward"/>
                                    </UniformGrid>
                                </GroupBox>

                                <GroupBox Grid.Row="1" Grid.Column="0" Style="{StaticResource ControlGroupBoxStyle}">
                                    <GroupBox.Header>
                                        <TextBlock Text="SUPPLY TRAY CHUCK (L/R)" Style="{StaticResource ControlGroupBoxHeaderStyle}"/>
                                    </GroupBox.Header>
                                    <UniformGrid Style="{StaticResource ControlUniformGridStyle}">
                                        <Button Content="UNCHUCK" Height="60" Style="{StaticResource PushButtonGreenStyle}" 
                                        Command="{Binding ButtonCommand}" CommandParameter="M02SupplyTrayChuckUnchuck"/>
                                        <Button Content="CHUCK" Height="60" Style="{StaticResource PushButtonBlueStyle}" 
                                        Command="{Binding ButtonCommand}" CommandParameter="M02SupplyTrayChuckChuck"/>
                                        <Border Background="Transparent"/>
                                    </UniformGrid>
                                </GroupBox>

                                <GroupBox Grid.Row="2" Grid.Column="0" Style="{StaticResource ControlGroupBoxStyle}">
                                    <GroupBox.Header>
                                        <TextBlock Text="SUPPLY TRAY RELEASE (L/R)" Style="{StaticResource ControlGroupBoxHeaderStyle}"/>
                                    </GroupBox.Header>
                                    <UniformGrid Style="{StaticResource ControlUniformGridStyle}">
                                        <Button Content="DOWN" Height="60" Style="{StaticResource PushButtonBlueStyle}" 
                                        Command="{Binding ButtonCommand}" CommandParameter="M02SupplyTrayReleaseDown"/>
                                        <Button Content="CENTER" Height="60" Style="{StaticResource PushButtonGreenStyle}" 
                                        Command="{Binding ButtonCommand}" CommandParameter="M02SupplyTrayReleaseCenter"/>
                                        <Button Content="UP" Height="60" Style="{StaticResource PushButtonBlueStyle}" 
                                        Command="{Binding ButtonCommand}" CommandParameter="M02SupplyTrayReleaseUp"/>
                                    </UniformGrid>
                                </GroupBox>

                                <GroupBox Grid.Row="3" Grid.Column="0" Style="{StaticResource ControlGroupBoxStyle}">
                                    <GroupBox.Header>
                                        <TextBlock Text="SUPPLY TRAY STOPPER" Style="{StaticResource ControlGroupBoxHeaderStyle}"/>
                                    </GroupBox.Header>
                                    <UniformGrid Style="{StaticResource ControlUniformGridStyle}">
                                        <Button Content="UP" Height="60" Style="{StaticResource PushButtonGreenStyle}" 
                                        Command="{Binding ButtonCommand}" CommandParameter="M02SupplyTrayStopperUp"/>
                                        <Button Content="DOWN" Height="60" Style="{StaticResource PushButtonBlueStyle}" 
                                        Command="{Binding ButtonCommand}" CommandParameter="M02SupplyTrayStopperDown"/>
                                    </UniformGrid>
                                </GroupBox>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="M02: INPUT Module (LIFT UP/DOWN)" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="5" FontWeight="Bold" Foreground="Black" FontSize="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <GroupBox Header="LIFT CONVEYOR" Grid.Row="0" Grid.Column="0" Style="{StaticResource ControlGroupBoxStyle}">
                                    <UniformGrid Style="{StaticResource ControlUniformGridStyle}">
                                        <Button Content="STOP" Height="60" Style="{StaticResource PushButtonGreenStyle}" 
                                        Command="{Binding ButtonCommand}" CommandParameter="M02LiftConveyorStop"/>
                                        <Button Content="FORWARD" Height="60" Style="{StaticResource PushButtonGreenStyle}" 
                                        Command="{Binding ButtonCommand}" CommandParameter="M02LiftConveyorForward"/>
                                        <Button Content="BACKWARD" Height="60" Style="{StaticResource PushButtonBlueStyle}" 
                                        Command="{Binding ButtonCommand}" CommandParameter="M02LiftConveyorBackward"/>
                                    </UniformGrid>
                                </GroupBox>

                                <GroupBox Header="LIFT TRAY STOPPER" FontSize="16" FontWeight="Bold" Foreground="Black" Grid.Row="1" Grid.Column="0" Style="{StaticResource ControlGroupBoxStyle}">
                                    <UniformGrid Style="{StaticResource ControlUniformGridStyle}">
                                        <Button Content="UP" Height="60" Style="{StaticResource PushButtonGreenStyle}" 
                                        Command="{Binding ButtonCommand}" CommandParameter="M02LiftTrayStopperUp"/>
                                        <Button Content="DOWN" Height="60" Style="{StaticResource PushButtonBlueStyle}" 
                                        Command="{Binding ButtonCommand}" CommandParameter="M02LiftTrayStopperDown"/>
                                    </UniformGrid>
                                </GroupBox>

                                <GroupBox Header="LIFT TRAY HOLDER" Grid.Row="0" Grid.Column="1" Style="{StaticResource ControlGroupBoxStyle}">
                                    <UniformGrid Style="{StaticResource ControlUniformGridStyle}">
                                        <Button Content="Backward" Height="60" Margin="3" FontWeight="Bold" Style="{StaticResource PushButtonBlueStyle}" 
                                        Command="{Binding ButtonCommand}" CommandParameter="M02LiftTrayHolderBackward"/>
                                        <Button Content="Forward" Height="60" Margin="3" Style="{StaticResource PushButtonGreenStyle}" 
                                        Command="{Binding ButtonCommand}" CommandParameter="M02LiftTrayHolderForward"/>
                                    </UniformGrid>
                                </GroupBox>

                                <GroupBox Header="LIFT UNIT" Grid.Row="1" Grid.Column="1" Style="{StaticResource ControlGroupBoxStyle}">
                                    <UniformGrid Style="{StaticResource ControlUniformGridStyle}">
                                        <Button Content="Down" Height="60" Style="{StaticResource PushButtonBlueStyle}" 
                                        Command="{Binding ButtonCommand}" CommandParameter="M02LiftUnitDown"/>
                                        <Button Content="UP" Height="60" Style="{StaticResource PushButtonGreenStyle}" 
                                        Command="{Binding ButtonCommand}" CommandParameter="M02LiftUnitUp"/>
                                    </UniformGrid>
                                </GroupBox>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="M02: INPUT Module (DISCHARGE)" Grid.Row="0" Grid.Column="1" Margin="5" Foreground="Black" FontWeight="Bold" FontSize="18">
                            <Grid Margin="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <GroupBox Header="DISCHARGE CONVEYOR" Grid.Row="0" Grid.Column="0" Style="{StaticResource ControlGroupBoxStyle}">
                                    <UniformGrid Style="{StaticResource ControlUniformGridStyle}">
                                        <Button Content="STOP" Height="60" Margin="3" Style="{StaticResource PushButtonGreenStyle}" 
                                        Command="{Binding ButtonCommand}" CommandParameter="M02DischargeConveyorStop"/>
                                        <Button Content="FORWARD" Height="60" Margin="3" Style="{StaticResource PushButtonGreenStyle}" 
                                        Command="{Binding ButtonCommand}" CommandParameter="M02DischargeConveyorForward"/>
                                        <Button Content="BACKWARD" Height="60" Margin="3" Style="{StaticResource PushButtonBlueStyle}" 
                                        Command="{Binding ButtonCommand}" CommandParameter="M02DischargeConveyorBackward"/>
                                    </UniformGrid>
                                </GroupBox>

                                <GroupBox Header="DISCHARGE TRAY CHUCK (L/R)" Grid.Row="1" Grid.Column="0" Style="{StaticResource ControlGroupBoxStyle}">
                                    <UniformGrid Style="{StaticResource ControlUniformGridStyle}">
                                        <Button Content="UNCHUCK" Height="60" Style="{StaticResource PushButtonGreenStyle}" 
                                        Command="{Binding ButtonCommand}" CommandParameter="M02DischargeTrayChuckUnchunk"/>
                                        <Button Content="CHUCK" Height="60" Style="{StaticResource PushButtonGreenStyle}" 
                                        Command="{Binding ButtonCommand}" CommandParameter="M02DischargeTrayChuckChuk"/>
                                    </UniformGrid>
                                </GroupBox>

                                <GroupBox Header="DISCHARGE TRAY Release (L/R)" Grid.Row="2" Grid.Column="0" Style="{StaticResource ControlGroupBoxStyle}">
                                    <UniformGrid Style="{StaticResource ControlUniformGridStyle}">
                                        <Button Content="Down" Height="60" Style="{StaticResource PushButtonGreenStyle}" 
                                        Command="{Binding ButtonCommand}" CommandParameter="M02DischargeTrayReleaseDown"/>
                                        <Button Content="Center" Height="60" Style="{StaticResource PushButtonGreenStyle}" 
                                        Command="{Binding ButtonCommand}" CommandParameter="M02DischargeTrayReleaseCenter"/>
                                        <Button Content="UP" Height="60" Style="{StaticResource PushButtonGreenStyle}" 
                                        Command="{Binding ButtonCommand}" CommandParameter="M02DischargeTrayReleaseUp"/>
                                    </UniformGrid>
                                </GroupBox>

                                <GroupBox Header="DISCHARGE TRAY STOPPER" Grid.Row="3" Grid.Column="0" Style="{StaticResource ControlGroupBoxStyle}">
                                    <UniformGrid Style="{StaticResource ControlUniformGridStyle}">
                                        <Button Content="UP" Height="60" Style="{StaticResource PushButtonGreenStyle}" 
                                        Command="{Binding ButtonCommand}" CommandParameter="M02DischargeTrayStopperUp"/>
                                        <Button Content="DOWN" Height="60" Style="{StaticResource PushButtonGreenStyle}" 
                                        Command="{Binding ButtonCommand}" CommandParameter="M02DischargeTrayStopperDown"/>
                                    </UniformGrid>
                                </GroupBox>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>


        <!--page M03-->


        <Border Grid.Row="1" 
        Background="White" 
        BorderBrush="#E2E8F0" 
        BorderThickness="1" 
        CornerRadius="12" 
        Padding="3" 
        Margin="3"
        Visibility="{Binding SelectedPageIndex, Converter={StaticResource BindingManualPageVisibilityConverter}, ConverterParameter=2}">
            <Grid Margin="3">

                <Grid.RowDefinitions>
