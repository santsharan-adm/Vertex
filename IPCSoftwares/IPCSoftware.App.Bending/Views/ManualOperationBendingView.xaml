                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <GroupBox Grid.Row="0" Grid.Column="0" Style="{StaticResource ControlGroupBoxStyle}">
                                    <GroupBox.Header>
                                        <TextBlock Text="SUPPLY CONVEYOR" Style="{StaticResource ControlGroupBoxHeaderStyle}"/>
                                    </GroupBox.Header>
                                    <UniformGrid Style="{StaticResource ControlUniformGridStyle}">
                                        <Button Content="STOP" Height="60" Style="{StaticResource PushButtonGreenStyle}" 
