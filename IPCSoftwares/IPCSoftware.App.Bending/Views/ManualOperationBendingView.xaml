<UserControl x:Class="IPCSoftware.App.Bending.Views.ManualOperationBendingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:IPCSoftware.App.Bending.Views"
             mc:Ignorable="d"
             d:DesignHeight="768"
             d:DesignWidth="1024">

    <UserControl.Resources>
        <Style x:Key="AlphaOperationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EBF8FF"/>
                    <Setter Property="BorderBrush" Value="#3182CE"/>
                    <Setter Property="Foreground" Value="#2B6CB0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#BEE3F8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#EDF2F7"/>
                    <Setter Property="Foreground" Value="#A0AEC0"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AlphaNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0D47A1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1565C0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0A3C83"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#A0AEC0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20" Background="#F7FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Manual Operation" 
                   FontSize="28" 
                   FontWeight="Bold" 
                   Foreground="#1A202C" 
                   HorizontalAlignment="Center" 
                   Margin="0,5,0,15"/>

        <Border Grid.Row="1" 
                Background="White" 
                BorderBrush="#E2E8F0" 
                BorderThickness="1" 
                CornerRadius="12" 
                Padding="15" 
                Margin="0,0,0,15">

            <GroupBox Header="{Binding CurrentPage.Title}" 
                      BorderThickness="0" 
                      FontSize="18" 
                      FontWeight="Bold" 
                      Foreground="#4A5568">

                <UniformGrid Rows="4" Columns="5" Margin="0,10,0,0">
                    <Button Style="{StaticResource AlphaOperationButtonStyle}" Content="{Binding CurrentPage.SelectedButtons[0].Content}" Command="{Binding ButtonCommand}" CommandParameter="{Binding CurrentPage.SelectedButtons[0].CommandParameter}" Visibility="{Binding CurrentPage.SelectedButtons[0].IsVisible}" IsEnabled="{Binding CurrentPage.SelectedButtons[0].IsEnabled}" Tag="1"/>
                    <Button Style="{StaticResource AlphaOperationButtonStyle}" Content="{Binding CurrentPage.SelectedButtons[1].Content}" Command="{Binding ButtonCommand}" CommandParameter="{Binding CurrentPage.SelectedButtons[1].CommandParameter}" Visibility="{Binding CurrentPage.SelectedButtons[1].IsVisible}" IsEnabled="{Binding CurrentPage.SelectedButtons[1].IsEnabled}" Tag="2"/>
                    <Button Style="{StaticResource AlphaOperationButtonStyle}" Content="{Binding CurrentPage.SelectedButtons[2].Content}" Command="{Binding ButtonCommand}" CommandParameter="{Binding CurrentPage.SelectedButtons[2].CommandParameter}" Visibility="{Binding CurrentPage.SelectedButtons[2].IsVisible}" IsEnabled="{Binding CurrentPage.SelectedButtons[2].IsEnabled}" Tag="3"/>
                    <Button Style="{StaticResource AlphaOperationButtonStyle}" Content="{Binding CurrentPage.SelectedButtons[3].Content}" Command="{Binding ButtonCommand}" CommandParameter="{Binding CurrentPage.SelectedButtons[3].CommandParameter}" Visibility="{Binding CurrentPage.SelectedButtons[3].IsVisible}" IsEnabled="{Binding CurrentPage.SelectedButtons[3].IsEnabled}" Tag="4"/>
                    <Button Style="{StaticResource AlphaOperationButtonStyle}" Content="{Binding CurrentPage.SelectedButtons[4].Content}" Command="{Binding ButtonCommand}" CommandParameter="{Binding CurrentPage.SelectedButtons[4].CommandParameter}" Visibility="{Binding CurrentPage.SelectedButtons[4].IsVisible}" IsEnabled="{Binding CurrentPage.SelectedButtons[4].IsEnabled}" Tag="5"/>
                    <Button Style="{StaticResource AlphaOperationButtonStyle}" Content="{Binding CurrentPage.SelectedButtons[5].Content}" Command="{Binding ButtonCommand}" CommandParameter="{Binding CurrentPage.SelectedButtons[5].CommandParameter}" Visibility="{Binding CurrentPage.SelectedButtons[5].IsVisible}" IsEnabled="{Binding CurrentPage.SelectedButtons[5].IsEnabled}" Tag="6"/>
                    <Button Style="{StaticResource AlphaOperationButtonStyle}" Content="{Binding CurrentPage.SelectedButtons[6].Content}" Command="{Binding ButtonCommand}" CommandParameter="{Binding CurrentPage.SelectedButtons[6].CommandParameter}" Visibility="{Binding CurrentPage.SelectedButtons[6].IsVisible}" IsEnabled="{Binding CurrentPage.SelectedButtons[6].IsEnabled}" Tag="7"/>
                    <Button Style="{StaticResource AlphaOperationButtonStyle}" Content="{Binding CurrentPage.SelectedButtons[7].Content}" Command="{Binding ButtonCommand}" CommandParameter="{Binding CurrentPage.SelectedButtons[7].CommandParameter}" Visibility="{Binding CurrentPage.SelectedButtons[7].IsVisible}" IsEnabled="{Binding CurrentPage.SelectedButtons[7].IsEnabled}" Tag="8"/>
                    <Button Style="{StaticResource AlphaOperationButtonStyle}" Content="{Binding CurrentPage.SelectedButtons[8].Content}" Command="{Binding ButtonCommand}" CommandParameter="{Binding CurrentPage.SelectedButtons[8].CommandParameter}" Visibility="{Binding CurrentPage.SelectedButtons[8].IsVisible}" IsEnabled="{Binding CurrentPage.SelectedButtons[8].IsEnabled}" Tag="9"/>
                    <Button Style="{StaticResource AlphaOperationButtonStyle}" Content="{Binding CurrentPage.SelectedButtons[9].Content}" Command="{Binding ButtonCommand}" CommandParameter="{Binding CurrentPage.SelectedButtons[9].CommandParameter}" Visibility="{Binding CurrentPage.SelectedButtons[9].IsVisible}" IsEnabled="{Binding CurrentPage.SelectedButtons[9].IsEnabled}" Tag="10"/>
                    <Button Style="{StaticResource AlphaOperationButtonStyle}" Content="{Binding CurrentPage.SelectedButtons[10].Content}" Command="{Binding ButtonCommand}" CommandParameter="{Binding CurrentPage.SelectedButtons[10].CommandParameter}" Visibility="{Binding CurrentPage.SelectedButtons[10].IsVisible}" IsEnabled="{Binding CurrentPage.SelectedButtons[10].IsEnabled}" Tag="11"/>
                    <Button Style="{StaticResource AlphaOperationButtonStyle}" Content="{Binding CurrentPage.SelectedButtons[11].Content}" Command="{Binding ButtonCommand}" CommandParameter="{Binding CurrentPage.SelectedButtons[11].CommandParameter}" Visibility="{Binding CurrentPage.SelectedButtons[11].IsVisible}" IsEnabled="{Binding CurrentPage.SelectedButtons[11].IsEnabled}" Tag="12"/>
                    <Button Style="{StaticResource AlphaOperationButtonStyle}" Content="{Binding CurrentPage.SelectedButtons[12].Content}" Command="{Binding ButtonCommand}" CommandParameter="{Binding CurrentPage.SelectedButtons[12].CommandParameter}" Visibility="{Binding CurrentPage.SelectedButtons[12].IsVisible}" IsEnabled="{Binding CurrentPage.SelectedButtons[12].IsEnabled}" Tag="13"/>
                    <Button Style="{StaticResource AlphaOperationButtonStyle}" Content="{Binding CurrentPage.SelectedButtons[13].Content}" Command="{Binding ButtonCommand}" CommandParameter="{Binding CurrentPage.SelectedButtons[13].CommandParameter}" Visibility="{Binding CurrentPage.SelectedButtons[13].IsVisible}" IsEnabled="{Binding CurrentPage.SelectedButtons[13].IsEnabled}" Tag="14"/>
                    <Button Style="{StaticResource AlphaOperationButtonStyle}" Content="{Binding CurrentPage.SelectedButtons[14].Content}" Command="{Binding ButtonCommand}" CommandParameter="{Binding CurrentPage.SelectedButtons[14].CommandParameter}" Visibility="{Binding CurrentPage.SelectedButtons[14].IsVisible}" IsEnabled="{Binding CurrentPage.SelectedButtons[14].IsEnabled}" Tag="15"/>
                    <Button Style="{StaticResource AlphaOperationButtonStyle}" Content="{Binding CurrentPage.SelectedButtons[15].Content}" Command="{Binding ButtonCommand}" CommandParameter="{Binding CurrentPage.SelectedButtons[15].CommandParameter}" Visibility="{Binding CurrentPage.SelectedButtons[15].IsVisible}" IsEnabled="{Binding CurrentPage.SelectedButtons[15].IsEnabled}" Tag="16"/>
                    <Button Style="{StaticResource AlphaOperationButtonStyle}" Content="{Binding CurrentPage.SelectedButtons[16].Content}" Command="{Binding ButtonCommand}" CommandParameter="{Binding CurrentPage.SelectedButtons[16].CommandParameter}" Visibility="{Binding CurrentPage.SelectedButtons[16].IsVisible}" IsEnabled="{Binding CurrentPage.SelectedButtons[16].IsEnabled}" Tag="17"/>
                    <Button Style="{StaticResource AlphaOperationButtonStyle}" Content="{Binding CurrentPage.SelectedButtons[17].Content}" Command="{Binding ButtonCommand}" CommandParameter="{Binding CurrentPage.SelectedButtons[17].CommandParameter}" Visibility="{Binding CurrentPage.SelectedButtons[17].IsVisible}" IsEnabled="{Binding CurrentPage.SelectedButtons[17].IsEnabled}" Tag="18"/>
                    <Button Style="{StaticResource AlphaOperationButtonStyle}" Content="{Binding CurrentPage.SelectedButtons[18].Content}" Command="{Binding ButtonCommand}" CommandParameter="{Binding CurrentPage.SelectedButtons[18].CommandParameter}" Visibility="{Binding CurrentPage.SelectedButtons[18].IsVisible}" IsEnabled="{Binding CurrentPage.SelectedButtons[18].IsEnabled}" Tag="19"/>
                    <Button Style="{StaticResource AlphaOperationButtonStyle}" Content="{Binding CurrentPage.SelectedButtons[19].Content}" Command="{Binding ButtonCommand}" CommandParameter="{Binding CurrentPage.SelectedButtons[19].CommandParameter}" Visibility="{Binding CurrentPage.SelectedButtons[19].IsVisible}" IsEnabled="{Binding CurrentPage.SelectedButtons[19].IsEnabled}" Tag="20"/>
                </UniformGrid>
            </GroupBox>
        </Border>

        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Margin="0,5,0,5">

            <Button Style="{StaticResource AlphaNavButtonStyle}" Content="First" Command="{Binding FirstCommand}"/>
            <Button Style="{StaticResource AlphaNavButtonStyle}" Content="Previous" Command="{Binding PreviousCommand}"/>

            <ComboBox Width="150" Height="48" Margin="5" 
                      VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                      FontSize="16" FontWeight="SemiBold" Background="White" 
                      ItemsSource="{Binding ManualPageList}" SelectedItem="{Binding SelectedPage, Mode=OneWay}">
                
             
            </ComboBox>

            <Button Style="{StaticResource AlphaNavButtonStyle}" Content="Next" Command="{Binding NextCommand}"/>
            <Button Style="{StaticResource AlphaNavButtonStyle}" Content="Last" Command="{Binding LastCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>