                       VerticalAlignment="Center"
                       FontFamily="Consolas"/>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="3">
                        <Grid.RowDefinitions>
