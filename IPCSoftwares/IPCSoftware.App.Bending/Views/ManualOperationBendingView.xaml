                    <TextBlock Text="Return to Origin"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="Consolas"/>
                </Border>

                <!-- BODY -->
                <ScrollViewer Grid.Row="1"
                        VerticalScrollBarVisibility="Auto">

