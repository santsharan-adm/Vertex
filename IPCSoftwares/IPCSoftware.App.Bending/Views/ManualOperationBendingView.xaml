                        <GroupBox Grid.Row="0" Grid.Column="0" Margin="5">
                            <GroupBox.Header>
                                <TextBlock Text="M03: INPUT Module (SUPPLY)" Foreground="Black" FontSize="18" FontWeight="Black"/>
                            </GroupBox.Header>
                            <Grid Margin="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
