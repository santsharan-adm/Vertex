<UserControl x:Class="IPCSoftware.App.Bending.Views.Dashboard2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cc="clr-namespace:IPCSoftware.App.Bending.Controls"
             xmlns:conv="clr-namespace:IPCSoftware.App.Bending.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1672" Background="#F1F5F9"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IPCSoftware.App.Bending;component/Resources/BendingRD2.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToColorConverter x:Key="BoolToColor"/>
            <conv:BoolToResultTextConverter x:Key="BoolToResultText"/>
            <conv:BoolToResultColorConverter x:Key="BoolToResultColor"/>
            <conv:EmptyOrZeroToStringConverter x:Key="EmptyOrZeroToString"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6" />   <!-- splitter column -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="180"/>
            <ColumnDefinition Width="6"/>     <!-- splitter column -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- Vertical GridSplitter between Column 0 and Column 1 (after column1) -->
        <GridSplitter Grid.Row="0"
              Grid.RowSpan="6"
              Grid.Column="1"
              Width="6"
              HorizontalAlignment="Left"
              VerticalAlignment="Stretch"
              Background="#334155"
              ShowsPreview="True"
              ResizeDirection="Columns"
              ResizeBehavior="PreviousAndNext"
              Margin="0"
              Panel.ZIndex="100"/>

        <!-- Horizontal GridSplitter between Row 1 and Row 2 (after row1) -->
        <GridSplitter Grid.Column="0"
              Grid.ColumnSpan="3"
              Grid.Row="1"
              Height="6"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Stretch"
              Background="#334155"
              ShowsPreview="True"
              ResizeDirection="Rows"
              ResizeBehavior="PreviousAndNext"
              Margin="0"
              Panel.ZIndex="100"/>
        <!--Controls-->
       

        <cc:ControlsPanelCC Grid.Row="0" Grid.Column="0" BorderBrush="#1565C0" BorderThickness="2" Background="#0B1A2E"/>       

        <!--Batch No. & QR Code-->
        <cc:BatchQRCodePanelCC  Grid.Row="2"  Grid.Column="0" Grid.RowSpan="1"  
                                BorderBrush="#1565C0" BorderThickness="1" Background="White" 
                                DataContext="{Binding DashboardInspectionModelBatches}"/>

        <cc:BatchQRCodePanelCC  Grid.Row="3"  Grid.Column="0" Grid.RowSpan="1"  
                        BorderBrush="#1565C0" BorderThickness="1" Background="White" />
        <!--EFFICIENCY BREAKDOWN-->
        <cc:EfficiencyBreakdownCC Grid.Row="4"  Grid.Column="0" Grid.RowSpan="2"  Background="#1E293B" Margin="3" Padding="3"/>
       

        <!--Bending 1,2,3,4-->
        <cc:BendingDataTableCC Grid.Row="0" Grid.Column="2" 
                               Background="#0B1A2E"  Padding="2" BorderBrush="#1565C0" BorderThickness="1"
                               DataContext="{Binding DashboardInspectionModelBatches}"/>

        
        <!--Bending Operation-->
        <Viewbox Grid.Row="2" Grid.Column="2" Grid.RowSpan="4" Stretch="None" Margin="3" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Canvas Width="1186" Height="450" >


                <!--INPUT TRAY-->
                <cc:InputTrayCC Canvas.Left="333" Canvas.Top="520" Width="160" Height="40"
                 Background="#F1F5F9" BorderBrush="#475569" BorderThickness="3"
                 StationIndex="0" BatchNo="{Binding BendingStationTrace.Station0BatchNo}"/>
                
                
                <!--INSPECTION UNIT - 1-->
                <cc:InspectionUnitInputCC Canvas.Left="303" Canvas.Top="405" Width="215"                                           
                           Background="#F8FAFC" BorderBrush="#475569" BorderThickness="3"
                                          StationIndex="1" BatchNo="{Binding BendingStationTrace.Station1BatchNo}"/>
               

                <!--Robot1-->
                <cc:Robot1CC RobotNumber="1" Canvas.Top="437" Canvas.Left="50"/>


                <!--Robot2-->
                <cc:Robot2CC Canvas.Left="1140" Canvas.Top="447"/>

                <!-- BENDINDICATORS - Clamp, Heat, Punch, Tear, Flip -->
                <cc:BendStatusIndicatorsCC Canvas.Left="60" Canvas.Top="5"
                                           BorderBrush="Black" BorderThickness="1.5"
                                           DataContext="{Binding BendingIndicators}"/>

                <!--Tearing & Flipping-->
                <cc:TearingFlippingStatusCC Canvas.Left="1117" Canvas.Top="5" BorderBrush="Black" BorderThickness="1.5"
                                            DataContext="{Binding BendingIndicators}"/>
                

               
                
                <!--TT-1-->
                <cc:TurnTable1CC Canvas.Left="334" Canvas.Top="148" />

                <cc:StationIndexCC Canvas.Left="334" Canvas.Top="348" Width="150"
                    StationIndex="2" BatchNo="{Binding BendingStationTrace.Station2BatchNo}"
                                   BorderBrush="Brown" BorderThickness="1" Padding="3"/>
                <cc:StationIndexCC Canvas.Left="229" Canvas.Top="228" Width="100"
                                   BorderBrush="Brown" BorderThickness="1" Padding="3"
                    StationIndex="3" BatchNo="{Binding BendingStationTrace.Station3BatchNo}"/>

                <cc:StationIndexCC Canvas.Left="334" Canvas.Top="118" Width="150"
                        StationIndex="4" BatchNo="{Binding BendingStationTrace.Station4BatchNo}"
                                       BorderBrush="Brown" BorderThickness="1" Padding="3"/>
                <!--<cc:StationIndexCC Canvas.Left="334" Canvas.Top="118" Width="150"
                        StationIndex="5" BatchNo="{Binding BendingStationTrace.Station5BatchNo}"
                                       BorderBrush="Brown" BorderThickness="1" Padding="3"/>-->
                <cc:StationIndexCC Canvas.Left="494" Canvas.Top="268" Width="150"
                     StationIndex="5" BatchNo="{Binding BendingStationTrace.Station6BatchNo}"
                                    BorderBrush="Brown" BorderThickness="1" Padding="3"/>



                <!--Transfer Module-->
                <cc:TransferModuleCC Canvas.Left="603" Canvas.Top="148" />


                <!-- Turn Table 2 rotating disc: circle + triangle + ellipses -->
                <cc:TurnTable2CC x:Name="TurnTable2Control"
                                 Canvas.Left="804"
                                 Canvas.Top="148"
                                 Width="220"
                                 Height="230"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top" />
                <cc:StationIndexCC Canvas.Left="594" Canvas.Top="108" Width="150"
                     StationIndex="6" BatchNo="{Binding BendingStationTrace.Station7BatchNo}"
                                    BorderBrush="Brown" BorderThickness="1" Padding="3"/>

                <cc:StationIndexCC Canvas.Left="844" Canvas.Top="108" Width="150"
                     StationIndex="7" BatchNo="{Binding BendingStationTrace.Station8BatchNo}"
                                    BorderBrush="Brown" BorderThickness="1" Padding="3"/>

                <cc:StationIndexCC Canvas.Left="844" Canvas.Top="298" Width="150"
                         StationIndex="8" BatchNo="{Binding BendingStationTrace.Station9BatchNo}"
                                        BorderBrush="Brown" BorderThickness="1" Padding="3"/>
                
                <!--INSPECTION UNIT-->
                <cc:InspectionUnitOutputCC Canvas.Left="820" Canvas.Top="405" Width="215" 
                                     Background="#F8FAFC" BorderBrush="#475569" BorderThickness="3" 
                                           StationIndex="10" BatchNo="1"                                           
                                     />

               
                
                <!--OUTPUT TRAY-->
                <cc:OutputTrayCC Canvas.Left="850" Canvas.Top="520" Width="160" Height="40" 
                                 Background="White" BorderBrush="#475569" BorderThickness="3"/>
                <!--NG BIN 2-->
                <cc:NgBinCC Canvas.Left="108" Canvas.Top="200" Width="85" Height="95" BinNumber="1" 
                            BorderBrush="Black" BorderThickness="3" Background="Gray"/>
                <!--PID  HETER-->           
                <cc:PidTableTemperatureCC Canvas.Left="1320" Canvas.Top="5"   BorderBrush="{StaticResource AccentBlue}" 
                            BorderThickness="1" Background="#1565C0"
                               DataContext="{Binding BendingIndicators}"/>

                <!--PID FORCE-->               
                <cc:PidTableForceCC Canvas.Left="1320" Canvas.Top="180"
                                    DataContext="{Binding BendingIndicators}"/>

                <!--NG BIN 2-->              
                <cc:NgBinCC Canvas.Left="1102" Canvas.Top="200" Width="85" Height="95" BinNumber="2" 
                            BorderBrush="Black" BorderThickness="3"  Background="Gray"/>
            </Canvas>
        </Viewbox>
        
        
    </Grid>

</UserControl>