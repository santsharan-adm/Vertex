<UserControl x:Class="IPCSoftware.App.Bending.Views.Dashboard2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cc="clr-namespace:IPCSoftware.App.Bending.Controls"
             xmlns:conv="clr-namespace:IPCSoftware.App.Bending.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1672" Background="#F1F5F9"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IPCSoftware.App.Bending;component/Resources/BendingRD2.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToColorConverter x:Key="BoolToColor"/>
            <conv:BoolToResultTextConverter x:Key="BoolToResultText"/>
            <conv:BoolToResultColorConverter x:Key="BoolToResultColor"/>
            <conv:EmptyOrZeroToStringConverter x:Key="EmptyOrZeroToString"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MinHeight="0"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="180"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <!-- Vertical GridSplitter between Column 0 and Column 1 (after column1) -->
        <GridSplitter Grid.Row="0"
              Grid.RowSpan="5"
              Grid.Column="1"
              Width="6"
              HorizontalAlignment="Left"
              VerticalAlignment="Stretch"
              Background="#334155"
              ShowsPreview="True"
              ResizeDirection="Columns"
              ResizeBehavior="PreviousAndNext"
              Margin="0"
              Panel.ZIndex="100"/>

        <!-- Horizontal GridSplitter between Row 1 and Row 2 (after row1) -->
        <GridSplitter Grid.Column="0"
              Grid.ColumnSpan="3"
              Grid.Row="1"
              Height="6"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Stretch"
              Background="#334155"
              ShowsPreview="True"
              ResizeDirection="Rows"
              ResizeBehavior="PreviousAndNext"
              Margin="0"
              Panel.ZIndex="100"/>
        <!--Controls-->
       

        <cc:ControlsPanelCC Grid.Row="0" Grid.Column="0" BorderBrush="#1565C0" BorderThickness="2" Background="#0B1A2E"/>       

        <!--Batch No. & QR Code-->
        <cc:BatchQRCodePanelCC  Grid.Row="1"  Grid.Column="0" Grid.RowSpan="2"  
                                BorderBrush="#1565C0" BorderThickness="1" Background="White" />
        <!--EFFICIENCY BREAKDOWN-->
        <cc:EfficiencyBreakdownCC Grid.Row="3"  Grid.Column="0"  Background="#1E293B" Margin="3" Padding="3"/>
       

        <!--Bending 1,2,3,4-->
        <cc:BendingDataTableCC Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" 
                               Background="#0B1A2E"  Padding="2" BorderBrush="#1565C0" BorderThickness="1"/>

        
        <!--Bending Operation-->
        <Viewbox Grid.Row="2" Grid.Column="1" Stretch="Uniform" Margin="3">
            <Canvas Width="1186" Height="450" RenderOptions.CachingHint="Cache" RenderOptions.CacheInvalidationThresholdMinimum="0.5" RenderOptions.CacheInvalidationThresholdMaximum="2.0">
               

                <!--Robot1-->
                <cc:Robot1CC RobotNumber="1" Canvas.Top="337" Canvas.Left="130"/>


                <!--Robot2-->
                <cc:Robot2CC Canvas.Left="940" Canvas.Top="347"/>

                <!-- BENDINDICATORS - Clamp, Heat, Punch, Tear, Flip -->
                <cc:BendStatusIndicatorsCC Canvas.Left="60" Canvas.Top="5"
                                           BorderBrush="Black" BorderThickness="1.5"/>
                <!-- BENDINDICATORS2- Tearing + Flipping Section -->
                <!--<Border CornerRadius="5" Canvas.Left="807" BorderBrush="Black" BorderThickness="1.5" Height="Auto" VerticalAlignment="Top" HorizontalAlignment="Center" Canvas.Top="5">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Height="45" >

                        <Border CornerRadius="5" Background="{StaticResource TableBg}" BorderBrush="{StaticResource AccentBlue}" BorderThickness="1.5" Margin="3">
                            <StackPanel>
                                <Border Background="{StaticResource AccentBlue}" Padding="6,3">
                                    <TextBlock Text="Tearing" Foreground="White" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"/>
                                </Border>
                                <Grid Margin="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="0"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="0"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Row="1" Grid.Column="0" Width="9" Height="9" Fill="{Binding BendingIndicators.Bending1.Flex1.Tearing, Converter={StaticResource BoolToColor}}"  VerticalAlignment="Center" Margin="3" ToolTip="TearHeat1"/>
                                    <Ellipse Grid.Row="1" Grid.Column="1" Width="9" Height="9" Fill="{Binding BendingIndicators.Bending1.Flex2.Tearing, Converter={StaticResource BoolToColor}}"  VerticalAlignment="Center" Margin="3" ToolTip="TearHeat2"/>
                                    <Ellipse Grid.Row="1" Grid.Column="2" Width="9" Height="9" Fill="{Binding BendingIndicators.Bending1.Flex3.Tearing, Converter={StaticResource BoolToColor}}"  VerticalAlignment="Center" Margin="3" ToolTip="TearHeat3"/>
                                    <Ellipse Grid.Row="1" Grid.Column="3" Width="9" Height="9" Fill="{Binding BendingIndicators.Bending1.Flex4.Tearing, Converter={StaticResource BoolToColor}}"  VerticalAlignment="Center" Margin="3" ToolTip="TearHeat4"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="5" Background="{StaticResource TableBg}" BorderBrush="{StaticResource AccentBlue}" BorderThickness="1.5" Margin="3">
                            <StackPanel>
                                <Border Background="{StaticResource AccentBlue}" Padding="6,3">
                                    <TextBlock Text="Flipping" Foreground="White" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"/>
                                </Border>
                                <Grid Margin="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="0"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="0"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Row="1" Grid.Column="0" Width="9" Height="9" Fill="{Binding BendingIndicators.Bending1.Flex1.Flipping, Converter={StaticResource BoolToColor}}"  VerticalAlignment="Center" Margin="3" ToolTip="TearHeat1"/>
                                    <Ellipse Grid.Row="1" Grid.Column="1" Width="9" Height="9" Fill="{Binding BendingIndicators.Bending1.Flex2.Flipping, Converter={StaticResource BoolToColor}}"  VerticalAlignment="Center" Margin="3" ToolTip="TearHeat2"/>
                                    <Ellipse Grid.Row="1" Grid.Column="2" Width="9" Height="9" Fill="{Binding BendingIndicators.Bending1.Flex3.Flipping, Converter={StaticResource BoolToColor}}"  VerticalAlignment="Center" Margin="3" ToolTip="TearHeat3"/>
                                    <Ellipse Grid.Row="1" Grid.Column="3" Width="9" Height="9" Fill="{Binding BendingIndicators.Bending1.Flex4.Flipping, Converter={StaticResource BoolToColor}}"  VerticalAlignment="Center" Margin="3" ToolTip="TearHeat4"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>-->

                <!--Tearing & Flipping-->
                <cc:TearingFlippingStatusCC Canvas.Left="807" Canvas.Top="5" BorderBrush="Black" BorderThickness="1.5"/>
                

                <!--Transfer Module-->
                <cc:TransferModuleCC Canvas.Left="503" Canvas.Top="66" />
                

                <cc:TurnTable1CC Canvas.Left="334" Canvas.Top="58" />


                <!--INSPECTION UNIT - 1-->
                <cc:InspectionUnitInputCC Canvas.Left="343" Canvas.Top="305" Width="215" Height="55" 
                                          Background="#F8FAFC" BorderBrush="#475569" BorderThickness="3"/>
                <!--INPUT TRAY-->
                <cc:InputTrayCC Canvas.Left="367" Canvas.Top="370" Width="160" Height="40"
                                Background="#F1F5F9" BorderBrush="#475569" BorderThickness="3"/>               

                <!-- Turn Table 2 rotating disc: circle + triangle + ellipses -->
                <cc:TurnTable2CC x:Name="TurnTable2Control"
                                 Canvas.Left="664"
                                 Canvas.Top="60"
                                 Width="220"
                                 Height="230"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top" />
                <!--INSPECTION UNIT-->
                <cc:InspectionUnitOutputCC Canvas.Left="620" Canvas.Top="305" Width="215" Height="55"
                                     Background="#F8FAFC" BorderBrush="#475569" BorderThickness="3" 
                                     />
                <!--OUTPUT TRAY-->
                <cc:OutputTrayCC Canvas.Left="651" Canvas.Top="370" Width="160" Height="40" 
                                 Background="White" BorderBrush="#475569" BorderThickness="3"/>
                <!--NG BIN 2-->
                <cc:NgBinCC Canvas.Left="138" Canvas.Top="200" Width="85" Height="95" BinNumber="1" 
                            BorderBrush="Black" BorderThickness="3" Background="Gray"/>
                <!--PID  HETER-->           
                <cc:PidTableCC Canvas.Left="970" Canvas.Top="52"   TableType="Heater" BorderBrush="{StaticResource AccentBlue}" 
                            BorderThickness="1" Background="#1565C0"/>

                <!--PID FORCE-->               
                <cc:PidTableCC Canvas.Left="968" Canvas.Top="175"   TableType="Force"/>

                <!--NG BIN 2-->              
                <cc:NgBinCC Canvas.Left="882" Canvas.Top="200" Width="85" Height="95" BinNumber="2" 
                            BorderBrush="Black" BorderThickness="3"  Background="Gray"/>
            </Canvas>
        </Viewbox>
        
        
    </Grid>

</UserControl>