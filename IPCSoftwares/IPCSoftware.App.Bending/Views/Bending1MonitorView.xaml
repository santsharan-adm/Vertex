<UserControl x:Class="IPCSoftware.App.Bending.Views.Bending1MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:IPCSoftware.App.Bending.Converters"
             Background="White" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <UserControl.Resources>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>

        <!-- Modern Navigation Button Style (consistent with App.AOI) -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.1"/>
                            </Border.Effect>
                            <ContentPresenter x:Name="content" 
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2196F3"/>
                                <Setter TargetName="border" Property="Background" Value="#E3F2FD"/>
                                <Setter TargetName="content" Property="TextElement.Foreground" Value="#2196F3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#BBDEFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TableBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="0.5"/>
        </Style>

        <Style x:Key="CommonTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: Button Row -->
            <RowDefinition Height="*"/>
            <!-- 1: Main Content -->
            <RowDefinition Height="60"/>
            <!-- 2: BLANK SPACE FOR ALARM -->
        </Grid.RowDefinitions>

        <!-- NEXT Button Section -->
        <Button Grid.Row="0" Content="NEXT" Style="{StaticResource NavButtonStyle}" 
                HorizontalAlignment="Right" Background="#007ACC" Command="{Binding NextCommand}"/>

        <Viewbox Grid.Row="1" Stretch="Uniform">
            <Border BorderBrush="Black" BorderThickness="1.2" Width="980" Height="520">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="95"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Grid.ColumnSpan="6" BorderBrush="Black" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="Bending Monitor 1" Style="{StaticResource CommonTextStyle}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Style="{StaticResource CommonTextStyle}" FontSize="11" 
                                       FontWeight="Bold" HorizontalAlignment="Left" Margin="3">
                                <Run Text="Batch No - "/>
                                <Run Text="{Binding BendingModel.BatchNo}"/>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Table Headers -->
                    <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource TableBorderStyle}" Background="#F2F2F2">
                        <TextBlock Text="Product" Style="{StaticResource CommonTextStyle}"/>
                    </Border>
                    <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource TableBorderStyle}" Background="#F2F2F2">
                        <TextBlock Text="QR Code" Style="{StaticResource CommonTextStyle}"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource TableBorderStyle}" Background="#F2F2F2">
                        <TextBlock Text="Load (N)" Style="{StaticResource CommonTextStyle}"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource TableBorderStyle}" Background="#F2F2F2">
                        <TextBlock Text="Temp (°C)" Style="{StaticResource CommonTextStyle}"/>
                    </Border>
                    <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="4" Style="{StaticResource TableBorderStyle}" Background="#F2F2F2">
                        <TextBlock Text="Bending&#x0a;Time (s)" Style="{StaticResource CommonTextStyle}"/>
                    </Border>
                    <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="5" Style="{StaticResource TableBorderStyle}" Background="#F2F2F2">
                        <TextBlock Text="Result" Style="{StaticResource CommonTextStyle}"/>
                    </Border>

                    <!-- Sub Headers -->
                    <UniformGrid Grid.Row="2" Grid.Column="2" Columns="3">
                        <Border Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="Upper Limit" Style="{StaticResource CommonTextStyle}" FontSize="11"/>
                        </Border>
                        <Border Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="Present Value" Style="{StaticResource CommonTextStyle}" FontSize="11"/>
                        </Border>
                        <Border Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="Lower Limit" Style="{StaticResource CommonTextStyle}" FontSize="11"/>
                        </Border>
                    </UniformGrid>
                    <UniformGrid Grid.Row="2" Grid.Column="3" Columns="3">
                        <Border Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="Upper Limit" Style="{StaticResource CommonTextStyle}" FontSize="11"/>
                        </Border>
                        <Border Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="Present Value" Style="{StaticResource CommonTextStyle}" FontSize="11"/>
                        </Border>
                        <Border Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="Lower Limit" Style="{StaticResource CommonTextStyle}" FontSize="11"/>
                        </Border>
                    </UniformGrid>

                    <!-- Row 3: Product 1 -->
                    <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource TableBorderStyle}">
                        <TextBlock Text="{Binding BendingModel.Product1.Product}" Style="{StaticResource CommonTextStyle}"/>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource TableBorderStyle}">
                        <TextBlock Text="{Binding BendingModel.Product1.QRCode}" Style="{StaticResource CommonTextStyle}" FontSize="11" FontWeight="Bold" TextWrapping="Wrap"/>
                    </Border>
                    <UniformGrid Grid.Row="3" Grid.Column="2" Columns="3">
                        <Border Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="{Binding BendingModel.Product1.Load.UpperLimit, StringFormat='{}{0:0.00}'}" Style="{StaticResource CommonTextStyle}"/>
                        </Border>
                        <Border Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="{Binding BendingModel.Product1.Load.PresentValue, StringFormat='{}{0:0.00}'}" Style="{StaticResource CommonTextStyle}"/>
                        </Border>
                        <Border Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="{Binding BendingModel.Product1.Load.LowerLimit, StringFormat='{}{0:0.00}'}" Style="{StaticResource CommonTextStyle}"/>
                        </Border>
                    </UniformGrid>
                    <UniformGrid Grid.Row="3" Grid.Column="3" Columns="3">
                        <Border Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="{Binding BendingModel.Product1.Temperature.UpperLimit, StringFormat='{}{0:0.00}'}" Style="{StaticResource CommonTextStyle}"/>
                        </Border>
                        <Border Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="{Binding BendingModel.Product1.Temperature.PresentValue, StringFormat='{}{0:0.00}'}" Style="{StaticResource CommonTextStyle}"/>
                        </Border>
                        <Border Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="{Binding BendingModel.Product1.Temperature.LowerLimit, StringFormat='{}{0:0.00}'}" Style="{StaticResource CommonTextStyle}"/>
                        </Border>
                    </UniformGrid>
                    <Border Grid.Row="3" Grid.Column="4" Style="{StaticResource TableBorderStyle}">
                        <TextBlock Text="{Binding BendingModel.Product1.BendingTime, StringFormat='{}{0:0.00}'}" Style="{StaticResource CommonTextStyle}"/>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="5" Style="{StaticResource TableBorderStyle}">
                        <Rectangle Width="55" Height="48" Fill="{Binding BendingModel.Product1.Result, Converter={StaticResource BoolToColorConverter}, ConverterParameter=Result}" RadiusX="2" RadiusY="2" Stroke="#999"/>
                    </Border>

                    <!-- Row 4: Product 2 -->
                    <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource TableBorderStyle}">
                        <TextBlock Text="{Binding BendingModel.Product2.Product}" Style="{StaticResource CommonTextStyle}"/>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource TableBorderStyle}">
                        <TextBlock Text="{Binding BendingModel.Product2.QRCode}" Style="{StaticResource CommonTextStyle}" FontSize="11" FontWeight="Bold" TextWrapping="Wrap"/>
                    </Border>
                    <UniformGrid Grid.Row="4" Grid.Column="2" Columns="3">
                        <Border Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="{Binding BendingModel.Product2.Load.UpperLimit, StringFormat='{}{0:0.00}'}" Style="{StaticResource CommonTextStyle}"/>
                        </Border>
                        <Border Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="{Binding BendingModel.Product2.Load.PresentValue, StringFormat='{}{0:0.00}'}" Style="{StaticResource CommonTextStyle}"/>
                        </Border>
                        <Border Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="{Binding BendingModel.Product2.Load.LowerLimit, StringFormat='{}{0:0.00}'}" Style="{StaticResource CommonTextStyle}"/>
                        </Border>
                    </UniformGrid>
                    <UniformGrid Grid.Row="4" Grid.Column="3" Columns="3">
                        <Border Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="{Binding BendingModel.Product2.Temperature.UpperLimit, StringFormat='{}{0:0.00}'}" Style="{StaticResource CommonTextStyle}"/>
                        </Border>
                        <Border Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="{Binding BendingModel.Product2.Temperature.PresentValue, StringFormat='{}{0:0.00}'}" Style="{StaticResource CommonTextStyle}"/>
                        </Border>
                        <Border Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="{Binding BendingModel.Product2.Temperature.LowerLimit, StringFormat='{}{0:0.00}'}" Style="{StaticResource CommonTextStyle}"/>
                        </Border>
                    </UniformGrid>
                    <Border Grid.Row="4" Grid.Column="4" Style="{StaticResource TableBorderStyle}">
                        <TextBlock Text="{Binding BendingModel.Product2.BendingTime, StringFormat='{}{0:0.00}'}" Style="{StaticResource CommonTextStyle}"/>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="5" Style="{StaticResource TableBorderStyle}">
                        <Rectangle Width="55" Height="48" Fill="{Binding BendingModel.Product2.Result, Converter={StaticResource BoolToColorConverter}, ConverterParameter=Result}" RadiusX="2" RadiusY="2" Stroke="#999"/>
                    </Border>

                    <!-- Row 5: Product 3 -->
                    <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource TableBorderStyle}">
                        <TextBlock Text="{Binding BendingModel.Product3.Product}" Style="{StaticResource CommonTextStyle}"/>
                    </Border>
                    <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource TableBorderStyle}">
                        <TextBlock Text="{Binding BendingModel.Product3.QRCode}" Style="{StaticResource CommonTextStyle}" FontSize="11" FontWeight="Bold" TextWrapping="Wrap"/>
                    </Border>
                    <UniformGrid Grid.Row="5" Grid.Column="2" Columns="3">
                        <Border Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="{Binding BendingModel.Product3.Load.UpperLimit, StringFormat='{}{0:0.00}'}" Style="{StaticResource CommonTextStyle}"/>
                        </Border>
                        <Border Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="{Binding BendingModel.Product3.Load.PresentValue, StringFormat='{}{0:0.00}'}" Style="{StaticResource CommonTextStyle}"/>
                        </Border>
                        <Border Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="{Binding BendingModel.Product3.Load.LowerLimit, StringFormat='{}{0:0.00}'}" Style="{StaticResource CommonTextStyle}"/>
                        </Border>
                    </UniformGrid>
                    <UniformGrid Grid.Row="5" Grid.Column="3" Columns="3">
                        <Border Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="{Binding BendingModel.Product3.Temperature.UpperLimit, StringFormat='{}{0:0.00}'}" Style="{StaticResource CommonTextStyle}"/>
                        </Border>
                        <Border Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="{Binding BendingModel.Product3.Temperature.PresentValue, StringFormat='{}{0:0.00}'}" Style="{StaticResource CommonTextStyle}"/>
                        </Border>
                        <Border Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="{Binding BendingModel.Product3.Temperature.LowerLimit, StringFormat='{}{0:0.00}'}" Style="{StaticResource CommonTextStyle}"/>
                        </Border>
                    </UniformGrid>
                    <Border Grid.Row="5" Grid.Column="4" Style="{StaticResource TableBorderStyle}">
                        <TextBlock Text="{Binding BendingModel.Product3.BendingTime, StringFormat='{}{0:0.00}'}" Style="{StaticResource CommonTextStyle}"/>
                    </Border>
                    <Border Grid.Row="5" Grid.Column="5" Style="{StaticResource TableBorderStyle}">
                        <Rectangle Width="55" Height="48" Fill="{Binding BendingModel.Product3.Result, Converter={StaticResource BoolToColorConverter}, ConverterParameter=Result}" RadiusX="2" RadiusY="2" Stroke="#999"/>
                    </Border>

                    <!-- Row 6: Product 4 -->
                    <Border Grid.Row="6" Grid.Column="0" Style="{StaticResource TableBorderStyle}">
                        <TextBlock Text="{Binding BendingModel.Product4.Product}" Style="{StaticResource CommonTextStyle}"/>
                    </Border>
                    <Border Grid.Row="6" Grid.Column="1" Style="{StaticResource TableBorderStyle}">
                        <TextBlock Text="{Binding BendingModel.Product4.QRCode}" Style="{StaticResource CommonTextStyle}" FontSize="11" FontWeight="Bold" TextWrapping="Wrap"/>
                    </Border>
                    <UniformGrid Grid.Row="6" Grid.Column="2" Columns="3">
                        <Border Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="{Binding BendingModel.Product4.Load.UpperLimit, StringFormat='{}{0:0.00}'}" Style="{StaticResource CommonTextStyle}"/>
                        </Border>
                        <Border Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="{Binding BendingModel.Product4.Load.PresentValue, StringFormat='{}{0:0.00}'}" Style="{StaticResource CommonTextStyle}"/>
                        </Border>
                        <Border Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="{Binding BendingModel.Product4.Load.LowerLimit, StringFormat='{}{0:0.00}'}" Style="{StaticResource CommonTextStyle}"/>
                        </Border>
                    </UniformGrid>
                    <UniformGrid Grid.Row="6" Grid.Column="3" Columns="3">
                        <Border Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="{Binding BendingModel.Product4.Temperature.UpperLimit, StringFormat='{}{0:0.00}'}" Style="{StaticResource CommonTextStyle}"/>
                        </Border>
                        <Border Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="{Binding BendingModel.Product4.Temperature.PresentValue, StringFormat='{}{0:0.00}'}" Style="{StaticResource CommonTextStyle}"/>
                        </Border>
                        <Border Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="{Binding BendingModel.Product4.Temperature.LowerLimit, StringFormat='{}{0:0.00}'}" Style="{StaticResource CommonTextStyle}"/>
                        </Border>
                    </UniformGrid>
                    <Border Grid.Row="6" Grid.Column="4" Style="{StaticResource TableBorderStyle}">
                        <TextBlock Text="{Binding BendingModel.Product4.BendingTime, StringFormat='{}{0:0.00}'}" Style="{StaticResource CommonTextStyle}"/>
                    </Border>
                    <Border Grid.Row="6" Grid.Column="5" Style="{StaticResource TableBorderStyle}">
                        <Rectangle Width="55" Height="48" Fill="{Binding BendingModel.Product4.Result, Converter={StaticResource BoolToColorConverter}, ConverterParameter=Result}" RadiusX="2" RadiusY="2" Stroke="#999"/>
                    </Border>
                </Grid>
            </Border>
        </Viewbox>

        <!-- Blank Space for Alarm at the bottom -->
        <Border Grid.Row="2" Background="Transparent" />
    </Grid>
</UserControl>