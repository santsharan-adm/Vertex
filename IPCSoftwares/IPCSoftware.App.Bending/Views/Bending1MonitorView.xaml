<UserControl x:Class="IPCSoftware.App.Bending.Views.Bending1MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Black"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

	<UserControl.Resources>
		<Style x:Key="CellBorderStyle" TargetType="Border">
			<Setter Property="BorderBrush" Value="#444"/>
			<Setter Property="BorderThickness" Value="0.5"/>
		</Style>

		<Style x:Key="HeaderTextStyle" TargetType="TextBlock">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontSize" Value="20"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="TextAlignment" Value="Center"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>

		<Style x:Key="DataTextStyle" TargetType="TextBlock">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontSize" Value="18"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="TextAlignment" Value="Center"/>
		</Style>

		<Style x:Key="ValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DataTextStyle}">
			<Setter Property="Foreground" Value="#00FF00"/>
			<Setter Property="FontWeight" Value="Bold"/>
		</Style>

		<Style x:Key="ResultBoxStyle" TargetType="Rectangle">
			<Setter Property="Fill" Value="Silver"/>
			<Setter Property="Width" Value="45"/>
			<Setter Property="Height" Value="45"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
	</UserControl.Resources>

	<Grid Margin="5">
		<Grid.RowDefinitions>
			<RowDefinition Height="60"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Grid Grid.Row="0" Background="Black">
			<Button Content="GO TO MENU" HorizontalAlignment="Left" Width="130" Height="40" Margin="10,0,0,0"
                    Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="0"/>

			<TextBlock Text="BENDING 1 MONITOR" Foreground="White" FontSize="32"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>

			<Button HorizontalAlignment="Right" Width="55" Background="Red" BorderThickness="0">
				<TextBlock Text="↩" Foreground="White" FontSize="28" FontWeight="Bold"/>
			</Button>
		</Grid>

		<Border Grid.Row="1" BorderBrush="#555" BorderThickness="1"
                Margin="20,10,20,10">
			<Grid x:Name="TableGrid">
				<Grid.RowDefinitions>
					<RowDefinition Height="50"/>
					<RowDefinition Height="60"/>
					<RowDefinition Height="100"/>
					<RowDefinition Height="100"/>
					<RowDefinition Height="100"/>
					<RowDefinition Height="100"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="140"/>
					<ColumnDefinition Width="100"/>
					<ColumnDefinition Width="100"/>
					<ColumnDefinition Width="100"/>
					<ColumnDefinition Width="150"/>
					<ColumnDefinition Width="220"/>
					<ColumnDefinition Width="140"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<Border Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="3" Style="{StaticResource CellBorderStyle}" Background="#111">
					<TextBlock Text="Measured Value" Style="{StaticResource HeaderTextStyle}" FontSize="22"/>
				</Border>

				<Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="Product" Style="{StaticResource HeaderTextStyle}"/>
				</Border>
				<Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="Upper" Style="{StaticResource HeaderTextStyle}"/>
				</Border>
				<Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="Value" Style="{StaticResource HeaderTextStyle}"/>
				</Border>
				<Border Grid.Row="1" Grid.Column="3" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="Lower" Style="{StaticResource HeaderTextStyle}"/>
				</Border>
				<Border Grid.Row="1" Grid.Column="4" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="Load Monitor" Style="{StaticResource HeaderTextStyle}"/>
				</Border>
				<Border Grid.Row="1" Grid.Column="5" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="Temperature Monitor" Style="{StaticResource HeaderTextStyle}"/>
				</Border>
				<Border Grid.Row="1" Grid.Column="6" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="Bending Time" Style="{StaticResource HeaderTextStyle}"/>
				</Border>
				<Border Grid.Row="1" Grid.Column="7" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="Result" Style="{StaticResource HeaderTextStyle}"/>
				</Border>

				<Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="Product 1&#x0a;1ST" Style="{StaticResource DataTextStyle}"/>
				</Border>
				<Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="{Binding P1_Upper}" Style="{StaticResource DataTextStyle}"/>
				</Border>
				<Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="{Binding P1_Value}" Style="{StaticResource ValueTextStyle}"/>
				</Border>
				<Border Grid.Row="2" Grid.Column="3" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="{Binding P1_Lower}" Style="{StaticResource DataTextStyle}"/>
				</Border>
				<Border Grid.Row="2" Grid.Column="4" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="{Binding P1_LM}" Style="{StaticResource DataTextStyle}"/>
				</Border>
				<Border Grid.Row="2" Grid.Column="5" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="{Binding P1_TM}" Style="{StaticResource DataTextStyle}"/>
				</Border>
				<Border Grid.Row="2" Grid.Column="6" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="{Binding P1_BT}" Style="{StaticResource DataTextStyle}"/>
				</Border>
				<Border Grid.Row="2" Grid.Column="7" Style="{StaticResource CellBorderStyle}">
					<Rectangle Style="{StaticResource ResultBoxStyle}"/>
				</Border>

				<Border Grid.Row="3" Grid.Column="0" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="Product 2&#x0a;2nd" Style="{StaticResource DataTextStyle}"/>
				</Border>
				<Border Grid.Row="3" Grid.Column="1" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="{Binding P2_Upper}" Style="{StaticResource DataTextStyle}"/>
				</Border>
				<Border Grid.Row="3" Grid.Column="2" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="{Binding P2_Value}" Style="{StaticResource ValueTextStyle}"/>
				</Border>
				<Border Grid.Row="3" Grid.Column="3" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="{Binding P2_Lower}" Style="{StaticResource DataTextStyle}"/>
				</Border>
				<Border Grid.Row="3" Grid.Column="4" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="{Binding P2_LM}" Style="{StaticResource DataTextStyle}"/>
				</Border>
				<Border Grid.Row="3" Grid.Column="5" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="{Binding P2_TM}" Style="{StaticResource DataTextStyle}"/>
				</Border>
				<Border Grid.Row="3" Grid.Column="6" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="{Binding P2_BT}" Style="{StaticResource DataTextStyle}"/>
				</Border>
				<Border Grid.Row="3" Grid.Column="7" Style="{StaticResource CellBorderStyle}">
					<Rectangle Style="{StaticResource ResultBoxStyle}"/>
				</Border>

				<Border Grid.Row="4" Grid.Column="0" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="Product 3&#x0a;3rd" Style="{StaticResource DataTextStyle}"/>
				</Border>
				<Border Grid.Row="4" Grid.Column="1" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="{Binding P3_Upper}" Style="{StaticResource DataTextStyle}"/>
				</Border>
				<Border Grid.Row="4" Grid.Column="2" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="{Binding P3_Value}" Style="{StaticResource ValueTextStyle}"/>
				</Border>
				<Border Grid.Row="4" Grid.Column="3" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="{Binding P3_Lower}" Style="{StaticResource DataTextStyle}"/>
				</Border>
				<Border Grid.Row="4" Grid.Column="4" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="{Binding P3_LM}" Style="{StaticResource DataTextStyle}"/>
				</Border>
				<Border Grid.Row="4" Grid.Column="5" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="{Binding P3_TM}" Style="{StaticResource DataTextStyle}"/>
				</Border>
				<Border Grid.Row="4" Grid.Column="6" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="{Binding P3_BT}" Style="{StaticResource DataTextStyle}"/>
				</Border>
				<Border Grid.Row="4" Grid.Column="7" Style="{StaticResource CellBorderStyle}">
					<Rectangle Style="{StaticResource ResultBoxStyle}"/>
				</Border>

				<Border Grid.Row="5" Grid.Column="0" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="Product 4&#x0a;4th" Style="{StaticResource DataTextStyle}"/>
				</Border>
				<Border Grid.Row="5" Grid.Column="1" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="{Binding P4_Upper}" Style="{StaticResource DataTextStyle}"/>
				</Border>
				<Border Grid.Row="5" Grid.Column="2" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="{Binding P4_Value}" Style="{StaticResource ValueTextStyle}"/>
				</Border>
				<Border Grid.Row="5" Grid.Column="3" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="{Binding P4_Lower}" Style="{StaticResource DataTextStyle}"/>
				</Border>
				<Border Grid.Row="5" Grid.Column="4" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="{Binding P4_LM}" Style="{StaticResource DataTextStyle}"/>
				</Border>
				<Border Grid.Row="5" Grid.Column="5" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="{Binding P4_TM}" Style="{StaticResource DataTextStyle}"/>
				</Border>
				<Border Grid.Row="5" Grid.Column="6" Style="{StaticResource CellBorderStyle}">
					<TextBlock Text="{Binding P4_BT}" Style="{StaticResource DataTextStyle}"/>
				</Border>
				<Border Grid.Row="5" Grid.Column="7" Style="{StaticResource CellBorderStyle}">
					<Rectangle Style="{StaticResource ResultBoxStyle}"/>
				</Border>

			</Grid>
		</Border>
	</Grid>
</UserControl>