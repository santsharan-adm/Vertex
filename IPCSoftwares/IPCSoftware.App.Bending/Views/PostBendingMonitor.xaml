<UserControl x:Class="IPCSoftware.App.Bending.Views.PostBendingMonitor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="White" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <UserControl.Resources>
        <!-- Nav Button Style -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#AFAFAF"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#888" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TableBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="0.5"/>
        </Style>

        <Style x:Key="CommonTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <!-- Main Outer Grid -->
    <Grid>
        <!-- Is StackPanel se sab kuch center ho jayega -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- Top Navigation Area (Fixed Width to match table) -->
            <Grid Width="980" Margin="2">
                <Button Content="Previous" Style="{StaticResource NavButtonStyle}" HorizontalAlignment="Left" Background="#E0E0E0"/>
            </Grid>

            <!-- Main Monitor Frame (Fixed Width and Height for perfect centering) -->
            <Border BorderBrush="Black" BorderThickness="1.5" Width="980" Height="520">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 1. HEADER SECTION -->
                    <Border Grid.Row="0" BorderBrush="Black" BorderThickness="0,0,0,1" Background="#F9F9F9">
                        <Grid>
                            <TextBlock Text="POST BENDING INSPECTION MONITOR" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="Batch No. - 1234321" FontSize="14" FontWeight="Medium" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#555" Margin="3"/>
                        </Grid>
                    </Border>

                    <!-- 2. TABLE HEADERS -->
                    <Grid Grid.Row="1" Background="#EEEEEE">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="Product" FontWeight="Bold" Style="{StaticResource CommonTextStyle}"/>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="QR Code" FontWeight="Bold" Style="{StaticResource CommonTextStyle}"/>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource TableBorderStyle}"/>
                        <Border Grid.Column="3" Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="X" FontWeight="Bold" Style="{StaticResource CommonTextStyle}"/>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="Y" FontWeight="Bold" Style="{StaticResource CommonTextStyle}"/>
                        </Border>
                        <Border Grid.Column="5" Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="Z" FontWeight="Bold" Style="{StaticResource CommonTextStyle}"/>
                        </Border>
                        <Border Grid.Column="6" Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="W" FontWeight="Bold" Style="{StaticResource CommonTextStyle}"/>
                        </Border>
                        <Border Grid.Column="7" Style="{StaticResource TableBorderStyle}">
                            <TextBlock Text="Result" FontWeight="Bold" Style="{StaticResource CommonTextStyle}"/>
                        </Border>
                    </Grid>

                    <!-- 3. PRODUCTS DATA -->
                    <ItemsControl Grid.Row="2">
                        <ItemsControl.ItemsSource>
                            <x:Array Type="{x:Type sys:String}">
                                <sys:String>Product 1</sys:String>
                                <sys:String>Product 2</sys:String>
                                <sys:String>Product 3</sys:String>
                                <sys:String>Product 4</sys:String>
                            </x:Array>
                        </ItemsControl.ItemsSource>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource TableBorderStyle}">
                                        <TextBlock Text="{Binding}" Style="{StaticResource CommonTextStyle}"/>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource TableBorderStyle}">
                                        <TextBlock Text="ABCDQWER1234TYUI9087" Style="{StaticResource CommonTextStyle}" FontSize="10" TextWrapping="Wrap" Margin="2"/>
                                    </Border>

                                    <UniformGrid Grid.Column="2" Rows="3">
                                        <Border Style="{StaticResource TableBorderStyle}">
                                            <TextBlock Text="Upper Limit" FontSize="10" Style="{StaticResource CommonTextStyle}"/>
                                        </Border>
                                        <Border Style="{StaticResource TableBorderStyle}">
                                            <TextBlock Text="Present Value" FontSize="10" Style="{StaticResource CommonTextStyle}"/>
                                        </Border>
                                        <Border Style="{StaticResource TableBorderStyle}">
                                            <TextBlock Text="Lower Limit" FontSize="10" Style="{StaticResource CommonTextStyle}"/>
                                        </Border>
                                    </UniformGrid>

                                    <!-- Data Rows -->
                                    <UniformGrid Grid.Column="3" Rows="3">
                                        <Border Style="{StaticResource TableBorderStyle}">
                                            <TextBlock Text="432.223" Style="{StaticResource CommonTextStyle}"/>
                                        </Border>
                                        <Border Style="{StaticResource TableBorderStyle}">
                                            <TextBlock Text="123.333" Style="{StaticResource CommonTextStyle}"/>
                                        </Border>
                                        <Border Style="{StaticResource TableBorderStyle}">
                                            <TextBlock Text="231.675" Style="{StaticResource CommonTextStyle}"/>
                                        </Border>
                                    </UniformGrid>
                                    <UniformGrid Grid.Column="4" Rows="3">
                                        <Border Style="{StaticResource TableBorderStyle}">
                                            <TextBlock Text="432.223" Style="{StaticResource CommonTextStyle}"/>
                                        </Border>
                                        <Border Style="{StaticResource TableBorderStyle}">
                                            <TextBlock Text="123.333" Style="{StaticResource CommonTextStyle}"/>
                                        </Border>
                                        <Border Style="{StaticResource TableBorderStyle}">
                                            <TextBlock Text="231.675" Style="{StaticResource CommonTextStyle}"/>
                                        </Border>
                                    </UniformGrid>
                                    <UniformGrid Grid.Column="5" Rows="3">
                                        <Border Style="{StaticResource TableBorderStyle}">
                                            <TextBlock Text="432.223" Style="{StaticResource CommonTextStyle}"/>
                                        </Border>
                                        <Border Style="{StaticResource TableBorderStyle}">
                                            <TextBlock Text="123.333" Style="{StaticResource CommonTextStyle}"/>
                                        </Border>
                                        <Border Style="{StaticResource TableBorderStyle}">
                                            <TextBlock Text="231.675" Style="{StaticResource CommonTextStyle}"/>
                                        </Border>
                                    </UniformGrid>
                                    <UniformGrid Grid.Column="6" Rows="3">
                                        <Border Style="{StaticResource TableBorderStyle}">
                                            <TextBlock Text="432.223" Style="{StaticResource CommonTextStyle}"/>
                                        </Border>
                                        <Border Style="{StaticResource TableBorderStyle}">
                                            <TextBlock Text="123.333" Style="{StaticResource CommonTextStyle}"/>
                                        </Border>
                                        <Border Style="{StaticResource TableBorderStyle}">
                                            <TextBlock Text="231.675" Style="{StaticResource CommonTextStyle}"/>
                                        </Border>
                                    </UniformGrid>

                                    <Border Grid.Column="7" Style="{StaticResource TableBorderStyle}">
                                        <Rectangle Width="35" Height="30" Fill="#D3D3D3" RadiusX="2" RadiusY="2" Stroke="#999" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>