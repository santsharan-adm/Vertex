<UserControl x:Class="IPCSoftware.App.Bending.Views.BendingDash"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cc="clr-namespace:IPCSoftware.App.Bending.Controls"
        Background="#0a1628">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IPCSoftware.App.Bending;component/Resources/BendingRD2.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Storyboard triggered on each RobotPickDone signal -->
            <Storyboard x:Key="TriggerAnimation">
                <!-- TT1 rotates 90° CW -->
                <DoubleAnimation Storyboard.TargetName="FifoTT1Rotate" Storyboard.TargetProperty="Angle"
                                 By="90" Duration="0:0:0.8"/>
                <!-- Transfer Module rotates 180° CW -->
                <DoubleAnimation Storyboard.TargetName="FifoTransferRotate" Storyboard.TargetProperty="Angle"
                                 By="180" Duration="0:0:0.8"/>
                <!-- TT2 rotates 120° CW -->
                <DoubleAnimation Storyboard.TargetName="FifoTT2Rotate" Storyboard.TargetProperty="Angle"
                                 By="120" Duration="0:0:0.8"/>
                <!-- Robot 1 arm: Input Tray → TT1 and back -->
                <DoubleAnimation Storyboard.TargetName="FifoArm1Lower" Storyboard.TargetProperty="Y2"
                                 From="415" To="200" Duration="0:0:0.8" AutoReverse="True"/>
                <!-- Robot 2 arm: TT2 → Output Tray and back -->
                <DoubleAnimation Storyboard.TargetName="FifoArm2Lower" Storyboard.TargetProperty="Y2"
                                 From="415" To="200" Duration="0:0:0.8" AutoReverse="True"/>
            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>



        <!-- LEFT TABLE -->
        <Border Grid.Row="1" Grid.Column="0" Grid.RowSpan="2" Background="#0f1e3a" CornerRadius="5" Padding="5" Margin="0,0,10,0">
            <StackPanel>
                <TextBlock Text="Batch Queue Table" Foreground="#00d4ff" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                <DataGrid ItemsSource="{Binding LeftTableRows}" AutoGenerateColumns="False" 
                          HeadersVisibility="Column" IsReadOnly="True" Background="Transparent"
                          RowBackground="#1a2a44" AlternatingRowBackground="#0f1e3a"
                          BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1a3a5c"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                          MaxHeight="180" VerticalScrollBarVisibility="Visible">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1a3055"/>
                            <Setter Property="Foreground" Value="#88bbff"/>
                            <Setter Property="Padding" Value="5,3"/>
                            <Setter Property="FontSize" Value="10"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="3"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Batch" Binding="{Binding BatchNo}" Width="70"/>
                        <DataGridTextColumn Header="QR" Binding="{Binding QrCode}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- EFFICIENCY BREAKDOWN -->
                <Border Background="#1E293B" CornerRadius="8" Padding="6" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="EFFICIENCY BREAKDOWN" Foreground="White" FontWeight="Bold" FontSize="9" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="18"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Text="Availability" Foreground="White" FontSize="8" FontWeight="Bold"/>
                            <Border Grid.Row="0" Grid.Column="1" Background="#334155" CornerRadius="3" Height="10" Margin="2"/>
                            <TextBlock Grid.Row="1" Text="Performance" Foreground="White" FontSize="8" FontWeight="Bold"/>
                            <Border Grid.Row="1" Grid.Column="1" Background="#334155" CornerRadius="3" Height="10" Margin="2"/>
                            <TextBlock Grid.Row="2" Text="Quality" Foreground="White" FontSize="8" FontWeight="Bold"/>
                            <Border Grid.Row="2" Grid.Column="1" Background="#334155" CornerRadius="3" Height="10" Margin="2"/>
                            <TextBlock Grid.Row="3" Text="OEE Details" Foreground="White" FontSize="8" FontWeight="Bold"/>
                            <Border Grid.Row="3" Grid.Column="1" Background="#334155" CornerRadius="3" Height="10" Margin="2"/>
                            <TextBlock Grid.Row="4" Text="Operating Time" Foreground="White" FontSize="8" FontWeight="Bold"/>
                            <Border Grid.Row="4" Grid.Column="1" Background="#334155" CornerRadius="3" Height="10" Margin="2"/>
                            <TextBlock Grid.Row="5" Text="Downtime" Foreground="White" FontSize="8" FontWeight="Bold"/>
                            <Border Grid.Row="5" Grid.Column="1" Background="#334155" CornerRadius="3" Height="10" Margin="2"/>
                            <TextBlock Grid.Row="6" Text="Cycle Time" Foreground="White" FontSize="8" FontWeight="Bold"/>
                            <Border Grid.Row="6" Grid.Column="1" Background="#334155" CornerRadius="3" Height="10" Margin="2"/>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#1B4332" CornerRadius="3" Padding="4,2" Margin="0,0,2,0">
                                <Ellipse Width="7" Height="7" Fill="#22C55E" HorizontalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="1" Background="#450A0A" CornerRadius="3" Padding="4,2" Margin="2,0,0,0">
                                <Ellipse Width="7" Height="7" Fill="#EF4444" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CONTROLS -->
                <Border Background="#1565C0" CornerRadius="8,8,0,0" Padding="5,3" Margin="0,8,0,0">
                    <TextBlock Text="CONTROLS" Foreground="White" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"/>
                </Border>
                <Border Background="#0B1A2E" BorderBrush="#1565C0" BorderThickness="1,0,1,1" CornerRadius="0,0,8,8" Padding="3">
                    <StackPanel>
                        <Button Content="AUTO RUN" Background="#4285F4" Foreground="White" FontWeight="Bold" FontSize="9" Padding="5,4" Margin="0,2" BorderThickness="0"/>
                        <Button Content="DRY RUN" Background="#6B7280" Foreground="White" FontWeight="Bold" FontSize="9" Padding="5,4" Margin="0,2" BorderThickness="0"/>
                        <Button Content="CYCLE START/STOP" Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="9" Padding="5,4" Margin="0,2" BorderThickness="0"/>
                        <Button Content="WORK PAYOUT START" Background="#7C3AED" Foreground="White" FontWeight="Bold" FontSize="9" Padding="5,4" Margin="0,2" BorderThickness="0"/>
                        <Button Content="Go To Menu" Background="#6B7280" Foreground="White" FontWeight="Bold" FontSize="9" Padding="5,4" Margin="0,2" BorderThickness="0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>

        <!-- TOP TABLE -->
        <Border Grid.Row="1" Grid.Column="1" Background="#0f1e3a" CornerRadius="5" Padding="5">
            <StackPanel>
                <TextBlock Text="Bending Monitor Table" Foreground="#00d4ff" FontSize="13" FontWeight="Bold" Margin="0,0,0,5"/>
                <DataGrid ItemsSource="{Binding TopTableRows}" AutoGenerateColumns="False"
                          HeadersVisibility="Column" IsReadOnly="True" Background="Transparent"
                          RowBackground="#1a2a44" AlternatingRowBackground="#0f1e3a"
                          BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1a3a5c"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                          MaxHeight="180" VerticalScrollBarVisibility="Visible">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1a3055"/>
                            <Setter Property="Foreground" Value="#88bbff"/>
                            <Setter Property="Padding" Value="5,3"/>
                            <Setter Property="FontSize" Value="10"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="50"/>
                        <DataGridTextColumn Header="Batch" Binding="{Binding BatchNo}" Width="80"/>
                        <DataGridTextColumn Header="QR" Binding="{Binding QrCode}" Width="80"/>
                        <DataGridTextColumn Header="B1 Temp" Binding="{Binding B1Temp}" Width="*"/>
                        <DataGridTextColumn Header="B2 Temp" Binding="{Binding B2Temp}" Width="*"/>
                        <DataGridTextColumn Header="B3 Temp" Binding="{Binding B3Temp}" Width="*"/>
                        <DataGridTextColumn Header="Load B1" Binding="{Binding LoadB1}" Width="*"/>
                        <DataGridTextColumn Header="Load B2" Binding="{Binding LoadB2}" Width="*"/>
                        <DataGridTextColumn Header="Load B3" Binding="{Binding LoadB3}" Width="*"/>
                        <DataGridTextColumn Header="X" Binding="{Binding X}" Width="60"/>
                        <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="60"/>
                        <DataGridTextColumn Header="Z" Binding="{Binding Z}" Width="60"/>
                        <DataGridTextColumn Header="W" Binding="{Binding W}" Width="60"/>
                        <DataGridTextColumn Header="Tear" Binding="{Binding TearStatus}" Width="50"/>
                        <DataGridTextColumn Header="Flip" Binding="{Binding FlipStatus}" Width="50"/>
                        <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- Status -->
        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding StatusText}" 
                   Foreground="#4eff4e" FontSize="11" Margin="0,10,0,0"/>

        <!-- Robot & Inspection Layout (Machine Diagram from Dashboard2) -->
        <Border Grid.Row="2" Grid.Column="1" Background="#0f1e3a" CornerRadius="5" Padding="5" Margin="0,10,0,0">
            <Viewbox Stretch="Uniform" Margin="5,0,-5,0">
                <Canvas Width="1000" Height="450">

                    <!-- Arm 1 upper segment: Robot 1 right edge → elbow (fixed) -->
                    <Line X1="68" Y1="307" X2="108" Y2="307"
                          Stroke="{StaticResource PanelBorder}" StrokeThickness="8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Canvas.Left="152" Canvas.Top="54"/>
                    <!-- Arm 1 lower segment: elbow → tip (animated) -->
                    <Line x:Name="FifoArm1Lower"
                          X1="108" Y1="307" X2="197" Y2="350"
                          Stroke="{StaticResource PanelBorder}" StrokeThickness="8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Canvas.Left="165" Canvas.Top="58"/>
                    <!-- Arm 1 elbow joint circle -->
                    <Ellipse Width="18" Height="18" Fill="{StaticResource PanelBorder}"
                             Canvas.Left="257" Canvas.Top="354"/>

                    <!-- Arm 2 upper segment: Robot 2 left edge → elbow (fixed) -->
                    <Line X1="810" Y1="307" X2="770" Y2="307"
                          Stroke="{StaticResource PanelBorder}" StrokeThickness="8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Canvas.Left="94" Canvas.Top="58"/>
                    <!-- Arm 2 lower segment: elbow → tip (animated) -->
                    <Line x:Name="FifoArm2Lower"
                          X1="770" Y1="307" X2="689" Y2="350"
                          Stroke="{StaticResource PanelBorder}" StrokeThickness="8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Canvas.Left="83" Canvas.Top="61"/>
                    <!-- Arm 2 elbow joint circle -->
                    <Ellipse Width="18" Height="18" Fill="{StaticResource PanelBorder}"
                             Canvas.Left="847" Canvas.Top="354"/>

                    <!-- Transfer Module (Dashboard2 style with circle and connectors) -->
                    <TextBlock Canvas.Left="520" Canvas.Top="60" Text="TRANSFER MODULE" FontWeight="Bold" FontSize="10" Foreground="{StaticResource PanelBorder}"/>
                    <!-- Orange connector blocks (left side) -->
                    <Border Canvas.Left="470" Canvas.Top="95" 
                            BorderBrush="Black" BorderThickness="2" Padding="1" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <Rectangle Width="12" Height="12" Fill="#F59E0B" RadiusX="1" RadiusY="1"/>
                            <Rectangle Height="1"/>
                            <Rectangle Width="12" Height="12" Fill="#F59E0B" RadiusX="1" RadiusY="1"/>
                            <Rectangle Height="1"/>
                            <Rectangle Width="12" Height="12" Fill="#F59E0B" RadiusX="1" RadiusY="1"/>
                            <Rectangle Height="1"/>
                            <Rectangle Width="12" Height="12" Fill="#F59E0B" RadiusX="1" RadiusY="1"/>
                        </StackPanel>
                    </Border>
                    <!-- Orange connector blocks (horizontal) -->
                    <Rectangle Canvas.Left="506" Canvas.Top="118" Width="12" Height="12" Fill="#F59E0B" RadiusX="1" RadiusY="1" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <Rectangle Canvas.Left="489" Canvas.Top="118" Width="12" Height="12" Fill="#F59E0B" RadiusX="1" RadiusY="1"/>
                    <!-- Circle with rotating icon -->
                    <Border Canvas.Left="520" Canvas.Top="88" Width="70" Height="70" CornerRadius="35"
                            Background="White" BorderBrush="{StaticResource PanelBorder}" BorderThickness="2.5"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <RotateTransform x:Name="FifoTransferRotate" Angle="0"/>
                        </Border.RenderTransform>
                        <Border BorderBrush="#F59E0B" BorderThickness="2" CornerRadius="4" Margin="8" Padding="3">
                            <Border BorderBrush="#F59E0B" BorderThickness="2" CornerRadius="3" Padding="2">
                                <TextBlock Text="⟳" FontSize="16" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                    </Border>

                    <!-- BEND / CLAMP / PUNCH / HEAT panel with 4x3 indicator dots per bend -->
                    <Border Canvas.Left="10" Canvas.Top="10" BorderBrush="{StaticResource PanelBorder}" BorderThickness="2" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Labels -->
                            <Border Grid.Column="0" Background="{StaticResource PanelBorder}" Padding="4,2">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="15"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="BEND" Foreground="White" FontWeight="Bold" FontSize="10"/>
                                    <TextBlock Grid.Row="1" Text="CLAMP" Foreground="White" FontSize="8" Margin="0,1,0,0" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="2" Text="PUNCH" Foreground="White" FontSize="8" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="3" Text="HEAT" Foreground="White" FontSize="8" FontWeight="Bold"/>
                                </Grid>
                            </Border>
                            <!-- BEND 1: 4 dots per row (4 parts × 3 operations) -->
                            <Border Grid.Column="1" Background="#0F172A" Padding="4,2" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="15"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="BEND 1" Foreground="White" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center"/>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- BEND 2: 4 dots per row -->
                            <Border Grid.Column="2" Background="#0F172A" Padding="4,2" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="15"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="BEND 2" Foreground="White" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center"/>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- BEND 3: 4 dots per row -->
                            <Border Grid.Column="3" Background="#0F172A" Padding="4,2" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="15"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="BEND 3" Foreground="White" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center"/>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                        <Ellipse Width="9" Height="9" Fill="Gray" Margin="2,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- TURN TABLE 1 label -->
                    <TextBlock Canvas.Left="364" Canvas.Top="230" Text="TURN TABLE 1" FontWeight="Bold" FontSize="15" Foreground="{StaticResource PanelBorder}"/>
                    <!-- TURN TABLE 1 circle with blue dots -->
                    <Border Canvas.Left="269" Canvas.Top="50" Width="160" Height="160"
                            CornerRadius="80"
                            Background="White"
                            BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="3.5">
                        <Grid RenderTransformOrigin="0.5,0.5" Margin="2">
                            <Grid.RenderTransform>
                                <RotateTransform x:Name="FifoTT1Rotate" Angle="0"/>
                            </Grid.RenderTransform>
                            <!-- Top row -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                            </StackPanel>
                            <!-- Bottom row -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,129,0,0">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                            </StackPanel>
                            <!-- Left column -->
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                            </StackPanel>
                            <!-- Right column -->
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="129,0,0,0">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="2"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- TURN TABLE 2 (smaller triangle, 4 dots per side, rotates at centroid) -->
                    <TextBlock Canvas.Left="690" Canvas.Top="195" Text="TURN TABLE 2" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PanelBorder}"/>
                    <Grid Canvas.Left="670" Canvas.Top="75" Width="130" Height="120"
                          RenderTransformOrigin="0.5,0.6">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="FifoTT2Rotate" Angle="0"/>
                        </Grid.RenderTransform>
                        <Polygon Points="65,5 125,110 5,110"
                                 Stroke="{StaticResource PanelBorder}" StrokeThickness="2.5" Fill="White" Margin="-23,-10,23,10" RenderTransformOrigin="0.264,0.451"/>
                        <Canvas Margin="-23,-10,23,10">
                            <!-- Left side: 4 dots -->
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBlue}" Canvas.Left="22" Canvas.Top="82"/>
