<UserControl x:Class="IPCSoftware.App.Views.ServoCalibrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:IPCSoftware.App.ViewModels"
             xmlns:helpers="clr-namespace:IPCSoftware.App.Helpers"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors" 
             helpers:ViewModelLocator.AutoWireViewModel="{x:Type vm:ServoCalibrationViewModel}"
             helpers:DisposeBehavior.AutoDispose="True"
             Background="#F3F3F3">

    <UserControl.Resources>
        <!-- SCALED UP HMI Styles (Kept Large) -->
        <Style x:Key="HmiColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="80"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="HmiCellStyle" TargetType="DataGridCell">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CCE8FF"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="30,15"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border Name="Border" Background="#E0E0E0" BorderBrush="#CCC" BorderThickness="1,1,1,0" CornerRadius="10,10,0,0" Margin="0,0,5,0">
                                <ContentPresenter x:Name="ContentSite"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  ContentSource="Header"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1E4FA8"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#DDD"/>
                                <Setter Property="Foreground" Value="#555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- JOG BUTTON STYLE -->
        <Style x:Key="JogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="80"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="12" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95" CenterX="100" CenterY="40"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- NEW: ComboBox Style for Program Number -->
        <Style x:Key="ProgramComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#1E4FA8"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- AE LIMIT STYLES (from AeLimitView.xaml) -->
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="CardBorder" Color="#E2E6EF" />

        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Height" Value="60" />
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5F5" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="50" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="#22C55E" />
            <Setter Property="BorderBrush" Value="#22C55E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#16A34A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0F8A3C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Height" Value="50" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#007ACC" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Foreground" Value="#007ACC" />
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E3F2FD" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#BBDEFB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MatrixHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <Style x:Key="MatrixRowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MatrixLiveValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#007ACC"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MatrixUnit" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>

        <Style x:Key="RowBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Padding" Value="5,30"/>
            <Setter Property="Margin" Value="0,0,0,30"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40">
        <TabControl Background="Transparent" helpers:BlockTabChangeBehavior.BlockWhen="{Binding HasUnsavedChanges}" BorderThickness="0">   

            <!-- TAB 1: SETUP & LIVE DATA -->
            <TabItem Header="Servo Params">
                <Grid Margin="0,30,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Servo Parameters" FontSize="36" FontWeight="Bold" Foreground="#333"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: X Axis Config -->
                        <Border Grid.Column="0" Background="White" CornerRadius="15" BorderBrush="#CCC" BorderThickness="1" Padding="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="X-Axis Parameters" FontSize="32" FontWeight="SemiBold" Margin="15" Foreground="#1E4FA8"/>

                                <DataGrid Grid.Row="1" ItemsSource="{Binding XParameters}" 
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeight="80" 
                                          ColumnHeaderStyle="{StaticResource HmiColumnHeaderStyle}" CellStyle="{StaticResource HmiCellStyle}"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE" BorderThickness="0" Background="White">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Parameter" Binding="{Binding Name}" Width="250" FontWeight="SemiBold"/>
                                        <DataGridTextColumn Header="Val" Binding="{Binding CurrentValue}" Width="100" Foreground="#007ACC"/>
                                        <DataGridTemplateColumn Header="Set New" Width="150">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}" 
                                                             FontSize="26" FontWeight="Bold" Width="120" Height="50"
                                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                                             Padding="5" BorderBrush="#999" BorderThickness="1"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header=" " Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="SET" Command="{Binding DataContext.WriteParamCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Background="#E67E22" Foreground="White" FontSize="18" FontWeight="Bold"
                                                            Height="50" Width="90" Cursor="Hand"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- RIGHT: Y Axis Config -->
                        <Border Grid.Column="2" Background="White" CornerRadius="15" BorderBrush="#CCC" BorderThickness="1" Padding="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Y-Axis Parameters" FontSize="32" FontWeight="SemiBold" Margin="15" Foreground="#1E4FA8"/>

                                <DataGrid Grid.Row="1" ItemsSource="{Binding YParameters}" 
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeight="80" 
                                          ColumnHeaderStyle="{StaticResource HmiColumnHeaderStyle}" CellStyle="{StaticResource HmiCellStyle}"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE" BorderThickness="0" Background="White">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Parameter" Binding="{Binding Name}" Width="250" FontWeight="SemiBold"/>
                                        <DataGridTextColumn Header="Val" Binding="{Binding CurrentValue}" Width="100" Foreground="#007ACC"/>
                                        <DataGridTemplateColumn Header="Set New" Width="150">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}" 
                                                             FontSize="26" FontWeight="Bold" Width="120" Height="50"
                                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                                             Padding="5" BorderBrush="#999" BorderThickness="1"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header=" " Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="SET" Command="{Binding DataContext.WriteParamCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Background="#E67E22" Foreground="White" FontSize="18" FontWeight="Bold"
                                                            Height="50" Width="90" Cursor="Hand"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Button Grid.Row="2" Content="SAVE" Width=" 400" HorizontalAlignment="Center" Command="{Binding ConfirmXParamsCommand}"
                            Background="#007ACC" Foreground="White" FontSize="24" FontWeight="Bold"
                            Height="70" Margin="15" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </TabItem>

            <!-- TAB 2: TEACH POSITIONS -->
            <TabItem Header="Set Coords">
                <Grid Margin="0,30,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Section: Position Teaching + Program Number Controls -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">

                            <!-- Program Number Controls -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="PRODUCT CODE:" FontSize="24" FontWeight="SemiBold" Foreground="#555" VerticalAlignment="Center" Margin="0,0,15,0"/>


                                <!-- ComboBox for Existing Programs -->
                                <ComboBox ItemsSource="{Binding AvailableProgramCode}"
                                          SelectedItem="{Binding SelectedProgramCode, Mode=TwoWay}"
                                          Width="150"
                                          Height="60"
                                          FontSize="24"
                                          FontWeight="Bold"
                                          Margin="0,0,15,0"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          Background="White"
                                          BorderBrush="#1E4FA8"
                                          BorderThickness="2">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                            <i:InvokeCommandAction Command="{Binding SelectionChangedCommand}"/>
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </ComboBox>



                                <!-- Current Running Program TextBox -->
                                <Border Background="#28A745" 
                                    CornerRadius="12" 
                                    Padding="10,10" 
                                    Margin="10,0,0,0"
                                    Height="60" 
                                    Width="Auto" 
                                    HorizontalAlignment="Right">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.1"/>
                                    </Border.Effect>

                                    <!-- Changed from StackPanel (vertical) to Horizontal StackPanel -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="RUNNING PRODUCT : " 
                                       Foreground="White" 
                                       FontSize="22" 
                                       FontWeight="Bold" 
                                       VerticalAlignment="Center"
                                       Margin="0,0,0,0"/>
                                        <TextBox Text="{Binding CurrentRunningProgram, Mode=OneWay}" 
                                         Foreground="White" 
                                         FontSize="22" 
                                         FontWeight="Bold" 
                                         VerticalAlignment="Center"
                                         IsReadOnly="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         TextAlignment="Center"
                                         MinWidth="0"/>
                                    </StackPanel>
                                </Border>


                            </StackPanel>
                            <TextBlock Text="Position Teaching" FontSize="36" FontWeight="Bold" Foreground="#333" Margin="0,50,0,0"/>

                        </StackPanel>

                        <!-- Right Section: Current Running Program + Live Values -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">

                            <!-- Live Value Card -->
                            <Border Background="#1E4FA8" CornerRadius="20" Padding="15,15" MinWidth="400" MaxHeight="120" Margin="0,0,0,40"> 
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="30" Opacity="0.3"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <StackPanel Margin="0,0,60,0">
                                        <TextBlock Text="LIVE X" Foreground="#CCC" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding LiveX, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}" Foreground="White" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Width="2" Background="#FFFFFF" Opacity="0.3" Margin="0,10"/>
                                    <StackPanel Margin="60,0,0,0">
                                        <TextBlock Text="LIVE Y" Foreground="#CCC" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding LiveY, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}" Foreground="White" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Position List -->
                    <Border Grid.Row="1" Background="White" CornerRadius="15" BorderBrush="#CCC" BorderThickness="1">
                        <DataGrid ItemsSource="{Binding Positions}" 
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" RowHeight="90" 
                                  ColumnHeaderStyle="{StaticResource HmiColumnHeaderStyle}" CellStyle="{StaticResource HmiCellStyle}"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE" VerticalGridLinesBrush="Transparent"
                                  BorderThickness="0" Background="White" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding PositionId}" Width="150" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Position Name" Binding="{Binding Name}" Width="300"/>

                                <DataGridTemplateColumn Header="Sequence" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding}">
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl">
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <ComboBox ItemsSource="{Binding DataContext.AvailableSequences, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                              SelectedItem="{Binding SequenceIndex, UpdateSourceTrigger=PropertyChanged}"
                                                                              FontSize="24" FontWeight="Bold" 
                                                                              Height="60" Width="100"
                                                                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PositionId}" Value="0">
                                                                <Setter Property="ContentTemplate">
                                                                    <Setter.Value>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="0" FontSize="24" FontWeight="Bold" Foreground="#666" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </DataTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Saved X" Width="300">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding X, StringFormat=F2, UpdateSourceTrigger=LostFocus}" 
                                                     FontSize="26" FontWeight="Bold" Foreground="#28A745"
                                                     VerticalContentAlignment="Center" Padding="5" 
                                                     BorderBrush="Transparent" Background="Transparent"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- EDITABLE Y Coordinate -->
                                <DataGridTemplateColumn Header="Saved Y" Width="300">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Y, StringFormat=F2, UpdateSourceTrigger=LostFocus}" 
                                                     FontSize="26" FontWeight="Bold" Foreground="#28A745"
                                                     VerticalContentAlignment="Center" Padding="5" 
                                                     BorderBrush="Transparent" Background="Transparent"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Action" Width="450">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                                <!-- TEACH BUTTON (Captures Live) -->
                                                <Button Command="{Binding DataContext.TeachCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="#007ACC" Foreground="White" 
                                                        Height="50" Width="150" Cursor="Hand" Margin="0,0,10,0"
                                                        ToolTip="Capture current Live Position">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                                <Viewbox Margin="5">
                                                                    <TextBlock Text="TEACH" FontWeight="Bold"/>
                                                                </Viewbox>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter Property="Opacity" Value="0.8"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <!-- WRITE BUTTON (Manual Entry) --><!--
                                                <Button Command="{Binding DataContext.WritePositionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="#E67E22" Foreground="White" 
                                                        Height="50" Width="150" Cursor="Hand"
                                                        ToolTip="Write manually typed value to PLC">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                                <Viewbox Margin="5">
                                                                    <TextBlock Text="WRITE" FontWeight="Bold"/>
                                                                </Viewbox>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter Property="Opacity" Value="0.8"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>-->

                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Footer: Jog Buttons & Save -->
                    <Grid Grid.Row="2"  Margin="0,30,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- HOME POS BUTTON -->
                        <Button Content="X-Y ORIGIN" Grid.Column="0" HorizontalAlignment="Left" Margin="0,0,20,0"
                                Command="{Binding ConfirmYCoordsCommand}" Width="300"
                                Height="80" FontSize="24" FontWeight="Bold"
                                Background="#1E4FA8" Foreground="White" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Opacity" Value="0.8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal" >
                            <!-- JOG BUTTONS (Standard Events) -->

                            <!-- X JOG - -->
                            <Button Content="X JOG -" HorizontalAlignment="Right" 
                                    Style="{StaticResource JogButtonStyle}" Background="#007ACC">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                        <i:InvokeCommandAction Command="{Binding JogCommand}" CommandParameter="XMinus|True"/>
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="PreviewMouseLeftButtonUp">
                                        <i:InvokeCommandAction Command="{Binding JogCommand}" CommandParameter="XMinus|False"/>
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="LostMouseCapture">
                                        <i:InvokeCommandAction Command="{Binding JogCommand}" CommandParameter="XMinus|False"/>
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="PreviewTouchDown">
                                        <i:InvokeCommandAction Command="{Binding JogCommand}" CommandParameter="XMinus|True"/>
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="LostTouchCapture">
                                        <i:InvokeCommandAction Command="{Binding JogCommand}" CommandParameter="XMinus|False"/>
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="PreviewTouchUp">
                                        <i:InvokeCommandAction Command="{Binding JogCommand}" CommandParameter="XMinus|False"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </Button>

                            <!-- X JOG + -->
                            <Button Content="X JOG +" HorizontalAlignment="Right" Style="{StaticResource JogButtonStyle}" Background="#007ACC">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                        <i:InvokeCommandAction Command="{Binding JogCommand}" CommandParameter="XPlus|True"/>
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="PreviewMouseLeftButtonUp">
                                        <i:InvokeCommandAction Command="{Binding JogCommand}" CommandParameter="XPlus|False"/>
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="LostMouseCapture">
                                        <i:InvokeCommandAction Command="{Binding JogCommand}" CommandParameter="XPlus|False"/>
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="PreviewTouchDown">
                                        <i:InvokeCommandAction Command="{Binding JogCommand}" CommandParameter="XPlus|True"/>
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="LostTouchCapture">
                                        <i:InvokeCommandAction Command="{Binding JogCommand}" CommandParameter="XPlus|False"/>
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="PreviewTouchUp">
                                        <i:InvokeCommandAction Command="{Binding JogCommand}" CommandParameter="XPlus|False"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </Button>

                            <!-- Y JOG - -->
                            <Button Content="Y JOG -" HorizontalAlignment="Right" Style="{StaticResource JogButtonStyle}" Background="#007ACC">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                        <i:InvokeCommandAction Command="{Binding JogCommand}" CommandParameter="YMinus|True"/>
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="PreviewMouseLeftButtonUp">
                                        <i:InvokeCommandAction Command="{Binding JogCommand}" CommandParameter="YMinus|False"/>
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="LostMouseCapture">
                                        <i:InvokeCommandAction Command="{Binding JogCommand}" CommandParameter="YMinus|False"/>
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="PreviewTouchDown">
                                        <i:InvokeCommandAction Command="{Binding JogCommand}" CommandParameter="YMinus|True"/>
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="LostTouchCapture">
                                        <i:InvokeCommandAction Command="{Binding JogCommand}" CommandParameter="YMinus|False"/>
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="PreviewTouchUp">
                                        <i:InvokeCommandAction Command="{Binding JogCommand}" CommandParameter="YMinus|False"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </Button>

                            <!-- Y JOG + -->
                            <Button Content="Y JOG +" HorizontalAlignment="Right" Style="{StaticResource JogButtonStyle}" Background="#007ACC">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                        <i:InvokeCommandAction Command="{Binding JogCommand}" CommandParameter="YPlus|True"/>
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="PreviewMouseLeftButtonUp">
                                        <i:InvokeCommandAction Command="{Binding JogCommand}" CommandParameter="YPlus|False"/>
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="LostMouseCapture">
                                        <i:InvokeCommandAction Command="{Binding JogCommand}" CommandParameter="YPlus|False"/>
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="PreviewTouchDown">
                                        <i:InvokeCommandAction Command="{Binding JogCommand}" CommandParameter="YPlus|True"/>
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="LostTouchCapture">
                                        <i:InvokeCommandAction Command="{Binding JogCommand}" CommandParameter="YPlus|False"/>
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="PreviewTouchUp">
                                        <i:InvokeCommandAction Command="{Binding JogCommand}" CommandParameter="YPlus|False"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </Button>
                        </StackPanel>

                        <!-- SAVE (Confirm X Coord) -->
                        <Button Content="SAVE" Grid.Column="2" HorizontalAlignment="Right"
                                Command="{Binding ConfirmXCoordsCommand}"
                                Width="300" Height="80" FontSize="24" FontWeight="Bold"
                                Background="#1E4FA8" Foreground="White" Cursor="Hand" Margin="0,0,20,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Opacity" Value="0.8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 3: AE LIMITS (Content copied from AeLimitView.xaml) -->
            <TabItem Header="AE Limits">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Background="#F3F4F6" Margin="40">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Page Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="AE Limit Configuration" FontSize="38" Foreground="#1F2937" FontWeight="Bold" />
                            <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                                <!-- Current Running Program TextBox -->
                                <Border Background="#28A745" 
                                    CornerRadius="12" 
                                    Padding="10,10" 
                                    Margin="10,0,100,0"
                                    Height="60" 
                                    Width="Auto" 
                                    HorizontalAlignment="Center">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.1"/>
                                    </Border.Effect>

                                    <!-- Changed from StackPanel (vertical) to Horizontal StackPanel -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="RUNNING PRODUCT : " 
                                       Foreground="White" 
                                       FontSize="22" 
                                       FontWeight="Bold" 
                                       VerticalAlignment="Center"
                                       Margin="0,0,0,0"/>
                                        <TextBox Text="{Binding CurrentRunningProgram, Mode=OneWay}" 
                                         Foreground="White" 
                                         FontSize="22" 
                                         FontWeight="Bold" 
                                         VerticalAlignment="Center"
                                         IsReadOnly="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         TextAlignment="Center"
                                         MinWidth="0"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="PRODUCT CODE:" FontSize="24" FontWeight="SemiBold" Foreground="#555" VerticalAlignment="Center" Margin="0,0,45,0"/>
                                <!-- ComboBox for Existing Programs -->
                                <ComboBox ItemsSource="{Binding AvailableProgramCode}"
                                          SelectedItem="{Binding SelectedProgramCode, Mode=TwoWay}"
                                          Width="250"
                                          Height="60"
                                          FontSize="24"
                                          FontWeight="Bold"
                                          Margin="0,0,15,0"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          Background="White"
                                          BorderBrush="#1E4FA8"
                                          BorderThickness="2">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                            <i:InvokeCommandAction Command="{Binding SelectionChangedCommand}"/>
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </ComboBox>
                                <!--<Button Content="Refresh" Command="{Binding AeLimitRefreshCommand}" Style="{StaticResource OutlineButton}" Width="150" Margin="0,0,10,0" />-->
                                <Button Content="Save" Command="{Binding AeLimitSaveCommand}" Style="{StaticResource PrimaryButton}" Width="200" />
                            </StackPanel>
                        </Grid>

                        <!-- Limit Matrix Card -->
                        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="60" VerticalAlignment="Top">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="0.5*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Headers -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Measurement" Style="{StaticResource MatrixHeader}" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Min (Live)" Style="{StaticResource MatrixHeader}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="New Min" Style="{StaticResource MatrixHeader}" />
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="Max (Live)" Style="{StaticResource MatrixHeader}" />
                                <TextBlock Grid.Row="0" Grid.Column="5" Text="New Max" Style="{StaticResource MatrixHeader}" />

                                <Border Grid.Row="1" Grid.ColumnSpan="7" BorderBrush="#333" BorderThickness="0,0,0,3" Margin="0,0,0,40"/>

                                <!-- Row 1: X Direction -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Inspection X" Style="{StaticResource MatrixRowLabel}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AeMinX.CurrentValue, StringFormat={}{0:+0.000;-0.000;0.000}}" Style="{StaticResource MatrixLiveValue}"/>
                                <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding AeMinX.NewValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}"/>
                                <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding AeMaxX.CurrentValue, StringFormat={}{0:+0.000;-0.000;0.000}}" Style="{StaticResource MatrixLiveValue}"/>
                                <TextBox Grid.Row="2" Grid.Column="5" Text="{Binding AeMaxX.NewValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}"/>
                                <TextBox Grid.Row="2" Grid.Column="6" Text="{Binding AeUnitX, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" FontWeight="Normal" Foreground="#666"/>

                                <!-- Row 2: Y Direction -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Inspection Y" Style="{StaticResource MatrixRowLabel}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AeMinY.CurrentValue, StringFormat={}{0:+0.000;-0.000;0.000}}" Style="{StaticResource MatrixLiveValue}"/>
                                <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding AeMinY.NewValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}"/>
                                <TextBlock Grid.Row="3" Grid.Column="4" Text="{Binding AeMaxY.CurrentValue, StringFormat={}{0:+0.000;-0.000;0.000}}" Style="{StaticResource MatrixLiveValue}"/>
                                <TextBox Grid.Row="3" Grid.Column="5" Text="{Binding AeMaxY.NewValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}"/>
                                <TextBox Grid.Row="3" Grid.Column="6" Text="{Binding AeUnitY, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" FontWeight="Normal" Foreground="#666"/>

                                <!-- Row 3: Angle/Z -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Inspection Angle" Style="{StaticResource MatrixRowLabel}"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding AeMinZ.CurrentValue, StringFormat={}{0:+0.000;-0.000;0.000}}" Style="{StaticResource MatrixLiveValue}"/>
                                <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding AeMinZ.NewValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}"/>
                                <TextBlock Grid.Row="4" Grid.Column="4" Text="{Binding AeMaxZ.CurrentValue, StringFormat={}{0:+0.000;-0.000;0.000}}" Style="{StaticResource MatrixLiveValue}"/>
                                <TextBox Grid.Row="4" Grid.Column="5" Text="{Binding AeMaxZ.NewValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}"/>
                                <TextBox Grid.Row="4" Grid.Column="6" Text="{Binding AeUnitAngle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" FontWeight="Normal" Foreground="#666"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: PRODUCT SETTINGS (Content copied from ProductSettingsView.xaml) -->
            <TabItem Header="Product Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="40">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Product Setup" FontSize="38" FontWeight="Bold" Foreground="#333" Margin="0,0,0,40"/>
                        <!-- Current Running Program TextBox -->
                        <Border Background="#28A745" 
                          CornerRadius="12" 
                          Padding="10,10" 
                          Margin="400,0,0,30"
                          Height="60" 
                          Width="Auto" 
                          HorizontalAlignment="Left">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.1"/>
                            </Border.Effect>

                            <!-- Changed from StackPanel (vertical) to Horizontal StackPanel -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="RUNNING PRODUCT : " 
                                 Foreground="White" 
                                 FontSize="22" 
                                 FontWeight="Bold" 
                                 VerticalAlignment="Center"
                                 Margin="0,0,0,0"/>
                                <TextBox Text="{Binding CurrentRunningProgram, Mode=OneWay}" 
                               Foreground="White" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               VerticalAlignment="Center"
                               IsReadOnly="True"
                               Background="Transparent"
                               BorderThickness="0"
                               TextAlignment="Center"
                               MinWidth="0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="40" VerticalAlignment="Top">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.1"/>
                            </Border.Effect>

                            <StackPanel Width="600" HorizontalAlignment="Left">
                                <!-- ComboBox for Existing Programs -->
                                
                                <TextBlock Text="Select Product Code" FontSize="20" Foreground="#555" Margin="0,0,0,10"/>
                                <ComboBox ItemsSource="{Binding AvailableProgramCode}"
                                          SelectedItem="{Binding SelectedProgramCode, Mode=TwoWay}"
                                          Text="{Binding FreshProductCode , Mode=TwoWay}"
                                          IsEditable="True"
                                          Width="300" FontSize="20" Margin="0,0,0,0" Padding="10,10" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                            <i:InvokeCommandAction Command="{Binding SelectionChangedCommand}"/>
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </ComboBox>
                                <!-- Product Name -->
                                <TextBlock Text="Product Name" FontSize="20" Foreground="#555" Margin="0,0,0,10"/>
                                <ComboBox ItemsSource="{Binding AvailableProductName, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedItem="{Binding SelectedProductName, Mode=TwoWay}"
                                          Text="{Binding FreshProductName, Mode=TwoWay}"
                                          IsEditable="True"
                                         Width="300" FontSize="20" Padding="10" Margin="0,0,0,30" HorizontalAlignment="Left" BorderBrush="#CCC"/>

                                <!-- Item Count -->
                                <TextBlock Text="Total Active Items (to process)" FontSize="20" Foreground="#555" Margin="0,0,0,10"/>
                                <ComboBox ItemsSource="{Binding ItemCounts}" 
                                          SelectedItem="{Binding SelectedItemCount, Mode=TwoWay}"
                                          FontSize="20" Padding="10" Margin="0,0,0,30" Width="300" HorizontalAlignment="Left" />

                                <!-- Grid Layout -->
                                <TextBlock Text="Dashboard Grid Layout (Rows x Columns)" FontSize="20" Foreground="#555" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,50">
                                    <StackPanel Margin="0,0,20,0">
                                        <TextBlock Text="Rows" FontSize="16" Foreground="#777" Margin="0,0,0,5"/>
                                        <ComboBox ItemsSource="{Binding RowOptions}" 
                                                  SelectedItem="{Binding GridRows , Mode=TwoWay}"
                                                  Width="120" FontSize="24" Padding="10"/>
                                    </StackPanel>

                                    <TextBlock Text="X" FontSize="24" VerticalAlignment="Center" Margin="0,20,20,0" Foreground="#777" FontWeight="Bold"/>

                                    <StackPanel>
                                        <TextBlock Text="Columns" FontSize="16" Foreground="#777" Margin="0,0,0,5"/>
                                        <ComboBox ItemsSource="{Binding ColumnOptions}" 
                                                  SelectedItem="{Binding GridColumns , Mode=TwoWay}"
                                                  Width="120" FontSize="24" Padding="10"/>
                                    </StackPanel>

                                    
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0" >
                                  <!-- ADD Button -->
                                <Button Content="ADD NEW" 
                                        Command="{Binding AddProgramCommand}"
                                        Background="#28A745" 
                                        Foreground="White" 
                                        FontSize="22" 
                                        FontWeight="Bold"
                                        Height="60" 
                                        Width="120"
                                        Margin="0,0,10,0"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Opacity" Value="0.8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                    <!-- SAVE Button -->
                                    <Button Content="SAVE" 
                                        Command="{Binding SaveProgramCommand}"
                                        Background="#E67E22" 
                                        Foreground="White" 
                                        FontSize="22" 
                                        FontWeight="Bold"
                                        Height="60" 
                                        Width="120" 
                                        Cursor="Hand"
                                        Margin="0,0,10,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Opacity" Value="0.8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- Edit Button --><!--
                                <Button Content="EDIT" 
                                       Command="{Binding EditProgramCommand}"
                                       Background="DarkCyan" 
                                       Foreground="White" 
                                       FontSize="22" 
                                       FontWeight="Bold"
                                       Height="60" 
                                       Width="120"
                                       Margin="0,0,10,0"
                                       Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Opacity" Value="0.8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>-->


                                 <!-- DELETE Button -->
                                <Button Content="DELETE" 
                                        Command="{Binding DeleteProgramCommand}"
                                        Background="#1E4FA8" 
                                        Foreground="White" 
                                        FontSize="22" 
                                        FontWeight="Bold"
                                        Height="60" 
                                        Width="120" 
                                        Cursor="Hand"
                                        Margin="0,0,10,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Opacity" Value="0.8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                    <Button Content="CANCLE" 
                                       Command="{Binding CancelProgramCommand}"
                                       Background="DarkCyan" 
                                       Foreground="White" 
                                       FontSize="22" 
                                       FontWeight="Bold"
                                       Height="60" 
                                       Width="120"
                                       Margin="0,0,10,0"
                                       Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Opacity" Value="0.8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>



                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>