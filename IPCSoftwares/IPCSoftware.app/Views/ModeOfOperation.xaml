<UserControl x:Class="IPCSoftware.App.Views.ModeOfOperation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:IPCSoftware.App.ViewModels"
             xmlns:helpers="clr-namespace:IPCSoftware.App.Helpers"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             helpers:ViewModelLocator.AutoWireViewModel="{x:Type vm:ModeOfOperationViewModel}"
             helpers:DisposeBehavior.AutoDispose="True"
             Background="#F3F3F3">

    <UserControl.Resources>
        <!-- Existing Styles... -->
        <Style x:Key="HmiColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="60"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style x:Key="HmiCellStyle" TargetType="DataGridCell">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <!-- NEW: ComboBox Style -->
        <Style x:Key="RecipeComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#1E4FA8"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                    <Setter Property="Background" Value="#F0F0F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ModeButtonTemplate">
            <!-- Existing Button Template... -->
            <Button Margin="15" Width="330" Height="270"
                    IsEnabled="{Binding IsEnabled}">

                <i:Interaction.Behaviors>
                    <helpers:MomentaryBehavior 
                        Command="{Binding DataContext.UnifiedOperationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding Mode}"/>
                </i:Interaction.Behaviors>

                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Border x:Name="ColorLayer" CornerRadius="15" BorderThickness="1" BorderBrush="#555">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding BaseColor}"/>
                                            </Border.Background>
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" BlurRadius="10" Opacity="0.3"/>
                                            </Border.Effect>
                                        </Border>

                                        <Border x:Name="GlossLayer" CornerRadius="15" Opacity="0.8" IsHitTestVisible="False">
                                            <Border.Background>
                                                <RadialGradientBrush GradientOrigin="0.5,0.2" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                                                    <GradientStop Color="#CCFFFFFF" Offset="0"/>
                                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                </RadialGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <Border x:Name="ShadowLayer" CornerRadius="15" Opacity="0" IsHitTestVisible="False">
                                            <Border.Background>
                                                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
                                                    <GradientStop Color="#00000000" Offset="0.4"/>
                                                    <GradientStop Color="#CC000000" Offset="1.2"/>
                                                </RadialGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <Border x:Name="ActiveGlow" CornerRadius="15" BorderThickness="3" BorderBrush="White" Opacity="0">
                                            <Border.Effect>
                                                <DropShadowEffect Color="White" BlurRadius="15" ShadowDepth="0"/>
                                            </Border.Effect>
                                        </Border>

                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="ColorLayer" Property="Opacity" Value="0.3"/>
                                            <Setter TargetName="ColorLayer" Property="Effect" Value="{x:Null}"/>
                                            <Setter TargetName="GlossLayer" Property="Opacity" Value="0.1"/>
                                            <Setter Property="Foreground" Value="#888"/>
                                        </Trigger>

                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter TargetName="GlossLayer" Property="Opacity" Value="1.0"/>
                                        </Trigger>

                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="ColorLayer" Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush Color="{Binding ActiveColor}"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="ActiveGlow" Property="Opacity" Value="1"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding IsBlinking}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard Name="BlinkAnim">
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetName="ShadowLayer"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         From="0.0" To="1.0" Duration="0:0:0.5"/>

                                                        <DoubleAnimation Storyboard.TargetName="ColorLayer"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         From="1.0" To="0.7" Duration="0:0:0.5"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="BlinkAnim"/>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ShadowLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0"/>
                                                        <DoubleAnimation Storyboard.TargetName="ColorLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>

                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>

                <TextBlock Text="{Binding Name}" FontSize="45" FontWeight="Bold" Foreground="White" 
                           TextWrapping="Wrap" TextAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="3" Opacity="0.6"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <TextBlock Text="Control" FontSize="48" FontWeight="Bold" Foreground="#333"/>

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="MACHINE HOME" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Gray"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMachineHome}" Value="True">
                                    <Setter Property="Foreground" Value="#008000"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Ellipse Width="40" Height="40" Stroke="Black" StrokeThickness="1">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#DDDDDD"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMachineHome}" Value="True">
                                    <Setter Property="Fill" Value="#00FF00"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#00FF00" BlurRadius="15"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Button Grid with Recipe in Last Cell -->
            <Border Grid.Column="0" Background="White" CornerRadius="15" Padding="10" BorderBrush="#CCC" BorderThickness="1">
                <!-- Use a Grid instead of UniformGrid to have precise control -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 0, Col 0: Auto Run -->
                    <ContentControl Grid.Row="0" Grid.Column="0" Content="{Binding ModeButtons[0]}" ContentTemplate="{StaticResource ModeButtonTemplate}"/>

                    <!-- Row 0, Col 1: Dry Run -->
                    <ContentControl Grid.Row="0" Grid.Column="1" Content="{Binding ModeButtons[1]}" ContentTemplate="{StaticResource ModeButtonTemplate}"/>

                    <!-- Row 0, Col 2: Manual -->
                    <ContentControl Grid.Row="0" Grid.Column="2" Content="{Binding ModeButtons[2]}" ContentTemplate="{StaticResource ModeButtonTemplate}"/>

                    <!-- Row 1, Col 0: Cycle Stop -->
                    <ContentControl Grid.Row="1" Grid.Column="0" Content="{Binding ModeButtons[3]}" ContentTemplate="{StaticResource ModeButtonTemplate}"/>

                    <!-- Row 1, Col 1: Machine Home -->
                    <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding ModeButtons[4]}" ContentTemplate="{StaticResource ModeButtonTemplate}"/>

                    <!-- Row 1, Col 2: RECIPE SELECTION (Last Cell) -->
                    <Grid Grid.Row="1" Grid.Column="2" Margin="15">
                        <Border x:Name="RecipeSelectionBorder" 
                                Width="330" 
                                Height="270" 
                                CornerRadius="15" 
                                BorderThickness="1" 
                                BorderBrush="#555">

                            <!-- Base Color Layer -->
                            <Border.Background>
                                <SolidColorBrush x:Name="RecipeBaseColor" Color="Salmon"/>
                            </Border.Background>

                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="10" Opacity="0.3"/>
                            </Border.Effect>

                            <!-- Content Grid -->
                            <Grid>
                                <!-- Gloss/Gradient Layer (matches button style) -->
                                <Border x:Name="RecipeGlossLayer" 
                                        CornerRadius="15" 
                                        Opacity="0.8" 
                                        IsHitTestVisible="False">
                                    <Border.Background>
                                        <RadialGradientBrush GradientOrigin="0.5,0.2" 
                                                             Center="0.5,0.5" 
                                                             RadiusX="0.8" 
                                                             RadiusY="0.8">
                                            <GradientStop Color="#CCFFFFFF" Offset="0"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Main Content -->
                                <Grid VerticalAlignment="Center" Margin="20">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Label -->
                                    <TextBlock Grid.Row="0" 
                                               Text="Select Program No" 
                                               FontSize="45" 
                                               FontWeight="Bold" 
                                               Foreground="White" 
                                               TextWrapping="Wrap" 
                                               TextAlignment="Center"
                                               Margin="0,0,0,15">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="3" Opacity="0.6"/>
                                        </TextBlock.Effect>
                                    </TextBlock>

                                    <!-- ComboBox -->
                                    <ComboBox Grid.Row="1"
                                              ItemsSource="{Binding RecipeList}" 
                                              SelectedItem="{Binding SelectedRecipe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                              DisplayMemberPath="Name"
                                              IsEnabled="{Binding IsRecipeSelectionEnabled}"
                                              HorizontalContentAlignment="Center"
                                              Style="{StaticResource RecipeComboBoxStyle}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="SelectionChanged">
                                                <i:InvokeCommandAction Command="{Binding SelectionChangedCommand}" CommandParameter="{Binding SelectedItem}"/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>

                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem">
                                                <Setter Property="FontSize" Value="22"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Padding" Value="10"/>
                                                <Setter Property="Height" Value="50"/>
                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                    </ComboBox>
                                </Grid>
                            </Grid>

                            <!-- Style with Triggers for Enable/Disable Effects -->
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <!-- When Disabled (Recipe Selection NOT Enabled) -->
                                        <DataTrigger Binding="{Binding IsRecipeSelectionEnabled}" Value="False">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush Color="#607D8B"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Opacity" Value="0.3"/>
                                            <Setter Property="Effect" Value="{x:Null}"/>
                                        </DataTrigger>

                                        <!-- When Enabled (Recipe Selection IS Enabled) - Active State -->
                                        <DataTrigger Binding="{Binding IsRecipeSelectionEnabled}" Value="True">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush Color="#48D1CC"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Opacity" Value="1.0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <!-- Additional Gloss Layer Control (separate for better trigger control) -->
                        <Border x:Name="OuterGlossControl" 
                                Width="330" 
                                Height="270" 
                                CornerRadius="15" 
                                IsHitTestVisible="False">
                            <Border CornerRadius="15">
                                <Border.Background>
                                    <RadialGradientBrush GradientOrigin="0.5,0.2" 
                                                         Center="0.5,0.5" 
                                                         RadiusX="0.8" 
                                                         RadiusY="0.8">
                                        <GradientStop Color="#CCFFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="0.8"/>
                                    <Style.Triggers>
                                        <!-- Dim gloss when disabled -->
                                        <DataTrigger Binding="{Binding IsRecipeSelectionEnabled}" Value="False">
                                            <Setter Property="Opacity" Value="0.1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Grid>

                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="20 0 0 0" Background="White" CornerRadius="15" Padding="20" BorderBrush="#CCC" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Operation Activity Log" FontSize="32" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,20"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding AuditLogs}" AutoGenerateColumns="False"
                              ColumnHeaderStyle="{StaticResource HmiColumnHeaderStyle}"
                              CellStyle="{StaticResource HmiCellStyle}"
                              RowHeight="50" IsReadOnly="True" BorderThickness="0" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="140"/>
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>